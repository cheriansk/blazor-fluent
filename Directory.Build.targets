<Project>
  <!--
    Directory.Build.targets: Runs at the end of every project evaluation.
    Provides automated MSBuild governance checks for TemplateGuard.
  -->

  <!--
    Heavy Governance, Manifest & DataModelDocs Automation:
    Strictly restricted to Solution Rebuild (AfterTargets="Rebuild").
    Normal Build, Run, and F5 Debug sessions execute ZERO scripts and ZERO out-of-process scans!
  -->
  <Target Name="OnRebuildGovernanceAndDocs" 
          AfterTargets="Rebuild" 
          Condition="'$(TemplateGuardMode)' == 'TemplateAuthoring' And 
                     Exists('$(MSBuildThisFileDirectory)tools\src\TemplateGuard.Tool\TemplateGuard.Tool.csproj') And 
                     '$(MSBuildProjectName.EndsWith(&quot;.Web&quot;))' == 'true' And 
                     '$(RunHeavyScansOnRebuild)' == 'true'">
    <Message Text="==&gt; [Rebuild Automation] Updating base manifest, verifying zero-hardcode, and regenerating data model docs..." Importance="high" />

    <!-- 1. Base Manifest Scan -->
    <Exec Command="&quot;$(MSBuildThisFileDirectory)tools\src\TemplateGuard.Tool\bin\Debug\net10.0\TemplateGuard.Tool.exe&quot; &quot;$(MSBuildThisFileDirectory).&quot;" 
          Condition="Exists('$(MSBuildThisFileDirectory)tools\src\TemplateGuard.Tool\bin\Debug\net10.0\TemplateGuard.Tool.exe')" />
    <Exec Command="dotnet run --project &quot;$(MSBuildThisFileDirectory)tools\src\TemplateGuard.Tool\TemplateGuard.Tool.csproj&quot; -- &quot;$(MSBuildThisFileDirectory).&quot;" 
          Condition="!Exists('$(MSBuildThisFileDirectory)tools\src\TemplateGuard.Tool\bin\Debug\net10.0\TemplateGuard.Tool.exe')" />

    <!-- 2. Verify Zero-Hardcode -->
	  <!--  <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts\verify-no-hardcode.ps1&quot;" />-->

    <!-- 3. Generate Data Model Docs (Markdown) -->
    <Exec Command="pwsh -NoProfile -File &quot;$(MSBuildThisFileDirectory)scripts\Generate-DataModelDocs.ps1&quot; -Format Markdown" />
  </Target>

  <!--
    TemplateGuard integrity check (TG020): in DownstreamEnforce mode the analyzer DLL and base manifest MUST exist.
    Escape hatch (local worst case only): -p:TemplateGuardAllowMissing=true  or env TEMPLATEGUARD_ALLOW_MISSING=true
    (downgrades the error to a loud warning). CI must not set it.
  -->
  <Target Name="TemplateGuardIntegrityCheck" BeforeTargets="CoreCompile"
          Condition="'$(MSBuildProjectName)' != 'TemplateGuard.Analyzers' And '$(MSBuildProjectName)' != 'TemplateGuard.Tool' And '$(IsTestProject)' != 'true'">
    <ItemGroup>
      <_TgNupkgFiles Include="$(MSBuildThisFileDirectory)tools\TemplateGuard\*.TemplateGuard.*.nupkg" />
      <_TgNupkgFiles Include="$(MSBuildThisFileDirectory)tools\TemplateGuard\*TemplateGuard*.nupkg" />
    </ItemGroup>
    <PropertyGroup>
      <_TgNupkgExists Condition="@(_TgNupkgFiles->Count()) &gt; 0">true</_TgNupkgExists>
      <_TgModeValid Condition="'$(TemplateGuardMode)' == 'TemplateAuthoring' Or '$(TemplateGuardMode)' == 'DownstreamEnforce'">true</_TgModeValid>
    </PropertyGroup>

    <Error Condition="'$(_TgModeValid)' != 'true' And '$(TemplateGuardAllowMissing)' != 'true'"
           Code="TG020" Text="TemplateGuardMode '$(TemplateGuardMode)' is invalid. Use 'TemplateAuthoring' or 'DownstreamEnforce'." />

    <Error Condition="'$(TemplateGuardMode)' == 'DownstreamEnforce' And '$(TemplateGuardAllowMissing)' != 'true' And '$(_TgNupkgExists)' != 'true'"
           Code="TG020" Text="TemplateGuard package (tools\TemplateGuard\*TemplateGuard*.nupkg) is missing. Governance is not enforced. Restore tools/TemplateGuard. Local last resort: -p:TemplateGuardAllowMissing=true." />

    <Warning Condition="'$(TemplateGuardMode)' == 'DownstreamEnforce' And '$(TemplateGuardAllowMissing)' == 'true' And '$(_TgNupkgExists)' != 'true'"
             Code="TG020" Text="TemplateGuard package missing but TemplateGuardAllowMissing=true - base-file governance is DISABLED for this build." />
  </Target>
</Project>
