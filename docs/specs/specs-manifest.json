{
  "description": "Manifest of originating Razor components and C# classes (e.g. batch jobs, services) to generate Antigravity-optimized .requirements.md specifications and end-to-end Mermaid flow diagrams for.",
  "agentRuntime": {
    "thinking_strategy": "zero_waste_discovery_focused_planning",
    "execution_workflow": "two_step_plan_then_approve",
    "agent_mode": "targeted_surgical_edit",
    "token_budget_policy": "minimal_context_reads",
    "do_not_run_commands": [
      "dotnet build",
      "dotnet test"
    ]
  },
  "component_discovery": {
    "ignore_prefixes": [
      "Fluent",
      "Csk",
      "Mud",
      "EditForm",
      "DataAnnotations",
      "Validation",
      "Input",
      "Authorize",
      "Cascading",
      "Router",
      "Route",
      "FocusOnNavigate",
      "PageTitle",
      "HeadContent",
      "SectionOutlet",
      "SectionContent",
      "Virtualize",
      "ErrorBoundary"
    ],
    "ignore_components": [
      "PageHeaderComp",
      "RedirectToLogin"
    ]
  },
  "targets": [
    {
      "path": "BlazorEnterprise.Web/Components/Layout/MainLayout.razor",
      "category": "Layout",
      "thinking_level": "low",
      "description": "Layout Pages",
      "enabled": true,
"children": [
    {
      "path": "BlazorEnterprise.Web/Components/Common/ImpersonationBannerComp.razor",
      "category": "Layout",
      "thinking_level": "low",
      "description": "Child component <ImpersonationBannerComp /> rendered by MainLayout.razor at L4 (Gate: Unconditional).",
      "enabled": true
    },
    {
      "path": "BlazorEnterprise.Web/Components/Common/SessionRevokedModal.razor",
      "category": "Layout",
