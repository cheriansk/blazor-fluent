      "description": "Child component <SessionTimeoutModal /> rendered by MainLayout.razor at L6 (Gate: Unconditional).",
      "enabled": true
    },
    {
      "path": "BlazorEnterprise.Web/Components/Layout/PendingChangesIndicatorComp.razor",
      "category": "Layout",
      "thinking_level": "low",
      "description": "Child component <PendingChangesIndicatorComp /> rendered by MainLayout.razor at L23 (Gate: HasActiveTenantSession).",
      "enabled": true
    },
    {
      "path": "BlazorEnterprise.Web/Components/Layout/NotificationBellPopup.razor",
