@using Microsoft.AspNetCore.Components.Authorization
@using BlazorFluent.Components.Common

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFoundPage)">
    <Found Context="routeData">
        <ObservabilityErrorBoundaryComp>
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                <NotAuthorized Context="authContext">
                    @if (authContext.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <ProjectAccessDeniedCardComp RequiredRole="BlazorFluent.Core.DataListTypes.ProjectRole.ReadOnly"
                                                 CustomMessage="You do not have permission to access this section." />
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
        </ObservabilityErrorBoundaryComp>
    </Found>
</Router>
