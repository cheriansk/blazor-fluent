@inherits LayoutComponentBase
@using BlazorFluent.Components.Common
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Core.DataListTypes
@using BlazorFluent.Core.Domain.Tenancy
@using BlazorFluent.Infrastructure.Security
@using BlazorFluent.Persistence.Context
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using Microsoft.EntityFrameworkCore
@inject ICurrentUser CurrentUser
@inject ITenantContext TenantContext
@inject CurrentUserAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ProtectedSessionStorage SessionStorage
@inject IUserSessionService SessionService
@inject ICircuitSessionTracker CircuitTracker
@inject IInternalAuthenticationService AuthVerificationService
@inject AppDbContext DbContext
@inject IConfiguration Configuration
@inject ILogger<MainLayout> Logger
@inject INavigationStateService NavState
@implements IDisposable

<ImpersonationBannerComp />
<SessionRevokedModal />
<FluentDialogProvider />

<FluentLayout>
    <FluentLayoutItem Area="LayoutArea.Header">
        @if (HasActiveTenantSession)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle"
                          IconStart="@(NavState.IsCollapsed ? new Icons.Regular.Size20.PanelLeftExpand() : new Icons.Regular.Size20.PanelLeftContract())"
                          Title="@(NavState.IsCollapsed ? "Expand Navigation" : "Collapse Navigation")"
                          OnClick="@NavState.Toggle"
                          Style="margin-right: 6px;" />
        }
        BlazorFluent
        <FluentSpacer />
        @if (HasActiveTenantSession)
        {
            <NotificationBellPopup />
            <TenantSwitcherComp />
        }
        @if (CurrentUser.IsAuthenticated)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" IconStart="@(new Icons.Regular.Size20.SignOut())" Title="Sign Out" OnClick="SignOut" Style="margin-left: 6px;">
                Sign Out
            </FluentButton>
        }
        else if (!IsAnonymousPage)
        {
            <FluentButton Appearance="ButtonAppearance.Subtle" Size="ButtonSize.Small" OnClick="@(() => NavigationManager.NavigateTo("/login"))" Style="margin-left: 6px;">
                Sign In
            </FluentButton>
        }
    </FluentLayoutItem>
    @if (HasActiveTenantSession)
    {
        <FluentLayoutItem Area="LayoutArea.Navigation" Style="@($"width: {(NavState.IsCollapsed ? "54px" : "260px")}; min-width: {(NavState.IsCollapsed ? "54px" : "260px")}; transition: width 0.2s ease-in-out;")">
            <NavMenuComp />
        </FluentLayoutItem>
    }
    <FluentLayoutItem Area="LayoutArea.Content" Class="main">
        <div class="content">
            <AppErrorBoundaryComp>
                @if (CurrentUser.IsAuthenticated && !CurrentUser.IsRootAdmin && string.IsNullOrWhiteSpace(TenantContext.TenantId) && !IsAnonymousPage)
                {
                    <div style="padding: 40px; max-width: 800px; margin: 40px auto;">
                        <FluentCard Style="border-left: 4px solid var(--error); padding: 24px;">
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                                <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10">
                                    <FluentIcon Value="@(new Icons.Filled.Size24.DismissCircle())" Color="Color.Error" />
                                    <FluentLabel Typo="Typography.H4">Active Tenant Required</FluentLabel>
                                </FluentStack>
                                <FluentLabel Typo="Typography.Body">
                                    Your account is authenticated, but no active tenant is currently selected or assigned.
                                    Application screens and data operations are disabled to prevent cross-tenant data corruption.
                                </FluentLabel>
                                <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
                                    Please switch to an authorized tenant or contact your organization administrator.
                                </FluentLabel>
                            </FluentStack>
                        </FluentCard>
                    </div>
                }
                else
                {
                    @Body
                }
            </AppErrorBoundaryComp>
        </div>
    </FluentLayoutItem>

    <FluentLayoutItem Area="LayoutArea.Footer">
        <div style="display: flex">
            <FluentLink Href="settings" IconStart="@(new Icons.Regular.Size16.Settings())">
                Settings
            </FluentLink>
            <FluentSpacer />
            <FluentLink Href="https://learn.microsoft.com/en-us/aspnet/core/blazor" Target="LinkTarget.Blank" IconEnd="@(new Icons.Regular.Size16.ArrowExit())">
                About Blazor
            </FluentLink>
        </div>
    </FluentLayoutItem>
</FluentLayout>

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private bool HasActiveTenantSession => CurrentUser.IsAuthenticated && !string.IsNullOrWhiteSpace(TenantContext.TenantId);

    private bool IsAnonymousPage
    {
        get
        {
            var uri = NavigationManager.ToBaseRelativePath(NavigationManager.Uri).ToLowerInvariant();
            return uri.StartsWith("login") || uri.StartsWith("auth-error") || uri.StartsWith("not-found");
        }
    }

    protected override void OnInitialized()
    {
        NavState.OnChange += HandleNavStateChanged;
    }

    private void HandleNavStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    private System.Threading.Timer? _heartbeatTimer;

    private void StartHeartbeat(Guid sessionId)
    {
        _heartbeatTimer?.Dispose();
        _heartbeatTimer = new System.Threading.Timer(async _ =>
        {
            try
            {
                await SessionService.UpdateHeartbeatAsync(sessionId);
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Session heartbeat tick skipped.");
            }
        }, null, TimeSpan.FromMinutes(2), TimeSpan.FromMinutes(2));
    }

    public void Dispose()
    {
        NavState.OnChange -= HandleNavStateChanged;
        _heartbeatTimer?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!CurrentUser.IsAuthenticated)
        {
            try
            {
                var result = await SessionStorage.GetAsync<UserSessionStorageData>("app_session");
                if (result.Success && result.Value != null)
                {
                    var data = result.Value;

                    var rehydrateResult = await AuthVerificationService.VerifyAndRehydrateSessionAsync(data.UserId, data.SessionId);
                    if (rehydrateResult.IsSuccess)
                    {
                        var verified = rehydrateResult.Value!;
                        var user = verified.User;
                        var isHost = verified.IsRootAdmin;

                        if (CurrentUser is AppCurrentUser appUser)
                        {
                            appUser.SetUser(user.Id.ToString(), user.Email, user.FullName, isAuthenticated: true);
                            appUser.SessionId = data.SessionId.ToString();
                            if (isHost)
                            {
                                appUser.AddRole("Admin");
                                appUser.AddRole("RootAdmin");
                            }
                        }

                        // Prefer the intra-session active tenant if still permitted in allowed tenants
                        var resolvedTenantId = verified.ResolvedTenantId;
                        var resolvedTenantName = verified.ResolvedTenantName;

                        if (!string.IsNullOrWhiteSpace(data.ActiveTenantId))
                        {
                            var activeMatch = verified.AllowedTenants.FirstOrDefault(t => t.Id == data.ActiveTenantId);
                            if (activeMatch != null)
                            {
                                resolvedTenantId = activeMatch.Id;
                                resolvedTenantName = activeMatch.Name;
                            }
                        }

                        TenantContext.Initialize(
                            tenantId: resolvedTenantId,
                            tenantName: resolvedTenantName,
                            userType: user.UserType,
                            allowedTenants: verified.AllowedTenants,
                            isHost: isHost);

                        StartHeartbeat(data.SessionId);
                        AuthStateProvider.NotifyUserChanged();
                        StateHasChanged();

                        // If user is currently on an anonymous/login page, navigate back to returnUrl or home
                        if (IsAnonymousPage)
                        {
                            var uri = NavigationManager.ToAbsoluteUri(NavigationManager.Uri);
                            var queryParams = Microsoft.AspNetCore.WebUtilities.QueryHelpers.ParseQuery(uri.Query);
                            if (queryParams.TryGetValue("returnUrl", out var returnUrl) && !string.IsNullOrWhiteSpace(returnUrl))
                            {
                                NavigationManager.NavigateTo(returnUrl.ToString(), replace: true);
                            }
                            else
                            {
                                NavigationManager.NavigateTo("/", replace: true);
                            }
                        }
                        return;
                    }
                    else
                    {
                        Logger.LogWarning("Session restoration rejected: {Error}", rehydrateResult.Error);
                        // Session revoked or invalid: clear storage
                        await SessionStorage.DeleteAsync("app_session");
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Failed to restore session from browser sessionStorage.");
            }

            // If still not authenticated and trying to access a protected page, redirect to login
            if (!IsAnonymousPage)
            {
                NavigationManager.NavigateTo("/login");
            }
        }
        else if (string.IsNullOrWhiteSpace(TenantContext.TenantId) && !IsAnonymousPage)
        {
            // Edge case: Authenticated but tenant missing -> try resolving from user's default
            try
            {
                var userId = CurrentUser.UserId;
                if (!string.IsNullOrEmpty(userId))
                {
                    var user = await DbContext.Users.AsNoTracking().FirstOrDefaultAsync(u => u.Id.ToString() == userId);
                    if (user != null)
                    {
                        var isHost = CurrentUser.IsRootAdmin;
                        var tenantId = (user.DefaultTenantId != null && user.DefaultTenantId != IRootAdminService.DefaultTenantSlug)
                            ? user.DefaultTenantId
                            : "";
                        var activeTenant = !string.IsNullOrEmpty(tenantId)
                            ? await DbContext.Tenants.AsNoTracking().FirstOrDefaultAsync(t => t.Slug == tenantId && t.Slug != IRootAdminService.DefaultTenantSlug)
                            : null;
                        var name = activeTenant?.Name ?? (isHost ? "System Root Administration" : "Organization");
                        var allowed = !string.IsNullOrEmpty(tenantId) ? [new TenantInfo(tenantId, name, isHost)] : new List<TenantInfo>();
                        TenantContext.Initialize(tenantId, name, user.UserType, allowed, isHost);
                        StateHasChanged();
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to resolve tenant for authenticated user.");
            }
        }
    }

    private async Task SignOut()
    {
        _heartbeatTimer?.Dispose();
        try
        {
            var result = await SessionStorage.GetAsync<UserSessionStorageData>("app_session");
            if (result.Success && result.Value != null)
            {
                var adminOrSelf = CurrentUser.UserId ?? "user";
                await SessionService.RevokeSessionAsync(result.Value.SessionId, adminOrSelf);
            }
            await SessionStorage.DeleteAsync("app_session");
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error while cleaning session storage on sign out.");
        }

        if (CurrentUser is AppCurrentUser appUser)
        {
            appUser.Clear();
        }

        TenantContext.Reset();
        AuthStateProvider.NotifyUserChanged();
        NavigationManager.NavigateTo("/login", forceLoad: true);
    }
}
