
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Core.Dtos.Requests
@using BlazorFluent.Core.Dtos.Response
@using BlazorFluent.Core.DataListTypes
@using BlazorFluent.Core.Domain.Auditing
@using BlazorFluent.Persistence.Context
@using Microsoft.EntityFrameworkCore
@using Microsoft.FluentUI.AspNetCore.Components
@inject IAuditService AuditService
@inject ICurrentUser CurrentUser
@inject ITenantContext TenantContext
@inject AppDbContext DbContext
@inject IUserTimeZoneService TimeZoneService
@implements IDisposable

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <div>
        <FluentLabel Typo="Typography.H4">Audit Trail Explorer</FluentLabel>
        <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
            Forensic audit trail: inspect entity mutations, tenant switching, security alerts, and background execution telemetry.
        </FluentLabel>
    </div>

    <!-- Filter Toolbar -->
    <FluentCard Style="padding: 16px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="14">
            <FluentLabel Typo="Typography.H6">Filters & Search</FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Wrap="true" Style="align-items: flex-end;">
                <!-- Tenant Filter Dropdown -->
                <div>
                    <FluentLabel Typo="Typography.Body" Style="margin-bottom: 4px;">Tenant</FluentLabel>
                    <FluentSelect TOption="TenantFilterOption"
                                  TValue="string"
                                  Items="@_availableTenants"
                                  OptionText="@(t => t.Name)"
                                  OptionValue="@(t => t.Id)"
                                  Value="@_selectedTenantId"
                                  ValueChanged="@OnTenantSelectedAsync"
                                  Disabled="@(_availableTenants.Count <= 1)"
                                  Placeholder="-- All Tenants --"
                                  Style="min-width: 200px;" />
                </div>

                <!-- User Filter Dropdown -->
                <div>
                    <FluentLabel Typo="Typography.Body" Style="margin-bottom: 4px;">User</FluentLabel>
                    <FluentSelect TOption="UserFilterOption"
                                  TValue="string"
                                  Items="@_availableUsers"
                                  OptionText="@(u => u.DisplayName)"
                                  OptionValue="@(u => u.Id)"
                                  Value="@_selectedUserId"
                                  ValueChanged="@OnUserSelected"
                                  Placeholder="-- All Users --"
                                  Style="min-width: 220px;" />
                </div>

                <!-- Event Type Filter -->
                <div>
                    <FluentLabel Typo="Typography.Body" Style="margin-bottom: 4px;">Event Type</FluentLabel>
                    <FluentSelect Items="@_eventTypes"
                                  TOption="string"
                                  TValue="string"
                                  SelectedOption="@_selectedEventType"
                                  SelectedOptionChanged="@OnEventTypeChanged"
                                  Style="min-width: 150px;" />
                </div>

                <!-- Severity Filter -->
                <div>
                    <FluentLabel Typo="Typography.Body" Style="margin-bottom: 4px;">Severity</FluentLabel>
                    <FluentSelect Items="@_severities"
                                  TOption="string"
                                  TValue="string"
                                  SelectedOption="@_selectedSeverity"
                                  SelectedOptionChanged="@OnSeverityChanged"
                                  Style="min-width: 140px;" />
                </div>

                <!-- Date Pickers -->
                <FluentDatePicker Label="From Date" @bind-Value="_filter.FromDate" />
                <FluentDatePicker Label="To Date" @bind-Value="_filter.ToDate" />

                <!-- Text Search -->
                <FluentTextInput Label="Search (Description, Entity)" @bind-Value="_filter.SearchTerm" Placeholder="Search term..." Style="min-width: 200px;" />

                <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Search())" OnClick="@SearchAsync">
                    Filter
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@ResetFiltersAsync">
                    Reset
                </FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>

    <!-- Selected Audit Record Diff Viewer Panel -->
    @if (_selectedAuditRecord is not null)
    {
        <FluentCard Style="margin-bottom: 15px; border-left: 4px solid var(--accent-fill-rest); padding: 16px;">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="align-items: center; margin-bottom: 8px;">
                <FluentLabel Typo="Typography.H5">Change Details: @_selectedAuditRecord.EntityName (@_selectedAuditRecord.Operation)</FluentLabel>
                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="@(() => _selectedAuditRecord = null)">Close</FluentButton>
            </FluentStack>
            <FluentLabel Typo="Typography.Body" Style="margin-bottom: 8px;">
                <b>Record ID:</b> @_selectedAuditRecord.EntityId | <b>Tenant:</b> @_selectedAuditRecord.TenantId | <b>User:</b> @(_selectedAuditRecord.UserEmail ?? _selectedAuditRecord.UserId)
            </FluentLabel>
            <div style="background-color: #1e1e1e; color: #d4d4d4; padding: 12px; border-radius: 6px; font-family: monospace; font-size: 13px; max-height: 250px; overflow-y: auto; white-space: pre-wrap;">
                @(_selectedAuditRecord.ChangesJson ?? "No property diff payload recorded.")
            </div>
        </FluentCard>
    }

    <!-- Audit Records Grid -->
    @if (_isLoading)
    {
        <FluentProgressRing Style="margin: 30px auto;" />
    }
    else if (_auditResult is null || _auditResult.Items.Count == 0)
    {
        <FluentMessageBar Intent="MessageBarIntent.Info">
            No audit records found matching the current search criteria.
        </FluentMessageBar>
    }
    else
    {
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="align-items: center; margin-bottom: 8px;">
            <FluentTextInput Placeholder="Quick filter visible audit records..."
                             @bind-Value="_inGridSearchText"
                             @bind-Value:after="StateHasChanged"
                             Style="width: 320px;">
                <StartTemplate>
                    <FluentIcon Value="@(new Icons.Regular.Size16.Search())" />
                </StartTemplate>
            </FluentTextInput>
            <span style="font-size: 12px; color: var(--neutral-foreground-hint);">
                Showing @FilteredAuditItems.Count() of @(_auditResult.Items.Count) records on this page
            </span>
        </FluentStack>

        <FluentDataGrid Items="@FilteredAuditItems" ResizableColumns="true" GridTemplateColumns="160px 120px 180px 120px 110px 1fr 100px">
            <TemplateColumn Title="Timestamp" SortBy="@(GridSort<AuditRecordEntity>.ByDescending(a => a.Created))">
                @TimeZoneService.FormatDateTime(context.Created)
            </TemplateColumn>
            <PropertyColumn Property="@(a => a.TenantId)" Title="Tenant" Sortable="true" />
            <TemplateColumn Title="User" SortBy="@(GridSort<AuditRecordEntity>.ByAscending(a => a.UserEmail ?? a.UserId))">
                <span title="@context.UserId">
                    @(context.UserEmail ?? context.UserId)
                </span>
            </TemplateColumn>
            <TemplateColumn Title="Event" SortBy="@(GridSort<AuditRecordEntity>.ByAscending(a => a.EventType))">
                <FluentBadge>@context.EventType</FluentBadge>
            </TemplateColumn>
            <TemplateColumn Title="Severity" SortBy="@(GridSort<AuditRecordEntity>.ByAscending(a => a.Severity))">
                @if (context.Severity == AuditSeverity.Critical || context.Severity == AuditSeverity.Error)
                {
                    <FluentBadge Color="BadgeColor.Severe">@context.Severity</FluentBadge>
                }
                else if (context.Severity == AuditSeverity.Warning)
                {
                    <FluentBadge Color="BadgeColor.Warning">@context.Severity</FluentBadge>
                }
                else
                {
                    <FluentBadge Color="BadgeColor.Informative">@context.Severity</FluentBadge>
                }
            </TemplateColumn>
            <PropertyColumn Property="@(a => a.Description)" Title="Description" Sortable="true" />
            <TemplateColumn Title="Diff">
                @if (!string.IsNullOrWhiteSpace(context.ChangesJson))
                {
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => _selectedAuditRecord = context)">
                        View Diff
                    </FluentButton>
                }
            </TemplateColumn>
        </FluentDataGrid>

        <!-- Pagination Bar -->
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="align-items: center; margin-top: 12px;">
            <FluentLabel Typo="Typography.Body">
                Showing Page @_auditResult.PageNumber of @_auditResult.TotalPages (@_auditResult.TotalCount total records)
            </FluentLabel>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">
                <FluentButton Disabled="@(!_auditResult.HasPreviousPage)" OnClick="@PreviousPageAsync">Previous</FluentButton>
                <FluentButton Disabled="@(!_auditResult.HasNextPage)" OnClick="@NextPageAsync">Next</FluentButton>
            </FluentStack>
        </FluentStack>
    }
</FluentStack>

@code {
    public record TenantFilterOption(string Id, string Name);
    public record UserFilterOption(string Id, string DisplayName);

    private List<TenantFilterOption> _availableTenants = new();
    private string? _selectedTenantId;

    private List<UserFilterOption> _availableUsers = new();
    private string? _selectedUserId;

    private AuditTrailFilterReqDto _filter = new() { PageSize = 15 };
    private PagedResultRespDto<AuditRecordEntity>? _auditResult;
    private bool _isLoading = true;
    private AuditRecordEntity? _selectedAuditRecord;
    private string _inGridSearchText = string.Empty;

    private readonly List<string> _eventTypes = ["All", "EntityChange", "Security", "TenantSwitch", "UserActivity"];
    private string _selectedEventType = "All";

    private readonly List<string> _severities = ["All", "Information", "Warning", "Error", "Critical"];
    private string _selectedSeverity = "All";

    private IQueryable<AuditRecordEntity> FilteredAuditItems
    {
        get
        {
            var items = _auditResult?.Items ?? [];
            var query = items.AsQueryable();
            if (!string.IsNullOrWhiteSpace(_inGridSearchText))
            {
                var term = _inGridSearchText.Trim();
                query = query.Where(a =>
                    (a.Description != null && a.Description.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (a.TenantId != null && a.TenantId.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (a.UserId != null && a.UserId.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (a.UserEmail != null && a.UserEmail.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    a.EventType.ToString().Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return query;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        TimeZoneService.OnChange += HandleTimeZoneChanged;
        await LoadAvailableTenantsAsync();
        await LoadAvailableUsersAsync();
        await LoadAuditsAsync();
    }

    private async Task LoadAvailableTenantsAsync()
    {
        var isRootAdmin = CurrentUser.IsRootAdmin;
        if (isRootAdmin)
        {
            var dbTenants = await DbContext.Tenants
                .AsNoTracking()
                .Where(t => t.IsActive)
                .OrderBy(t => t.Name)
                .Select(t => new TenantFilterOption(
                    t.Slug,
                    t.Slug == IRootAdminService.DefaultTenantSlug ? $"{t.Name} (Default Root)" : t.Name))
                .ToListAsync();

            _availableTenants = dbTenants;
        }
        else
        {
            _availableTenants = TenantContext.AllowedTenants
                .Where(t => t.IsActive && t.Id != IRootAdminService.DefaultTenantSlug)
                .OrderBy(t => t.Name)
                .Select(t => new TenantFilterOption(t.Id, t.Name))
                .ToList();
        }

        if (_availableTenants.Count == 1)
        {
            await OnTenantSelectedAsync(_availableTenants[0].Id);
        }
    }

    private async Task LoadAvailableUsersAsync()
    {
        var users = new List<UserFilterOption>();

        if (CurrentUser.IsRootAdmin)
        {
            users.Add(new UserFilterOption("system", "⚙️ System / Daemon User"));
        }

        try
        {
            var userQuery = DbContext.Users
                .AsNoTracking();

            if (!string.IsNullOrWhiteSpace(_selectedTenantId))
            {
                userQuery = userQuery.Where(u => u.DefaultTenantId == _selectedTenantId);
            }
            else if (!CurrentUser.IsRootAdmin)
            {
                var allowedSlugs = TenantContext.AllowedTenants.Select(t => t.Id).ToList();
                userQuery = userQuery.Where(u => allowedSlugs.Contains(u.DefaultTenantId));
            }

            var dbUsers = await userQuery
                .OrderBy(u => u.FullName)
                .Take(100)
                .Select(u => new UserFilterOption(u.Id.ToString(), $"{u.FullName} ({u.Email})"))
                .ToListAsync();

            users.AddRange(dbUsers);
        }
        catch
        {
            // Fallback gracefully if users cannot be queried
        }

        _availableUsers = users;
    }

    private async Task OnTenantSelectedAsync(string? tenantId)
    {
        _selectedTenantId = tenantId;
        _filter.TenantId = tenantId;
        _filter.PageNumber = 1;
        await LoadAvailableUsersAsync();
        await LoadAuditsAsync();
    }

    private async Task OnUserSelected(string? userId)
    {
        _selectedUserId = userId;
        _filter.UserId = userId;
        _filter.PageNumber = 1;
        await LoadAuditsAsync();
    }

    private async Task LoadAuditsAsync()
    {
        _isLoading = true;
        try
        {
            if (!CurrentUser.IsRootAdmin && string.IsNullOrWhiteSpace(_filter.TenantId))
            {
                _filter.AllowedTenantIds = TenantContext.AllowedTenants.Select(t => t.Id).ToList();
            }
            else
            {
                _filter.AllowedTenantIds = null;
            }

            _auditResult = await AuditService.GetAuditTrailAsync(_filter);
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnEventTypeChanged(string val)
    {
        _selectedEventType = val;
        _filter.EventType = val switch
        {
            "EntityChange" => AuditEventType.EntityChange,
            "Security" => AuditEventType.Security,
            "TenantSwitch" => AuditEventType.TenantSwitch,
            "UserActivity" => AuditEventType.UserActivity,
            _ => null
        };
    }

    private void OnSeverityChanged(string val)
    {
        _selectedSeverity = val;
        _filter.Severity = val switch
        {
            "Information" => AuditSeverity.Information,
            "Warning" => AuditSeverity.Warning,
            "Error" => AuditSeverity.Error,
            "Critical" => AuditSeverity.Critical,
            _ => null
        };
    }

    private async Task SearchAsync()
    {
        _filter.PageNumber = 1;
        await LoadAuditsAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _selectedTenantId = null;
        _selectedUserId = null;
        _filter = new AuditTrailFilterReqDto { PageSize = 15 };
        _selectedEventType = "All";
        _selectedSeverity = "All";
        await LoadAvailableUsersAsync();
        await LoadAuditsAsync();
    }

    private async Task PreviousPageAsync()
    {
        if (_auditResult?.HasPreviousPage == true)
        {
            _filter.PageNumber--;
            await LoadAuditsAsync();
        }
    }

    private async Task NextPageAsync()
    {
        if (_auditResult?.HasNextPage == true)
        {
            _filter.PageNumber++;
            await LoadAuditsAsync();
        }
    }

    private void HandleTimeZoneChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TimeZoneService.OnChange -= HandleTimeZoneChanged;
    }
}
