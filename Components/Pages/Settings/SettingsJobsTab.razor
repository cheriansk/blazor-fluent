@using BlazorFluent.Components.Common
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Core.DataListTypes
@using BlazorFluent.Core.Domain.Jobs
@using BlazorFluent.Persistence.Context
@using Microsoft.EntityFrameworkCore
@using Microsoft.FluentUI.AspNetCore.Components
@inject IJobManagerService JobManagerService
@inject AppDbContext DbContext
@inject ITenantContext TenantContext
@inject ICurrentUser CurrentUser
@inject IDateTimeProvider DateTimeProvider
@inject IUserTimeZoneService TimeZoneService
@implements IDisposable

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="align-items: center; width: 100%;">
        <div>
            <FluentLabel Typo="Typography.H4">Background Jobs Orchestration</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
                Monitor batch job execution history, view transient retries, and manually trigger or retry tenant-scoped jobs.
            </FluentLabel>
        </div>
        @if (!string.IsNullOrWhiteSpace(_selectedTenantId))
        {
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10">
                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size16.ArrowSync())" OnClick="@LoadExecutionsAsync">
                    Refresh
                </FluentButton>
                <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Play())" OnClick="@TriggerCatalogSyncAsync">
                    Run Catalog Sync Job
                </FluentButton>
            </FluentStack>
        }
    </FluentStack>

    <!-- Tenant Filter Toolbar -->
    <FluentCard Style="padding: 16px;">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16" Wrap="true">
            <FluentSelect TOption="TenantFilterOption"
                          TValue="string"
                          Items="@_availableTenants"
                          OptionText="@(t => t.Name)"
                          OptionValue="@(t => t.Id)"
                          Value="@_selectedTenantId"
                          ValueChanged="@OnTenantSelected"
                          Disabled="@(_availableTenants.Count <= 1)"
                          Label="Filter by Tenant"
                          Placeholder="-- Select a tenant to view background jobs --"
                          Style="min-width: 300px;" />

            @if (!string.IsNullOrWhiteSpace(_selectedTenantId) && _availableTenants.Count > 1)
            {
                <FluentButton Appearance="ButtonAppearance.Subtle"
                              IconStart="@(new Icons.Regular.Size16.Dismiss())"
                              OnClick="@ClearTenantFilter">
                    Clear Filter
                </FluentButton>
            }
        </FluentStack>
    </FluentCard>

    @if (string.IsNullOrWhiteSpace(_selectedTenantId))
    {
        <!-- Empty State Prompt -->
        <FluentMessageBar Intent="MessageBarIntent.Info" Style="padding: 16px;">
            <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10">
                <FluentIcon Value="@(new Icons.Regular.Size24.Clock())" />
                <div>
                    <strong>No Tenant Selected:</strong> Please choose a tenant from the dropdown above to display its background job executions.
                </div>
            </FluentStack>
        </FluentMessageBar>
    }
    else
    {
        <!-- Alert feedback -->
        @if (!string.IsNullOrWhiteSpace(_statusMessage))
        {
            <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)" AllowDismiss="true" OnDismiss="@(() => _statusMessage = null)">
                @_statusMessage
            </FluentMessageBar>
        }

        <!-- Metric Summary Cards -->
        <FluentGrid Spacing="3" AdaptiveRendering="true">
            <FluentGridItem xs="6" sm="3">
                <FluentCard Style="padding: 16px; text-align: center;">
                    <FluentLabel Typo="Typography.Subject">Total Executions</FluentLabel>
                    <FluentLabel Typo="Typography.H4">@_executions.Count</FluentLabel>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem xs="6" sm="3">
                <FluentCard Style="padding: 16px; text-align: center;">
                    <FluentLabel Typo="Typography.Subject">Succeeded</FluentLabel>
                    <FluentLabel Typo="Typography.H4" Color="Color.Success">@_executions.Count(e => e.Status == JobStatus.Succeeded)</FluentLabel>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem xs="6" sm="3">
                <FluentCard Style="padding: 16px; text-align: center;">
                    <FluentLabel Typo="Typography.Subject">Failed</FluentLabel>
                    <FluentLabel Typo="Typography.H4" Color="Color.Error">@_executions.Count(e => e.Status == JobStatus.Failed)</FluentLabel>
                </FluentCard>
            </FluentGridItem>
            <FluentGridItem xs="6" sm="3">
                <FluentCard Style="padding: 16px; text-align: center;">
                    <FluentLabel Typo="Typography.Subject">Running / Retrying</FluentLabel>
                    <FluentLabel Typo="Typography.H4" Color="Color.Warning">@_executions.Count(e => e.Status == JobStatus.Running || e.Status == JobStatus.Retrying)</FluentLabel>
                </FluentCard>
            </FluentGridItem>
        </FluentGrid>

        <!-- Execution Detail Modal Dialog -->
        @if (_selectedErrorExecution != null)
        {
            <FluentCard Style="@($"margin-bottom: 20px; border-left: 4px solid {(_selectedErrorExecution.Status == JobStatus.Failed ? "var(--error)" : "var(--accent-fill-rest)")};")">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="align-items: center; margin-bottom: 12px;">
                    <FluentLabel Typo="Typography.H5">
                        @(_selectedErrorExecution.Status == JobStatus.Failed ? "Job Error Diagnostics" : "Job Execution Details"): @_selectedErrorExecution.JobName
                    </FluentLabel>
                    <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="@(() => _selectedErrorExecution = null)" />
                </FluentStack>
                <FluentLabel Typo="Typography.Body" Style="margin-bottom: 8px;">
                    <strong>Execution ID:</strong> @_selectedErrorExecution.Id 
                    | <strong>Correlation ID:</strong> @(_selectedErrorExecution.CorrelationId ?? "—") 
                    | <strong>Parent:</strong> @(_selectedErrorExecution.ParentExecutionId?.ToString() ?? "Root") 
                    | <strong>Source:</strong> @_selectedErrorExecution.TriggerSource 
                    | <strong>Attempts:</strong> @_selectedErrorExecution.AttemptCount / @_selectedErrorExecution.MaxRetries
                </FluentLabel>
                @if (!string.IsNullOrWhiteSpace(_selectedErrorExecution.ErrorMessage))
                {
                    <div style="background: var(--neutral-layer-2); padding: 12px; border-radius: 4px; font-family: monospace; font-size: 12px; white-space: pre-wrap; max-height: 250px; overflow-y: auto;">
                        @_selectedErrorExecution.ErrorMessage
                    </div>
                }
                else
                {
                    <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">No error messages recorded for this execution.</FluentLabel>
                }
            </FluentCard>
        }

        <!-- Jobs Grid Card -->
        <FluentCard Style="padding: 20px;">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="align-items: center; margin-bottom: 16px;">
                <div>
                    <FluentLabel Typo="Typography.H5">Executions for &ldquo;@_selectedTenantName&rdquo;</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
                        Historical executions for tenant <code>@_selectedTenantId</code>.
                    </FluentLabel>
                </div>
                <FluentTextInput Placeholder="Filter jobs by name, source, or correlation..."
                                 @bind-Value="_jobSearchText"
                                 @bind-Value:after="StateHasChanged"
                                 Style="width: 300px;">
                    <StartTemplate>
                        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" />
                    </StartTemplate>
                </FluentTextInput>
            </FluentStack>

            @if (_isLoading)
            {
                <div style="display: flex; justify-content: center; padding: 40px;">
                    <FluentProgressRing Size="SpinnerSize.Medium" />
                </div>
            }
            else if (_executions.Count == 0)
            {
                <div style="text-align: center; padding: 40px; color: var(--neutral-foreground-hint);">
                    <FluentIcon Value="@(new Icons.Regular.Size32.Clock())" Color="Color.Neutral" />
                    <div style="margin-top: 10px; font-weight: 500;">No background job executions found for this tenant.</div>
                </div>
            }
            else
            {
                <FluentDataGrid Items="@FilteredExecutions" ResizableColumns="true" GridTemplateColumns="2fr 110px 100px 90px 150px 100px 200px">
                    <PropertyColumn Property="@(e => e.JobName)" Title="Job Name" Sortable="true" />
                    <TemplateColumn Title="Status" SortBy="@(GridSort<JobExecutionEntity>.ByAscending(e => e.Status))">
                        @switch (context.Status)
                        {
                            case JobStatus.Succeeded:
                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Succeeded</FluentBadge>
                                break;
                            case JobStatus.Failed:
                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Severe">Failed</FluentBadge>
                                break;
                            case JobStatus.Running:
                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Brand">Running</FluentBadge>
                                break;
                            case JobStatus.Retrying:
                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning">Retrying</FluentBadge>
                                break;
                            default:
                                <FluentBadge Appearance="BadgeAppearance.Tint">@context.Status</FluentBadge>
                                break;
                        }
                    </TemplateColumn>
                    <PropertyColumn Property="@(e => e.TriggerSource)" Title="Source" Sortable="true" />
                    <TemplateColumn Title="Attempts">
                        @context.AttemptCount / @context.MaxRetries
                    </TemplateColumn>
                    <TemplateColumn Title="Started At" SortBy="@(GridSort<JobExecutionEntity>.ByDescending(e => e.StartedAt))">
                        @TimeZoneService.FormatDateTime(context.StartedAt)
                    </TemplateColumn>
                    <TemplateColumn Title="Duration">
                        @(context.DurationMs.HasValue ? $"{context.DurationMs.Value:F0} ms" : "—")
                    </TemplateColumn>
                    <TemplateColumn Title="Actions">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6">
                            @if (context.Status == JobStatus.Failed)
                            {
                                <FluentButton Appearance="ButtonAppearance.Primary"
                                              Size="ButtonSize.Small"
                                              IconStart="@(new Icons.Regular.Size16.ArrowCounterclockwise())"
                                              OnClick="@(() => RetryJobAsync(context.Id))">
                                    Retry
                                </FluentButton>
                            }
                            <FluentButton Appearance="ButtonAppearance.Subtle"
                                          Size="ButtonSize.Small"
                                          IconStart="@(new Icons.Regular.Size16.Info())"
                                          OnClick="@(() => _selectedErrorExecution = context)">
                                Details
                            </FluentButton>
                            <EntityHistoryButton EntityName="JobExecutionEntity" EntityId="@context.Id.ToString()" Tooltip="View job execution change history" />
                        </FluentStack>
                    </TemplateColumn>
                </FluentDataGrid>
            }
        </FluentCard>
    }
</FluentStack>

@code {
    public record TenantFilterOption(string Id, string Name);

    private List<TenantFilterOption> _availableTenants = new();
    private string? _selectedTenantId;
    private string _selectedTenantName = string.Empty;

    private List<JobExecutionEntity> _executions = new();
    private string _jobSearchText = string.Empty;
    private JobExecutionEntity? _selectedErrorExecution;
    private bool _isLoading;
    private string? _statusMessage;
    private bool _isError;

    protected override async Task OnInitializedAsync()
    {
        TimeZoneService.OnChange += HandleTimeZoneChanged;
        await LoadAvailableTenantsAsync();
    }

    private async Task LoadAvailableTenantsAsync()
    {
        var isRootAdmin = CurrentUser.IsRootAdmin;
        if (isRootAdmin)
        {
            var dbTenants = await DbContext.Tenants
                .AsNoTracking()
                .Where(t => t.IsActive)
                .OrderBy(t => t.Name)
                .Select(t => new TenantFilterOption(
                    t.Slug,
                    t.Slug == IRootAdminService.DefaultTenantSlug ? $"{t.Name} (Default Root)" : t.Name))
                .ToListAsync();

            _availableTenants = dbTenants;
        }
        else
        {
            _availableTenants = TenantContext.AllowedTenants
                .Where(t => t.IsActive && t.Id != IRootAdminService.DefaultTenantSlug)
                .OrderBy(t => t.Name)
                .Select(t => new TenantFilterOption(t.Id, t.Name))
                .ToList();
        }

        if (_availableTenants.Count == 1)
        {
            await OnTenantSelected(_availableTenants[0].Id);
        }
    }

    private async Task OnTenantSelected(string? tenantId)
    {
        _selectedTenantId = tenantId;
        _selectedTenantName = _availableTenants.FirstOrDefault(t => t.Id == tenantId)?.Name ?? tenantId ?? string.Empty;

        if (!string.IsNullOrWhiteSpace(_selectedTenantId))
        {
            await LoadExecutionsAsync();
        }
        else
        {
            _executions.Clear();
            _selectedErrorExecution = null;
        }
    }

    private void ClearTenantFilter()
    {
        _selectedTenantId = null;
        _selectedTenantName = string.Empty;
        _executions.Clear();
        _selectedErrorExecution = null;
    }

    private async Task LoadExecutionsAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedTenantId)) return;

        _isLoading = true;
        try
        {
            var results = await JobManagerService.GetRecentExecutionsAsync(limit: 200);
            if (string.Equals(_selectedTenantId, IRootAdminService.DefaultTenantSlug, StringComparison.OrdinalIgnoreCase))
            {
                _executions = results.Where(e =>
                    e.TenantId == IRootAdminService.DefaultTenantSlug ||
                    e.TenantId == "system" ||
                    e.TenantId == "host" ||
                    string.IsNullOrEmpty(e.TenantId)).ToList();
            }
            else
            {
                _executions = results.Where(e => e.TenantId == _selectedTenantId).ToList();
            }
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task TriggerCatalogSyncAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedTenantId)) return;

        var result = await JobManagerService.TriggerJobAsync("CatalogSyncJob", _selectedTenantId);
        if (result.Succeeded)
        {
            _statusMessage = result.Message ?? "Catalog Sync job event enqueued successfully. Processing in background.";
            _isError = false;
            await Task.Delay(300);
            await LoadExecutionsAsync();
        }
        else
        {
            _statusMessage = $"Failed to trigger job: {result.Error ?? "Unknown error"}";
            _isError = true;
        }
    }

    private async Task RetryJobAsync(Guid executionId)
    {
        _selectedErrorExecution = null;
        var result = await JobManagerService.RetryJobAsync(executionId);
        if (result.Succeeded)
        {
            _statusMessage = result.Message ?? "Manual retry enqueued successfully. Processing in background.";
            _isError = false;
            await Task.Delay(300);
            await LoadExecutionsAsync();
        }
        else
        {
            _statusMessage = $"Failed to initiate retry: {result.Error ?? "Unknown error"}";
            _isError = true;
        }
    }

    private IQueryable<JobExecutionEntity> FilteredExecutions
    {
        get
        {
            var query = _executions.AsQueryable();
            if (!string.IsNullOrWhiteSpace(_jobSearchText))
            {
                var term = _jobSearchText.Trim();
                query = query.Where(e =>
                    (e.JobName != null && e.JobName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (e.TriggerSource != null && e.TriggerSource.Contains(term, StringComparison.OrdinalIgnoreCase)) ||
                    (e.CorrelationId != null && e.CorrelationId.Contains(term, StringComparison.OrdinalIgnoreCase)));
            }
            return query;
        }
    }

    private void HandleTimeZoneChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TimeZoneService.OnChange -= HandleTimeZoneChanged;
    }
}
