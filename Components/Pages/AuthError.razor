@page "/auth-error"
@rendermode InteractiveServer
@using Microsoft.FluentUI.AspNetCore.Components
@inject NavigationManager NavigationManager

<PageTitle>Access Denied - BlazorFluent</PageTitle>

<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 24px;">
    <FluentCard Style="max-width: 440px; width: 100%; padding: 40px 32px; text-align: center; box-shadow: var(--elevation-shadow-card-rest, 0 8px 24px rgba(0,0,0,0.12)); border-radius: 12px;">
        <FluentStack Orientation="Orientation.Vertical" HorizontalAlignment="HorizontalAlignment.Center" VerticalGap="16">
            <div style="background-color: var(--error-background, #fde7e9); padding: 18px; border-radius: 50%; display: inline-flex; align-items: center; justify-content: center;">
                <FluentIcon Value="@(new Icons.Regular.Size32.ShieldDismiss())" Color="Color.Error" />
            </div>

            <FluentLabel Typo="Typography.H4" Style="margin: 0; font-weight: 700;">Access Denied</FluentLabel>

            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-2, #616161); line-height: 1.5;">
                Access Denied: Please contact your IT administrator.
            </FluentLabel>

            @if (!string.IsNullOrWhiteSpace(Reason))
            {
                <div style="background: var(--neutral-layer-2, #fafafa); border: 1px solid var(--neutral-stroke-subtle, #eaeaea); border-radius: 6px; padding: 10px 14px; font-size: 12px; color: var(--neutral-foreground-2, #444); text-align: left; width: 100%;">
                    <strong>Reason:</strong> @Reason
                </div>
            }

            <FluentDivider Style="width: 100%; margin: 8px 0;" />

            <FluentButton Appearance="Appearance.Accent"
                          Style="width: 100%; height: 38px; font-weight: 600;"
                          OnClick="@(() => NavigationManager.NavigateTo("/login"))">
                Return to Login
            </FluentButton>
        </FluentStack>
    </FluentCard>
</div>

@code {
    [SupplyParameterFromQuery]
    public string? Reason { get; set; }
}
