@page "/login"
@rendermode InteractiveServer
@attribute [AllowAnonymous]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("login")]
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Core.DataListTypes
@using BlazorFluent.Core.Domain.Identity
@using BlazorFluent.Core.Domain.Tenancy
@using BlazorFluent.Infrastructure.Security
@using BlazorFluent.Persistence.Context
@using Microsoft.EntityFrameworkCore
@using Microsoft.FluentUI.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject AppDbContext DbContext
@inject IServiceScopeFactory ScopeFactory
@inject IConfiguration Configuration
@inject IWebHostEnvironment HostEnvironment
@inject ITenantContext TenantContext
@inject ICurrentUser CurrentUser
@inject IRootAdminService RootAdminService
@inject IUserSessionService SessionService
@inject IAuditService AuditService
@inject ProtectedSessionStorage SessionStorage
@inject CurrentUserAuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@inject ILogger<LoginPage> Logger

<PageTitle>Sign In - BlazorFluent</PageTitle>

<div style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding: 24px;">
    <FluentCard Style="max-width: 480px; width: 100%; padding: 36px 32px; box-shadow: var(--elevation-shadow-card-rest, 0 8px 24px rgba(0,0,0,0.12)); border-radius: 12px;">
        <FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
            @* Brand Header *@
            <div style="text-align: center;">
                <div style="display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; border-radius: 10px; background-color: var(--accent-fill-rest, #0078d4); color: #fff; margin-bottom: 12px;">
                    <FluentIcon Value="@(new Icons.Regular.Size24.ShieldKeyhole())" Color="Color.Lightweight" />
                </div>
                <FluentLabel Typo="Typography.H3" Style="margin: 0; font-weight: 700;">BlazorFluent</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-2, #616161); margin-top: 4px;">
                    Enterprise Multi-Tenant Portal
                </FluentLabel>
            </div>

            <FluentDivider Style="width: 100%;" />

            @* Privacy Notice Card *@
            <div style="background-color: var(--neutral-layer-2, #f5f5f5); border: 1px solid var(--neutral-stroke-subtle, #e0e0e0); border-radius: 8px; padding: 14px 16px;">
                <div style="display: flex; align-items: flex-start; gap: 10px;">
                    <FluentIcon Value="@(new Icons.Regular.Size20.Info())" Color="Color.Accent" Style="margin-top: 2px;" />
                    <div style="font-size: 12px; color: var(--neutral-foreground-2, #424242); line-height: 1.5;">
                        <strong>Corporate Monitoring & Privacy Notice</strong><br />
                        Access to this portal is restricted to authorized personnel. All session activities,
                        IP addresses, and data modifications are logged and audited in accordance with corporate security compliance policies.
                    </div>
                </div>
            </div>

            @* Mandatory Checkbox *@
            <div style="margin: 4px 0;">
                <FluentCheckbox @bind-Value="_isAcknowledged"
                                Label="I acknowledge and agree to the Privacy Policy and Monitoring Notice." />
            </div>

            @* Primary Sign In Button *@
            <FluentButton Appearance="ButtonAppearance.Subtle"
                          Style="width: 100%; height: 40px; font-weight: 600;"
                          Disabled="@(!_isAcknowledged || _isLoading)"
                          OnClick="HandleMicrosoftSignIn">
                @if (_isLoading)
                {
                    <FluentProgressRing Size="SpinnerSize.Small" Style="margin-right: 8px;" />
                    <span>Validating credentials...</span>
                }
                else
                {
                    <FluentIcon Value="@(new Icons.Regular.Size20.Window())" Style="margin-right: 8px;" />
                    <span>Sign in with Microsoft</span>
                }
            </FluentButton>

            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <FluentMessageBar Intent="MessageBarIntent.Error">
                    @_errorMessage
                </FluentMessageBar>
            }

            @if (HostEnvironment.IsDevelopment())
            {
                @* Local Dev Sandbox Section *@
                <FluentDivider Style="width: 100%; margin-top: 8px;" />
                <div style="border-radius: 8px; border: 1px dashed var(--neutral-stroke-subtle, #ccc); padding: 12px 14px; background: var(--neutral-layer-1, #fafafa);">
                    <FluentLabel Typo="Typography.Caption" Style="font-weight: 600; color: var(--neutral-foreground-2, #616161); margin-bottom: 8px; display: block;">
                        🛠️ Developer Authentication Sandbox (Local Testing)
                    </FluentLabel>
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="8">
                        <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" Style="width: 100%; text-align: left;"
                                      OnClick="@(() => TestSignInAsync("admin@blazorfluent.local"))">
                            👑 Sign in as Root Admin 1 (admin@blazorfluent.local)
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" Style="width: 100%; text-align: left;"
                                      OnClick="@(() => TestSignInAsync("admin2@blazorfluent.local"))">
                            👑 Sign in as Root Admin 2 (admin2@blazorfluent.local)
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" Style="width: 100%; text-align: left;"
                                      OnClick="@(() => TestSignInAsync("admin3@blazorfluent.local"))">
                            👑 Sign in as Root Admin 3 (admin3@blazorfluent.local)
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" Style="width: 100%; text-align: left;"
                                      OnClick="@(() => TestSignInAsync("dev@blazorfluent.local"))">
                            👤 Sign in as Standard Developer (dev@blazorfluent.local)
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" Style="width: 100%; text-align: left;"
                                      OnClick="@(() => TestSignInAsync("expired@blazorfluent.local"))">
                            ❌ Test Expired User (Gate 1 Failure)
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" Style="width: 100%; text-align: left;"
                                      OnClick="@(() => TestSignInAsync("tampered@blazorfluent.local"))">
                            ❌ Test Tampered HMAC (Gate 2 Failure)
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Outline" Size="ButtonSize.Small" Style="width: 100%; text-align: left;"
                                      OnClick="@(() => TestSignInAsync("unprovisioned@company.com"))">
                            ❌ Test Unprovisioned User (Gate 3 Failure)
                        </FluentButton>
                    </FluentStack>
                </div>
            }
        </FluentStack>
    </FluentCard>
</div>

@code {
    private bool _isAcknowledged;
    private bool _isLoading;
    private string? _errorMessage;
    private string _secretKey = "BlazorFluent-Secret-Key-Change-In-Production-2026";

    protected override async Task OnInitializedAsync()
    {
        _secretKey = Configuration["Security:IntegritySecret"] ?? _secretKey;
        if (HostEnvironment.IsDevelopment())
        {
            await EnsureSeedUsersAsync();
        }
    }

    private async Task HandleMicrosoftSignIn()
    {
        if (!_isAcknowledged) return;

        var clientId = Configuration["AzureAd:ClientId"];
        if (string.IsNullOrWhiteSpace(clientId) || clientId.Equals("mock", StringComparison.OrdinalIgnoreCase))
        {
            // Local dev mode without live Azure subscription: default to admin
            await TestSignInAsync("admin@blazorfluent.local");
            return;
        }

        // Production: Redirect to OIDC challenge endpoint
        NavigationManager.NavigateTo("/authentication/challenge", forceLoad: true);
    }

    private async Task TestSignInAsync(string email)
    {
        _isLoading = true;
        _errorMessage = null;

        try
        {
            var now = DateTime.UtcNow;
            var user = await DbContext.Users
                .AsNoTracking()
                .FirstOrDefaultAsync(u => u.Email == email && !u.IsDeleted);

            // Gate: User exists check
            if (user == null)
            {
                await AuditService.LogSecurityEventAsync(
                    "LoginFailedUnprovisioned",
                    AuditSeverity.Warning,
                    $"Authentication rejected for unprovisioned email '{email}'.");

                NavigationManager.NavigateTo($"/auth-error?reason={Uri.EscapeDataString("Your account is not provisioned in this system.")}");
                return;
            }

            // Gate: Date validity and HMAC tamper seal check
            if (!user.IsValidForLogin(now, _secretKey, out var failureReason))
            {
                await AuditService.LogSecurityEventAsync(
                    "LoginFailedValidityGate",
                    AuditSeverity.Warning,
                    $"Login rejected for '{email}': {failureReason}");

                NavigationManager.NavigateTo($"/auth-error?reason={Uri.EscapeDataString(failureReason)}");
                return;
            }

            // All gates passed: Resolve active tenant from database (Invisible Default Tenant Policy)
            var isRootAdmin = RootAdminService.IsRootAdmin(user.Email);
            var isHost = isRootAdmin;

            List<TenantInfo> allowedTenants = [];
            string resolvedTenantId = string.Empty;
            string resolvedTenantName = isHost ? "System Root Administration" : "Organization";

            if (isHost || user.UserType == UserType.CompanyUser)
            {
                var dbTenants = await DbContext.Tenants
                    .AsNoTracking()
                    .Where(t => t.IsActive && t.Slug != "default")
                    .OrderBy(t => t.Name)
                    .ToListAsync();

                allowedTenants = dbTenants.Select(t => new TenantInfo(t.Slug, t.Name, isHost)).ToList();

                var defaultMatch = allowedTenants.FirstOrDefault(t => t.Id == user.DefaultTenantId) ?? allowedTenants.FirstOrDefault();
                if (defaultMatch is not null)
                {
                    resolvedTenantId = defaultMatch.Id;
                    resolvedTenantName = defaultMatch.Name;
                }
            }
            else
            {
                var userTenant = await DbContext.Tenants
                    .AsNoTracking()
                    .FirstOrDefaultAsync(t => t.Slug == user.DefaultTenantId && t.Slug != "default");

                if (userTenant is not null)
                {
                    resolvedTenantId = userTenant.Slug;
                    resolvedTenantName = userTenant.Name;
                    allowedTenants = [new TenantInfo(resolvedTenantId, resolvedTenantName, false)];
                }
            }

            TenantContext.Initialize(
                tenantId: resolvedTenantId,
                tenantName: resolvedTenantName,
                userType: user.UserType,
                allowedTenants: allowedTenants,
                isHost: isHost);

            // Create active session
            var session = await SessionService.CreateSessionAsync(
                user.Id.ToString(),
                user.Email,
                "127.0.0.1 (Local Dev)",
                "Edge / Windows 11");

            // Store in browser sessionStorage for F5 refresh / intra-session preservation
            try
            {
                await SessionStorage.SetAsync("app_session", new UserSessionStorageData(
                    session.Id,
                    user.Id.ToString(),
                    user.Email,
                    resolvedTenantId));
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Could not persist session to browser sessionStorage.");
            }

            // Update circuit authenticated state
            if (CurrentUser is AppCurrentUser appUser)
            {
                appUser.SetUser(user.Id.ToString(), user.Email, user.FullName, isAuthenticated: true);
                appUser.SessionId = session.Id.ToString();
                if (isHost)
                {
                    appUser.AddRole("Admin");
                    appUser.AddRole("RootAdmin");
                }
            }

            AuthStateProvider.NotifyUserChanged();

            await AuditService.LogUserActivityAsync(
                "UserLoginSuccess",
                $"User '{user.Email}' logged in successfully. SessionId: {session.Id}");

            // Navigate to Home
            NavigationManager.NavigateTo("/");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Unexpected error during test login for {Email}", email);
            _errorMessage = "An unexpected error occurred during login.";
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task EnsureSeedUsersAsync()
    {
        try
        {
            using var scope = ScopeFactory.CreateScope();
            var db = scope.ServiceProvider.GetRequiredService<AppDbContext>();

            // 1. Ensure Root Default Tenant exists
            if (!await db.Tenants.AnyAsync(t => t.Code == "OrgRoot"))
            {
                db.Tenants.Add(new TenantEntity
                {
                    Slug = "default",
                    Code = "OrgRoot",
                    Name = "Root System Organization",
                    InternalEmailDomains = "@blazorfluent.local",
                    ExternalEmailDomains = "@client.local",
                    IsActive = true,
                    StartDate = DateTime.UtcNow,
                    EndDate = DateTime.UtcNow.AddYears(10)
                });
                await db.SaveChangesAsync();
            }

            var count = await db.Users.CountAsync();
            if (count > 0) return;

            var admin = new UserEntity
            {
                Email = "admin@blazorfluent.local",
                FullName = "System Administrator",
                UserType = UserType.CompanyUser,
                IsActive = true,
                DefaultTenantId = "default",
                StartDateUtc = DateTime.UtcNow.AddDays(-30),
                EndDateUtc = DateTime.UtcNow.AddYears(1)
            };
            admin.RowSignature = admin.ComputeIntegritySignature(_secretKey);

            var dev = new UserEntity
            {
                Email = "dev@blazorfluent.local",
                FullName = "Jane Developer",
                UserType = UserType.CompanyUser,
                IsActive = true,
                DefaultTenantId = "default",
                StartDateUtc = DateTime.UtcNow.AddDays(-30),
                EndDateUtc = DateTime.UtcNow.AddYears(1)
            };
            dev.RowSignature = dev.ComputeIntegritySignature(_secretKey);

            var expired = new UserEntity
            {
                Email = "expired@blazorfluent.local",
                FullName = "Expired Contractor",
                UserType = UserType.ClientUser,
                IsActive = true,
                DefaultTenantId = "default",
                StartDateUtc = DateTime.UtcNow.AddDays(-90),
                EndDateUtc = DateTime.UtcNow.AddDays(-5)
            };
            expired.RowSignature = expired.ComputeIntegritySignature(_secretKey);

            var tampered = new UserEntity
            {
                Email = "tampered@blazorfluent.local",
                FullName = "Tampered Account",
                UserType = UserType.ClientUser,
                IsActive = true,
                DefaultTenantId = "default",
                StartDateUtc = DateTime.UtcNow.AddDays(-10),
                EndDateUtc = DateTime.UtcNow.AddYears(1),
                RowSignature = "FORGED_TAMPERED_SIGNATURE_INVALID"
            };

            db.Users.AddRange(admin, dev, expired, tampered);
            await db.SaveChangesAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Could not seed test users.");
        }
    }
}
