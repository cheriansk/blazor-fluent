@namespace BlazorFluent.Components.Common
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Core.DataListTypes
@using BlazorFluent.Core.Domain.Tasks
@using BlazorFluent.Core.Domain.Tenancy
@using BlazorFluent.Core.Dtos
@using BlazorFluent.Persistence.Context
@using BlazorFluent.UI.Templates.Wizards
@using Microsoft.EntityFrameworkCore
@inject IWorkflowService WorkflowService
@inject ICurrentUser CurrentUser
@inject ITenantContext TenantContext
@inject AppDbContext DbContext

@* <FluentWizardModal TState="CreateWorkflowReqDto"
                   IsOpen="@IsOpen"
                   IsOpenChanged="@IsOpenChanged"
                   Title="Create Sequential Workflow"
                   Subtitle="Design multi-level stage-gated workflows with dedicated step owners and delegated subtasks"
                   InitialState="@_initialState"
                   OnFinishAsync="@HandleFinishAsync"
                   OnCancel="@HandleCancel">
    <Steps>
        <WizardStep TState="CreateWorkflowReqDto"
                    Title="Scope & Governance"
                    Summary="Scoping level & constant workflow owner"
                    OnValidateAsync="@ValidateStep1Async">
            <ChildContent Context="ctx">
                <div class="wizard-form-grid">
                    @* Scoping Level *@
                    <div class="form-half-width">
                        <FluentSelect TOption="TaskLevel"
                                      TValue="TaskLevel"
                                      @bind-Value="ctx.State.Level"
                                      Label="Workflow Scoping Level *"
                                      Style="width: 100%;">
                            <FluentOption Value="TaskLevel.Tenant">🏢 Tenant Level (Executive Governance)</FluentOption>
                            <FluentOption Value="TaskLevel.Program">📁 Program Level (Multi-Project Initiative)</FluentOption>
                            <FluentOption Value="TaskLevel.Project">📋 Project Level (Team Delivery)</FluentOption>
                        </FluentSelect>
                    </div>

                    @* Context Selector (Program or Project) *@
                    <div class="form-half-width">
                        @if (ctx.State.Level == TaskLevel.Program)
                        {
                            <label class="fluent-label" style="font-size: 0.85rem; font-weight: 600; margin-bottom: 4px; display: block;">Target Program *</label>
                            <FluentSelect TOption="ProgramEntity"
                                          TValue="string"
                                          Items="@_availablePrograms"
                                          OptionText="@(p => p.Name)"
                                          OptionValue="@(p => p.Id.ToString())"
                                          SelectedOption="@_selectedProgram"
                                          SelectedOptionChanged="@(p => { _selectedProgram = p; ctx.State.ProgramId = p?.Id; })"
                                          Placeholder="Select strategic program..."
                                          Style="width: 100%;" />
                            @if (ctx.StepErrors.TryGetValue("ProgramId", out var progErr))
                            {
                                <span class="field-error-text">@progErr</span>
                            }
                        }
                        else if (ctx.State.Level == TaskLevel.Project)
                        {
                            <label class="fluent-label" style="font-size: 0.85rem; font-weight: 600; margin-bottom: 4px; display: block;">Target Project *</label>
                            <FluentSelect TOption="ProjectEntity"
                                          TValue="string"
                                          Items="@_availableProjects"
                                          OptionText="@(p => p.Name)"
                                          OptionValue="@(p => p.Id.ToString())"
                                          SelectedOption="@_selectedProject"
                                          SelectedOptionChanged="@(p => { _selectedProject = p; ctx.State.ProjectId = p?.Id; })"
                                          Placeholder="Select delivery project..."
                                          Style="width: 100%;" />
                            @if (ctx.StepErrors.TryGetValue("ProjectId", out var projErr))
                            {
                                <span class="field-error-text">@projErr</span>
                            }
                        }
                        else
                        {
                            <div style="padding-top: 24px; color: var(--neutral-foreground-hint, #616161); font-size: 0.825rem;">
                                🏢 Applies across the entire tenant organization.
                            </div>
                        }
                    </div>

                    @* Constant Workflow Owner *@
                    <div class="form-half-width">
                        <FluentTextInput Label="Constant Workflow Owner Email *"
                                         @bind-Value="ctx.State.WorkflowOwnerEmail"
                                         Style="width: 100%;"
                                         Placeholder="orchestrator@company.local" />
                        <span class="field-help-text">Accountable from start to finish; follows up across all steps without changing ownership.</span>
                        @if (ctx.StepErrors.TryGetValue("WorkflowOwnerEmail", out var ownerErr))
                        {
                            <span class="field-error-text">@ownerErr</span>
                        }
                    </div>

                    @* Priority *@
                    <div class="form-half-width">
                        <FluentSelect TOption="TaskPriority"
                                      TValue="TaskPriority"
                                      @bind-Value="ctx.State.Priority"
                                      Label="Priority"
                                      Style="width: 100%;">
                            <FluentOption Value="TaskPriority.Low">Low</FluentOption>
                            <FluentOption Value="TaskPriority.Medium">Medium</FluentOption>
                            <FluentOption Value="TaskPriority.High">High</FluentOption>
                            <FluentOption Value="TaskPriority.Urgent">Urgent</FluentOption>
                        </FluentSelect>
                    </div>

                    @* Workflow Title *@
                    <div class="form-full-width">
                        <FluentTextInput Label="Workflow Title *"
                                         @bind-Value="ctx.State.Title"
                                         Style="width: 100%;"
                                         Placeholder="E.g. SOC2 Type II Audit Compliance Rollout" />
                        @if (ctx.StepErrors.TryGetValue("Title", out var titleErr))
                        {
                            <span class="field-error-text">@titleErr</span>
                        }
                    </div>

                    @* Description *@
                    <div class="form-full-width">
                        <FluentTextArea Label="Description & Governance Objectives"
                                        @bind-Value="ctx.State.Description"
                                        Rows="2"
                                        Style="width: 100%;"
                                        Placeholder="Outline key business outcomes, prerequisites, and overarching governance rules..." />
                    </div>

                    @* Target Due Date *@
                    <div class="form-half-width">
                        <FluentDatePicker Label="Overall Target Due Date"
                                          @bind-Value="ctx.State.DueDate"
                                          Style="width: 100%;" />
                    </div>

                    @* Watchers *@
                    <div class="form-half-width">
                        <FluentTextInput Label="Watcher Emails (Comma-separated)"
                                         @bind-Value="ctx.State.WatcherEmails"
                                         Style="width: 100%;"
                                         Placeholder="auditor@company.com, pmo@company.com" />
                    </div>
                </div>
            </ChildContent>
        </WizardStep>

        <WizardStep TState="CreateWorkflowReqDto"
                    Title="Steps & Subtasks"
                    Summary="Ordered tasks & delegated subtasks"
                    OnValidateAsync="@ValidateStep2Async">
            <ChildContent Context="ctx">
                <div class="step-builder-container">
                    <div class="step-builder-header">
                        <span class="step-builder-title">Execution Pipeline Steps (Tasks)</span>
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      IconStart="@(new Icons.Regular.Size16.Add())"
                                      OnClick="@(() => AddStep(ctx))">
                            Add Next Step (Task)
                        </FluentButton>
                    </div>

                    @if (ctx.StepErrors.TryGetValue("Steps", out var stepsErr))
                    {
                        <div class="field-error-banner">@stepsErr</div>
                    }

                    <div class="step-cards-list">
                        @for (int i = 0; i < ctx.State.Steps.Count; i++)
                        {
                            var stepIndex = i;
                            var step = ctx.State.Steps[stepIndex];

                            <div class="step-builder-card">
                                <div class="step-card-top-bar">
                                    <div class="step-card-order-tag">
                                        <span class="order-number">Step #@(stepIndex + 1) (Task)</span>
                                        @if (stepIndex == 0)
                                        {
                                            <span class="first-step-tag">Kickoff Step</span>
                                        }
                                    </div>

                                    @if (ctx.State.Steps.Count > 1)
                                    {
                                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                                      IconStart="@(new Icons.Regular.Size16.Delete())"
                                                      OnClick="@(() => RemoveStep(ctx, stepIndex))"
                                                      Title="Remove this step" />
                                    }
                                </div>

                                <div class="wizard-form-grid" style="margin-top: 10px;">
                                    <div class="form-half-width">
                                        <FluentTextInput Label="Step Title *"
                                                         @bind-Value="step.Title"
                                                         Style="width: 100%;"
                                                         Placeholder="E.g. Security Vulnerability Scanning" />
                                        @if (ctx.StepErrors.TryGetValue($"Step_{stepIndex}_Title", out var stepTitleErr))
                                        {
                                            <span class="field-error-text">@stepTitleErr</span>
                                        }
                                    </div>

                                    <div class="form-half-width">
                                        <FluentTextInput Label="Step Owner Email *"
                                                         @bind-Value="step.StepOwnerEmail"
                                                         Style="width: 100%;"
                                                         Placeholder="lead-engineer@company.local" />
                                        @if (ctx.StepErrors.TryGetValue($"Step_{stepIndex}_Owner", out var stepOwnerErr))
                                        {
                                            <span class="field-error-text">@stepOwnerErr</span>
                                        }
                                    </div>

                                    <div class="form-half-width">
                                        <FluentDatePicker Label="Step Deadline"
                                                          @bind-Value="step.DueDate"
                                                          Style="width: 100%;" />
                                    </div>

                                    <div class="form-half-width">
                                        <FluentTextInput Label="Deliverable Criteria"
                                                         @bind-Value="step.Description"
                                                         Style="width: 100%;"
                                                         Placeholder="Actionable criteria required for sign-off" />
                                    </div>
                                </div>

                                @* Subtasks Builder under this step *@
                                <div class="subtask-builder-section">
                                    <div class="subtask-builder-header">
                                        <span class="subtask-builder-title">
                                            <FluentIcon Value="@(new Icons.Regular.Size12.TaskListSquareAdd())" Color="Color.Neutral" />
                                            Subtasks Delegated to Team (@step.SubTasks.Count)
                                        </span>
                                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                                      IconStart="@(new Icons.Regular.Size12.Add())"
                                                      OnClick="@(() => AddSubTaskToStep(ctx, step))"
                                                      Style="font-size: 0.75rem; padding: 2px 6px;">
                                            Add Subtask
                                        </FluentButton>
                                    </div>

                                    @if (step.SubTasks.Count > 0)
                                    {
                                        <div class="subtask-inputs-list">
                                            @for (int j = 0; j < step.SubTasks.Count; j++)
                                            {
                                                var subIndex = j;
                                                var sub = step.SubTasks[subIndex];

                                                <div class="subtask-input-row">
                                                    <span class="sub-number">@(subIndex + 1).</span>
                                                    <FluentTextInput @bind-Value="sub.Title"
                                                                     Placeholder="Subtask title..."
                                                                     Style="flex: 2;" />
                                                    <FluentTextInput @bind-Value="sub.AssigneeEmail"
                                                                     Placeholder="Assignee email..."
                                                                     Style="flex: 1.5;" />
                                                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                                                  IconStart="@(new Icons.Regular.Size12.Dismiss())"
                                                                  OnClick="@(() => RemoveSubTaskFromStep(ctx, step, subIndex))"
                                                                  Title="Remove subtask" />
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            </ChildContent>
        </WizardStep>

        <WizardStep TState="CreateWorkflowReqDto"
                    Title="Review & Launch"
                    Summary="Verify governance & delegation flow">
            <ChildContent Context="ctx">
                <div class="wizard-review-container">
                    <div class="review-section">
                        <div style="display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 6px;">
                            <FluentLabel Typo="Typography.H6">@ctx.State.Title</FluentLabel>
                            <span class="scope-pill scope-@ctx.State.Level.ToString().ToLowerInvariant()">
                                @ctx.State.Level Level
                            </span>
                        </div>
                        <p class="review-desc">@(string.IsNullOrWhiteSpace(ctx.State.Description) ? "No description provided." : ctx.State.Description)</p>

                        <div class="review-meta-pills">
                            <span class="review-pill">Constant Owner: <strong>@ctx.State.WorkflowOwnerEmail</strong></span>
                            <span class="review-pill">Priority: <strong>@ctx.State.Priority</strong></span>
                            @if (ctx.State.DueDate.HasValue)
                            {
                                <span class="review-pill">Workflow Due: <strong>@ctx.State.DueDate.Value.ToShortDateString()</strong></span>
                            }
                            @if (!string.IsNullOrWhiteSpace(ctx.State.WatcherEmails))
                            {
                                <span class="review-pill">Watchers: <strong>@ctx.State.WatcherEmails</strong></span>
                            }
                        </div>
                    </div>

                    <div class="review-steps-pipeline">
                        <FluentLabel Typo="Typography.Body" Style="font-weight: 600; margin-bottom: 8px;">
                            Sequential Execution Flow (@ctx.State.Steps.Count Step@(ctx.State.Steps.Count > 1 ? "s" : "")):
                        </FluentLabel>

                        <div class="review-steps-list">
                            @for (int i = 0; i < ctx.State.Steps.Count; i++)
                            {
                                var s = ctx.State.Steps[i];
                                <div class="review-step-item">
                                    <div class="review-step-idx">@(i + 1)</div>
                                    <div class="review-step-info">
                                        <div class="review-step-title">@s.Title</div>
                                        <div class="review-step-owner">Step Owner: <strong>@s.StepOwnerEmail</strong></div>
                                        @if (s.SubTasks.Count > 0)
                                        {
                                            <div class="review-step-subtasks">
                                                <span>Subtasks delegated (@s.SubTasks.Count): </span>
                                                @string.Join(", ", s.SubTasks.Select(st => $"{st.Title} ({st.AssigneeEmail})"))
                                            </div>
                                        }
                                    </div>
                                    @if (i == 0)
                                    {
                                        <span class="first-active-pill">Starts Active</span>
                                    }
                                    else
                                    {
                                        <span class="pending-pill">Pending</span>
                                    }
                                </div>
                            }
                        </div>
                    </div>

                    <div class="review-notice-box">
                        <FluentIcon Value="@(new Icons.Regular.Size16.Info())" Color="Color.Accent" />
                        <span>Upon launching, <strong>Step 1</strong> will be activated under Step Owner <strong>@(ctx.State.Steps.Count > 0 ? ctx.State.Steps[0].StepOwnerEmail : "")</strong>. The overarching Workflow Owner <strong>@ctx.State.WorkflowOwnerEmail</strong> remains constant and will track delivery through completion.</span>
                    </div>
                </div>
            </ChildContent>
        </WizardStep>
    </Steps>
</FluentWizardModal>

