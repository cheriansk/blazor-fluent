@code {
    [Parameter]
    public bool IsOpen { get; set; }

    [Parameter]
    public EventCallback<bool> IsOpenChanged { get; set; }

    [Parameter]
    public Guid? ProjectId { get; set; }

    [Parameter]
    public TaskLevel DefaultLevel { get; set; } = TaskLevel.Project;

    [Parameter]
    public EventCallback<WorkflowTaskEntity> OnWorkflowCreated { get; set; }

    private CreateWorkflowReqDto _initialState = new();
    private List<ProgramEntity> _availablePrograms = [];
    private List<ProjectEntity> _availableProjects = [];
    private ProgramEntity? _selectedProgram;
    private ProjectEntity? _selectedProject;

    protected override async Task OnParametersSetAsync()
    {
        if (IsOpen)
        {
            await LoadScopingEntitiesAsync();
            if (_initialState.ProjectId != ProjectId || _initialState.Steps.Count == 0)
            {
                ResetState();
            }
        }
    }

    private async Task LoadScopingEntitiesAsync()
    {
        var tenantId = TenantContext.TenantId;
        if (!string.IsNullOrWhiteSpace(tenantId))
        {
            _availablePrograms = await DbContext.Programs
                .AsNoTracking()
                .Where(p => p.TenantId == tenantId && p.IsActive)
                .OrderBy(p => p.Name)
                .ToListAsync();

            _availableProjects = await DbContext.Projects
                .AsNoTracking()
                .Where(p => p.TenantId == tenantId && p.IsActive && !p.IsDeleted)
                .OrderBy(p => p.Name)
                .ToListAsync();

            if (ProjectId.HasValue && ProjectId.Value != Guid.Empty)
            {
                _selectedProject = _availableProjects.FirstOrDefault(p => p.Id == ProjectId.Value);
            }
        }
    }

    private void ResetState()
    {
        _initialState = new CreateWorkflowReqDto
        {
            Level = DefaultLevel,
            ProjectId = ProjectId,
            WorkflowOwnerEmail = CurrentUser.Email ?? "orchestrator@company.local",
            Priority = TaskPriority.Medium,
            DueDate = DateTime.UtcNow.AddDays(14),
            Steps = new List<CreateWorkflowStepDto>
            {
                new()
                {
                    Title = "Initial Analysis & Feasibility",
                    StepOwnerEmail = CurrentUser.Email ?? "engineer@company.local",
                    DueDate = DateTime.UtcNow.AddDays(3),
                    Description = "Assess technical scope, requirements, and architecture.",
                    SubTasks = new List<CreateWorkflowSubTaskDto>
                    {
                        new() { Title = "Architecture Review", AssigneeEmail = CurrentUser.Email ?? "architect@company.local" },
                        new() { Title = "Security Threat Modeling", AssigneeEmail = "security@company.local" }
                    }
                },
                new()
                {
                    Title = "Stakeholder Approval & Sign-Off",
                    StepOwnerEmail = "lead@company.local",
                    DueDate = DateTime.UtcNow.AddDays(7),
                    Description = "Verify sign-off checklist and approve final rollout."
                }
            }
        };

        if (ProjectId.HasValue && _availableProjects.Count > 0)
        {
            _selectedProject = _availableProjects.FirstOrDefault(p => p.Id == ProjectId.Value) ?? _availableProjects.FirstOrDefault();
            _initialState.ProjectId = _selectedProject?.Id;
        }
        if (_availablePrograms.Count > 0)
        {
            _selectedProgram = _availablePrograms.FirstOrDefault();
            if (_initialState.Level == TaskLevel.Program)
            {
                _initialState.ProgramId = _selectedProgram?.Id;
            }
        }
    }

    private Task<bool> ValidateStep1Async(WizardContext<CreateWorkflowReqDto> ctx)
    {
        ctx.ClearErrors();
        if (string.IsNullOrWhiteSpace(ctx.State.Title))
        {
            ctx.SetError("Title", "Workflow title is required.");
            return Task.FromResult(false);
        }

        if (string.IsNullOrWhiteSpace(ctx.State.WorkflowOwnerEmail) || !ctx.State.WorkflowOwnerEmail.Contains('@'))
        {
            ctx.SetError("WorkflowOwnerEmail", "A valid constant Workflow Owner email is required.");
            return Task.FromResult(false);
        }

        if (ctx.State.Level == TaskLevel.Program && (!ctx.State.ProgramId.HasValue || ctx.State.ProgramId == Guid.Empty))
        {
            ctx.SetError("ProgramId", "Please select a target Program.");
            return Task.FromResult(false);
        }

        if (ctx.State.Level == TaskLevel.Project && (!ctx.State.ProjectId.HasValue || ctx.State.ProjectId == Guid.Empty))
        {
            ctx.SetError("ProjectId", "Please select a target Project.");
            return Task.FromResult(false);
        }

        return Task.FromResult(true);
    }

    private Task<bool> ValidateStep2Async(WizardContext<CreateWorkflowReqDto> ctx)
    {
        ctx.ClearErrors();
        if (ctx.State.Steps == null || ctx.State.Steps.Count == 0)
        {
            ctx.SetError("Steps", "At least one sequential step (task) is required.");
            return Task.FromResult(false);
        }

        for (int i = 0; i < ctx.State.Steps.Count; i++)
        {
            var s = ctx.State.Steps[i];
            if (string.IsNullOrWhiteSpace(s.Title))
            {
                ctx.SetError($"Step_{i}_Title", $"Step #{i + 1} requires a title.");
                return Task.FromResult(false);
            }
            if (string.IsNullOrWhiteSpace(s.StepOwnerEmail) || !s.StepOwnerEmail.Contains('@'))
            {
                ctx.SetError($"Step_{i}_Owner", $"Step #{i + 1} requires a valid Step Owner email.");
                return Task.FromResult(false);
            }
        }
        return Task.FromResult(true);
    }

    private void AddStep(WizardContext<CreateWorkflowReqDto> ctx)
    {
        ctx.State.Steps.Add(new CreateWorkflowStepDto
        {
            Title = $"Step #{ctx.State.Steps.Count + 1}",
            StepOwnerEmail = string.Empty,
            DueDate = DateTime.UtcNow.AddDays(7),
            Description = string.Empty
        });
        ctx.MarkDirty();
    }

    private void RemoveStep(WizardContext<CreateWorkflowReqDto> ctx, int index)
    {
        if (ctx.State.Steps.Count > 1 && index >= 0 && index < ctx.State.Steps.Count)
        {
            ctx.State.Steps.RemoveAt(index);
            ctx.MarkDirty();
        }
    }

    private void AddSubTaskToStep(WizardContext<CreateWorkflowReqDto> ctx, CreateWorkflowStepDto step)
    {
        step.SubTasks.Add(new CreateWorkflowSubTaskDto
        {
            Title = string.Empty,
            AssigneeEmail = string.Empty,
            DueDate = step.DueDate
        });
        ctx.MarkDirty();
    }

    private void RemoveSubTaskFromStep(WizardContext<CreateWorkflowReqDto> ctx, CreateWorkflowStepDto step, int subIndex)
    {
        if (subIndex >= 0 && subIndex < step.SubTasks.Count)
        {
            step.SubTasks.RemoveAt(subIndex);
            ctx.MarkDirty();
        }
    }

    private async Task HandleFinishAsync(CreateWorkflowReqDto state)
    {
        var created = await WorkflowService.CreateWorkflowAsync(state);
        await OnWorkflowCreated.InvokeAsync(created);
        await IsOpenChanged.InvokeAsync(false);
        ResetState();
    }

    private async Task HandleCancel()
    {
        await IsOpenChanged.InvokeAsync(false);
        ResetState();
    }
