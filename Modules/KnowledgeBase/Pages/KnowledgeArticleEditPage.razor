@page "/knowledge/new"
@page "/knowledge/{Id:guid}/edit"
@rendermode InteractiveServer
@using Microsoft.AspNetCore.Authorization
@attribute [Authorize]
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Core.DataListTypes
@using BlazorFluent.Core.DTOs
@using BlazorFluent.Core.Validation
@inject IKnowledgeBaseService KnowledgeService
@inject NavigationManager NavigationManager

<PageTitle>@(IsEditMode ? "Edit Article" : "Create New Article") - Knowledge Base</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16" Style="width: 100%; max-width: 960px; margin: 0 auto; padding-bottom: 40px;">
    <!-- Top Bar -->
    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Style="width: 100%;">
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      IconStart="@(new Icons.Regular.Size16.ArrowLeft())"
                      OnClick="@(() => NavigationManager.NavigateTo("/knowledge"))">
            Cancel &amp; Return
        </FluentButton>

        <FluentLabel Typo="Typography.H4" Style="font-weight: 700; margin: 0;">
            @(IsEditMode ? "Edit Knowledge Article" : "Create Knowledge Article")
        </FluentLabel>

        <div></div>
    </FluentStack>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <FluentMessageBar Intent="@(_isStatusError ? MessageBarIntent.Error : MessageBarIntent.Success)" AllowDismiss="true" OnDismiss="@(() => _statusMessage = null)">
            @_statusMessage
        </FluentMessageBar>
    }

    @if (_isLoading)
    {
        <FluentProgressRing Style="margin: 80px auto;" />
    }
    else
    {
        <FluentCard Style="padding: 24px; background: var(--neutral-layer-2);">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="20" Style="width: 100%;">
                
                <!-- 1. Title Input (Max 100 Characters) -->
                <div>
                    <FluentLabel Typo="Typography.Body" Style="font-weight: 600; margin-bottom: 4px;">
                        Article Title <span style="color: var(--error);">*</span>
                    </FluentLabel>
                    <FluentTextInput @bind-Value="@_model.Title"
                                     MaxLength="100"
                                     Placeholder="Enter a clear headline title (max 100 characters)..."
                                     Style="width: 100%;"
                                     Immediate="true" />
                    <div style="display: flex; justify-content: flex-end; font-size: 11px; color: var(--neutral-foreground-hint); margin-top: 2px;">
                        @(_model.Title?.Length ?? 0) / 100 characters
                    </div>
                </div>

                <!-- 2. Scope Selection (No default, user must explicitly choose) -->
                <div style="border: 1px solid var(--neutral-stroke-subtle); border-radius: 6px; padding: 14px; background: var(--neutral-layer-1);">
                    <FluentLabel Typo="Typography.Body" Style="font-weight: 600; margin-bottom: 6px;">
                        Article Scope <span style="color: var(--error);">*</span>
                        <span style="font-weight: normal; font-size: 12px; color: var(--neutral-foreground-hint); margin-left: 6px;">
                            (Please explicitly select visibility)
                        </span>
                    </FluentLabel>

                    <div style="display: flex; gap: 24px; align-items: center; margin-top: 6px;">
                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px;">
                            <input type="radio"
                                   name="articleScope"
                                   checked="@(_model.Scope == KnowledgeArticleScope.TenantOnly)"
                                   @onchange="@(() => _model.Scope = KnowledgeArticleScope.TenantOnly)" />
                            <div>
                                <strong>Tenant Only</strong>
                                <div style="font-size: 11px; color: var(--neutral-foreground-hint);">Visible only to internal users in your tenant</div>
                            </div>
                        </label>

                        <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; font-size: 13px;">
                            <input type="radio"
                                   name="articleScope"
                                   checked="@(_model.Scope == KnowledgeArticleScope.Global)"
                                   @onchange="@(() => _model.Scope = KnowledgeArticleScope.Global)" />
                            <div>
                                <strong>Global (Cross-Tenant)</strong>
                                <div style="font-size: 11px; color: var(--neutral-foreground-hint);">Visible to all internal users across all tenants</div>
                            </div>
                        </label>
                    </div>

                    @if (_scopeError)
                    {
                        <div style="color: var(--error); font-size: 12px; margin-top: 6px; font-weight: 600;">
                            Please select article scope (Tenant Only or Global).
                        </div>
                    }
                </div>

                <!-- 3. Labels (Purely manual, no automatic labels, min 1, max 10) -->
                <div>
                    <FluentLabel Typo="Typography.Body" Style="font-weight: 600; margin-bottom: 4px;">
                        Labels / Tags <span style="color: var(--error);">*</span>
                        <span style="font-weight: normal; font-size: 12px; color: var(--neutral-foreground-hint); margin-left: 6px;">
                            (Add between 1 and 10 labels)
                        </span>
                    </FluentLabel>

                    <FluentTagInput @bind-Tags="@_model.Labels" MinTags="1" MaxTags="10" />

                    @if (_labelsError)
                    {
                        <div style="color: var(--error); font-size: 12px; margin-top: 4px; font-weight: 600;">
                            At least 1 label is required (maximum 10).
                        </div>
                    }
                </div>

                <!-- 4. Reviewer Selection (1 or more required) -->
                <div>
                    <FluentLabel Typo="Typography.Body" Style="font-weight: 600; margin-bottom: 4px;">
                        Assigned Approvers / Reviewers <span style="color: var(--error);">*</span>
                        <span style="font-weight: normal; font-size: 12px; color: var(--neutral-foreground-hint); margin-left: 6px;">
                            (Select 1 or more internal users to review and approve)
                        </span>
                    </FluentLabel>

                    @if (_availableReviewers.Count == 0)
                    {
                        <div style="font-size: 12px; color: var(--neutral-foreground-hint); font-style: italic;">
                            No other internal users found in the system.
                        </div>
                    }
                    else
                    {
                        <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(240px, 1fr)); gap: 8px; max-height: 160px; overflow-y: auto; padding: 8px; border: 1px solid var(--neutral-stroke-subtle); border-radius: 6px; background: var(--neutral-layer-1);">
                            @foreach (var user in _availableReviewers)
                            {
                                var isSelected = _model.ReviewerUserIds.Contains(user.Id);
                                <label style="display: flex; align-items: center; gap: 8px; cursor: pointer; padding: 4px 6px; border-radius: 4px; font-size: 13px; background: @(isSelected ? "var(--neutral-layer-3)" : "transparent");">
                                    <input type="checkbox"
                                           checked="@isSelected"
                                           @onchange="@((ChangeEventArgs e) => ToggleReviewer(user.Id, (bool)(e.Value ?? false)))" />
                                    <span>
                                        <strong>@user.FullName</strong>
                                        <span style="font-size: 11px; color: var(--neutral-foreground-hint); display: block;">@user.Email</span>
                                    </span>
                                </label>
                            }
                        </div>
                    }

                    @if (_reviewersError)
                    {
                        <div style="color: var(--error); font-size: 12px; margin-top: 4px; font-weight: 600;">
                            At least 1 reviewer must be assigned for approval.
                        </div>
                    }
                </div>

                <!-- 5. Rich Text Content (Up to 20,000 Characters with Images) -->
                <div>
                    <FluentLabel Typo="Typography.Body" Style="font-weight: 600; margin-bottom: 4px;">
                        Article Content &amp; Embedded Images <span style="color: var(--error);">*</span>
                        <span style="font-weight: normal; font-size: 12px; color: var(--neutral-foreground-hint); margin-left: 6px;">
                            (Rich text description with image upload/embedding up to 20,000 characters)
                        </span>
                    </FluentLabel>

                    <FluentRichTextEditor @bind-Value="@_model.Content" MaxLength="20000" MinHeight="280px" />

                    @if (_contentError)
                    {
                        <div style="color: var(--error); font-size: 12px; margin-top: 4px; font-weight: 600;">
                            Article content is required and cannot exceed 20,000 characters.
                        </div>
                    }
                </div>

                <!-- Action Buttons -->
                <div style="display: flex; justify-content: flex-end; gap: 12px; margin-top: 10px; border-top: 1px solid var(--neutral-stroke-subtle); padding-top: 16px;">
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => NavigationManager.NavigateTo("/knowledge"))">
                        Cancel
                    </FluentButton>

                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  IconStart="@(new Icons.Regular.Size16.Save())"
                                  OnClick="@SaveArticleAsync"
                                  Loading="@_isSubmitting">
                        @(IsEditMode ? "Save Changes" : "Submit for Approval")
                    </FluentButton>
                </div>
            </FluentStack>
        </FluentCard>
    }
</FluentStack>

@code {
    [Parameter] public Guid? Id { get; set; }

    private bool IsEditMode => Id.HasValue && Id.Value != Guid.Empty;

    private bool _isLoading = true;
    private bool _isSubmitting = false;
    private string? _statusMessage;
    private bool _isStatusError = false;

    private CreateArticleDto _model = new();
    private List<UserDto> _availableReviewers = new();

    // Validation state flags
    private bool _scopeError = false;
    private bool _labelsError = false;
    private bool _reviewersError = false;
    private bool _contentError = false;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            _availableReviewers = await KnowledgeService.GetAvailableReviewersAsync();

            if (IsEditMode)
            {
                var existing = await KnowledgeService.GetArticleByIdAsync(Id!.Value);
                if (existing != null)
                {
                    _model = new CreateArticleDto
                    {
                        Title = existing.Title,
                        Content = existing.Content,
                        Scope = existing.IsGlobal ? KnowledgeArticleScope.Global : KnowledgeArticleScope.TenantOnly,
                        Labels = existing.Labels.ToList(),
                        ProjectId = existing.ProjectId,
                        ReviewerUserIds = existing.Reviewers.Select(r => r.UserId).ToList()
                    };
                }
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error loading article form: {ex.Message}";
            _isStatusError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void ToggleReviewer(string userId, bool isSelected)
    {
        if (isSelected && !_model.ReviewerUserIds.Contains(userId))
        {
            _model.ReviewerUserIds.Add(userId);
        }
        else if (!isSelected && _model.ReviewerUserIds.Contains(userId))
        {
            _model.ReviewerUserIds.Remove(userId);
        }
    }

    private bool ValidateForm()
    {
        _scopeError = _model.Scope == null;
        _labelsError = _model.Labels == null || _model.Labels.Count < 1 || _model.Labels.Count > 10;
        _reviewersError = _model.ReviewerUserIds == null || _model.ReviewerUserIds.Count < 1;
        _contentError = string.IsNullOrWhiteSpace(_model.Content) || _model.Content.Length > 20000;

        if (string.IsNullOrWhiteSpace(_model.Title) || _model.Title.Length > 100)
        {
            _statusMessage = "Please provide a valid title (1-100 characters).";
            _isStatusError = true;
            return false;
        }

        if (_scopeError || _labelsError || _reviewersError || _contentError)
        {
            _statusMessage = "Please resolve the required fields before submitting.";
            _isStatusError = true;
            return false;
        }

        _statusMessage = null;
        return true;
    }

    private async Task SaveArticleAsync()
    {
        if (!ValidateForm()) return;

        _isSubmitting = true;
        try
        {
            if (IsEditMode)
            {
                await KnowledgeService.UpdateArticleAsync(new UpdateArticleDto
                {
                    Id = Id!.Value,
                    Title = _model.Title,
                    Content = _model.Content,
                    Scope = _model.Scope,
                    Labels = _model.Labels,
                    ProjectId = _model.ProjectId,
                    ReviewerUserIds = _model.ReviewerUserIds
                });

                NavigationManager.NavigateTo($"/knowledge/{Id.Value}");
            }
            else
            {
                var newId = await KnowledgeService.CreateArticleAsync(_model);
                NavigationManager.NavigateTo($"/knowledge/{newId}");
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Error saving article: {ex.Message}";
            _isStatusError = true;
        }
        finally
        {
            _isSubmitting = false;
        }
    }
}
