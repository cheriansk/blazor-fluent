@page "/tenancy/projects"
@rendermode InteractiveServer
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Core.DataListTypes
@using BlazorFluent.Core.Domain.Tenancy
@using BlazorFluent.Core.Domain.Base
@inject ITenantContext TenantContext


<PageTitle>Projects Dashboard</PageTitle>

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentLabel Typo="Typography.H3">Projects Dashboard</FluentLabel>

    @if (TenantContext.TenantId is null)
    {
        <FluentMessageBar Intent="MessageBarIntent.Warning">
            No active tenant session. Please log in to view your projects.
        </FluentMessageBar>
        return;
    }

    <FluentCard>
        <FluentLabel Typo="Typography.H5">Current Tenant</FluentLabel>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Style="margin-top: 8px; align-items: center;">
            <FluentBadge >
                @TenantContext.TenantName
            </FluentBadge>
            <FluentLabel Typo="Typography.Body">
                Tenant ID: <code>@TenantContext.TenantId</code>
            </FluentLabel>
            @if (TenantContext.UserType == UserType.ClientUser)
            {
                <FluentBadge >🔒 Client — Read Only</FluentBadge>
            }
            else
            {
                <FluentBadge >👤 Company User</FluentBadge>
            }
        </FluentStack>
    </FluentCard>

    @if (TenantContext.CanSwitchTenant && TenantContext.AllowedTenants.Count > 1)
    {
        <FluentCard>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="align-items: center; margin-bottom: 8px;">
                <div>
                    <FluentLabel Typo="Typography.H5">Your Tenants (@TenantContext.AllowedTenants.Count)</FluentLabel>
                    <FluentLabel Typo="Typography.Body" Style="margin-bottom: 6px;">
                        As a company user, you can switch between these tenants. Use the switcher in the header.
                    </FluentLabel>
                </div>
                <FluentTextInput Placeholder="Filter tenants..." @bind-Value="_tenantSearchText" @bind-Value:after="StateHasChanged" Style="width: 250px;" >
                                        <StartTemplate>
                        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" />
                    </StartTemplate>
                </FluentTextInput>
            </FluentStack>

            <FluentDataGrid Items="@FilteredAllowedTenants" ResizableColumns="true" GridTemplateColumns="1fr 1fr 120px">
                <PropertyColumn Property="@(t => t.Id)" Title="Tenant ID" Sortable="true" />
                <PropertyColumn Property="@(t => t.Name)" Title="Name" Sortable="true" />
                <TemplateColumn Title="Status" SortBy="@(GridSort<TenantInfo>.ByAscending(t => t.IsActive))">
                    @if (context.IsActive)
                    {
                        <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Active</FluentBadge>
                    }
                    else
                    {
                        <FluentBadge Appearance="BadgeAppearance.Tint">Inactive</FluentBadge>
                    }
                </TemplateColumn>
            </FluentDataGrid>
        </FluentCard>
    }

    <FluentCard>
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" Style="align-items: center; margin-bottom: 8px;">
            <div>
                <FluentLabel Typo="Typography.H5">Projects for &ldquo;@TenantContext.TenantName&rdquo;</FluentLabel>
                <FluentLabel Typo="Typography.Body" Style="margin-bottom: 6px;">
                    All projects are scoped to the active tenant via EF Core global query filters.
                </FluentLabel>
            </div>
            <FluentTextInput Placeholder="Filter projects..." @bind-Value="_projectSearchText" @bind-Value:after="StateHasChanged" Style="width: 250px;" >
                    <StartTemplate>    
                        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" />
                    </StartTemplate>
                </FluentTextInput>
        </FluentStack>

        <FluentDataGrid Items="@FilteredProjects" ResizableColumns="true" GridTemplateColumns="1fr 2fr 100px 180px">
            <PropertyColumn Property="@(p => p.Name)" Title="Project Name" Sortable="true" />
            <PropertyColumn Property="@(p => p.Description)" Title="Description" Sortable="true" />
            <TemplateColumn Title="Status" SortBy="@(GridSort<ProjectEntity>.ByAscending(p => p.IsActive))">
                @if (context.IsActive)
                {
                    <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Active</FluentBadge>
                }
                else
                {
                    <FluentBadge Appearance="BadgeAppearance.Tint">Inactive</FluentBadge>
                }
            </TemplateColumn>
            <TemplateColumn Title="Actions">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6">
                    <FluentAnchor Appearance="Appearance.Lightweight" Href="@($"/projects/{context.Id}/tasks")">
                        View Tasks
                    </FluentAnchor>
                    <EntityHistoryButton EntityName="ProjectEntity" EntityId="@context.Id.ToString()" Tooltip="View project history" />
                </FluentStack>
            </TemplateColumn>
        </FluentDataGrid>
    </FluentCard>

    <FluentCard>
        <FluentLabel Typo="Typography.H5">Architecture: Tenant Security Layers</FluentLabel>
        <ul>
            <li><strong>Layer 1 – Context Init:</strong> <code>ITenantContext.Initialize()</code> called from auth middleware with claims.</li>
            <li><strong>Layer 2 – Query Filter:</strong> EF Core <code>HasQueryFilter</code> on every <code>ITenantEntity</code> — auto-scopes all SELECT queries.</li>
            <li><strong>Layer 3 – Write Interceptor:</strong> <code>AuditableEntityInterceptor</code> checks TenantId on every INSERT/UPDATE, blocks cross-tenant writes.</li>
            <li><strong>Layer 4 – Immutable TenantId:</strong> Interceptor marks <code>TenantId</code> as <code>IsModified = false</code> on UPDATE — can never be changed.</li>
            <li><strong>Layer 5 – Switch Guard:</strong> <code>TenantContext.SwitchTenant()</code> hard-blocks <code>ClientUser</code> — even if called directly from code.</li>
            <li><strong>Layer 6 – Background Jobs:</strong> <code>BatchJobQueueListener</code> restores <code>ITenantContext</code> from <code>jobEvent.TenantId</code> in each job scope.</li>
        </ul>
    </FluentCard>
</FluentStack>

@code {
    private string _tenantSearchText = string.Empty;
    private string _projectSearchText = string.Empty;

    private IQueryable<TenantInfo> FilteredAllowedTenants
    {
        get
        {
            var query = TenantContext.AllowedTenants.AsQueryable();
            if (!string.IsNullOrWhiteSpace(_tenantSearchText))
            {
                var term = _tenantSearchText.Trim();
                query = query.Where(t =>
                    t.Id.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    t.Name.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return query;
        }
    }

    private IQueryable<ProjectEntity> FilteredProjects
    {
        get
        {
            var query = SampleProjectsList.AsQueryable();
            if (!string.IsNullOrWhiteSpace(_projectSearchText))
            {
                var term = _projectSearchText.Trim();
                query = query.Where(p =>
                    p.Name.Contains(term, StringComparison.OrdinalIgnoreCase) ||
                    p.Description.Contains(term, StringComparison.OrdinalIgnoreCase));
            }
            return query;
        }
    }

    private List<ProjectEntity> SampleProjectsList => new List<ProjectEntity>
    {
        new()
        {
            Id = Guid.NewGuid(),
            TenantId = TenantContext.TenantId ?? string.Empty,
            Name = "Alpha Portal",
            Description = "Customer-facing portal for tenant " + TenantContext.TenantName,
            IsActive = true
        },
        new()
        {
            Id = Guid.NewGuid(),
            TenantId = TenantContext.TenantId ?? string.Empty,
            Name = "Beta Analytics",
            Description = "Internal analytics dashboard",
            IsActive = true
        },
        new()
        {
            Id = Guid.NewGuid(),
            TenantId = TenantContext.TenantId ?? string.Empty,
            Name = "Legacy Migration",
            Description = "Archived migration project",
            IsActive = false
        }
    };
}
