        align-items: center;
        gap: 12px;
        margin-top: 6px;
    }

    .tasks-page-header-actions {
        display: flex;
        align-items: flex-end;
        gap: 12px;
    }

    .metrics-bar {
        display: flex;
        align-items: center;
        background-color: var(--neutral-layer-1, #ffffff);
        border: 1px solid var(--neutral-stroke-layer-rest, #e0e0e0);
        border-radius: 8px;
        padding: 0.75rem 1.5rem;
        margin-bottom: 1.25rem;
        gap: 2rem;
    }

