    }

    .metric-label {
        font-size: 0.8rem;
        color: var(--neutral-foreground-hint, #707070);
    }

    .metric-divider {
        width: 1px;
        height: 36px;
        background-color: var(--neutral-stroke-layer-rest, #e0e0e0);
    }

    .text-danger { color: #d13438; }
    .text-warning { color: #ff8c00; }
    .text-success { color: #107c41; }

    /* Task Card Styles */
    .task-card {
        padding: 0.85rem;
        border-radius: 6px;
        border: 1px solid var(--neutral-stroke-layer-rest, #e0e0e0);
        background-color: var(--neutral-layer-1, #ffffff);
