</style>

@code {
    [Parameter]
    public Guid ProjectId { get; set; }

    private bool _isLoading = true;
    private bool _isSaving = false;
    private bool _isPostingComment = false;
    private DateTime _today = DateTime.UtcNow.Date;

    private ProjectEntity? _currentProject;
    private List<ProjectEntity> _availableProjects = [];
    private List<UserTaskEntity> _tasks = [];
    private List<SwimlaneColumn<UserTaskEntity>> _columns = [];

    // Modal state
    private bool _showCreateModal = false;
    private UserTaskEntity _newTask = new();
    private DateTime? _newTaskDueDate;

    private UserTaskEntity? _selectedTask;
    private DateTime? _selectedTaskDueDate;
    private List<UserTaskCommentEntity> _selectedTaskComments = [];
    private string _newCommentText = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        TimeZoneService.OnChange += HandleTimeZoneChanged;
        InitializeSwimlanes();
        await LoadProjectsAndTasksAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_currentProject is not null && _currentProject.Id != ProjectId && ProjectId != Guid.Empty)
        {
            await LoadProjectsAndTasksAsync();
        }
    }

    private void InitializeSwimlanes()
    {
        _today = DateTime.UtcNow.Date;
        var tomorrow = _today.AddDays(1);
        var in2Days = _today.AddDays(2);

        _columns = new List<SwimlaneColumn<UserTaskEntity>>
        {
            new("Past Due", t => !t.IsClosed && t.Status != UserTaskStatus.Closed && t.DueDate.HasValue && t.DueDate.Value.Date < _today, "#d13438", "Overdue"),
            new("Due Today", t => !t.IsClosed && t.Status != UserTaskStatus.Closed && t.DueDate.HasValue && t.DueDate.Value.Date == _today, "#ff8c00", "Today's priority"),
            new("Due Tomorrow", t => !t.IsClosed && t.Status != UserTaskStatus.Closed && t.DueDate.HasValue && t.DueDate.Value.Date == tomorrow, "#0078d4", "Next 24 hours"),
            new("Due in 2 Days", t => !t.IsClosed && t.Status != UserTaskStatus.Closed && t.DueDate.HasValue && t.DueDate.Value.Date == in2Days, "#8764b8", "Upcoming"),
            new("Due Later", t => !t.IsClosed && t.Status != UserTaskStatus.Closed && (!t.DueDate.HasValue || t.DueDate.Value.Date > in2Days), "#605e5c", "Future pipeline"),
            new("Closed", t => t.IsClosed || t.Status == UserTaskStatus.Closed, "#107c41", "Completed work")
        };
    }

    private async Task LoadProjectsAndTasksAsync()
    {
        _isLoading = true;
        try
        {
            _availableProjects = await DbContext.Projects
                .AsNoTracking()
                .Where(p => p.IsActive && !p.IsDeleted)
                .OrderBy(p => p.Name)
                .ToListAsync();

            if (_availableProjects.Count == 0)
            {
                _currentProject = null;
                _tasks = [];
                return;
            }

            if (ProjectId != Guid.Empty)
            {
                _currentProject = _availableProjects.FirstOrDefault(p => p.Id == ProjectId) ?? _availableProjects.First();
            }
            else if (ProjectContext.ProjectId.HasValue)
            {
                _currentProject = _availableProjects.FirstOrDefault(p => p.Id == ProjectContext.ProjectId.Value) ?? _availableProjects.First();
                ProjectId = _currentProject.Id;
            }
            else
            {
                _currentProject = _availableProjects.First();
                ProjectId = _currentProject.Id;
            }

            var result = await TaskService.GetTasksByProjectAsync(_currentProject.Id);
            _tasks = result.ToList();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OnProjectChanged(ProjectEntity? newProject)
    {
        if (newProject is not null && newProject.Id != ProjectId)
        {
            Navigation.NavigateTo($"/projects/{newProject.Id}/tasks");
        }
    }

    private void OpenCreateTaskModal()
    {
        _newTask = new UserTaskEntity
        {
            ProjectId = _currentProject?.Id ?? ProjectId,
            Priority = UserTaskPriority.Medium,
            Status = UserTaskStatus.Open
        };
        _newTaskDueDate = DateTime.UtcNow.Date.AddDays(1);
        _showCreateModal = true;
    }

    private void CloseModals()
    {
        _showCreateModal = false;
        _selectedTask = null;
        _selectedTaskComments.Clear();
        _newCommentText = string.Empty;
    }

    private async Task SaveNewTaskAsync()
    {
        if (string.IsNullOrWhiteSpace(_newTask.Title)) return;

        _isSaving = true;
        try
        {
            _newTask.ProjectId = _currentProject!.Id;
            _newTask.DueDate = _newTaskDueDate;

            var result = await TaskService.CreateTaskAsync(_newTask);
            if (result.IsSuccess)
            {
                CloseModals();
                var fresh = await TaskService.GetTasksByProjectAsync(_currentProject.Id);
                _tasks = fresh.ToList();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task OpenTaskDetailsModal(UserTaskEntity task)
    {
        _selectedTask = await TaskService.GetTaskByIdAsync(task.Id);
        if (_selectedTask is not null)
        {
            _selectedTaskDueDate = _selectedTask.DueDate;
            _selectedTaskComments = (await TaskService.GetCommentsAsync(_selectedTask.Id)).ToList();
        }
    }

    private async Task UpdateSelectedTaskAsync()
    {
        if (_selectedTask is null) return;

        _isSaving = true;
        try
        {
            _selectedTask.DueDate = _selectedTaskDueDate;
            var result = await TaskService.UpdateTaskAsync(_selectedTask);
            if (result.IsSuccess)
            {
                CloseModals();
                var fresh = await TaskService.GetTasksByProjectAsync(_currentProject!.Id);
                _tasks = fresh.ToList();
            }
        }
        finally
        {
            _isSaving = false;
        }
    }

    private async Task CloseSelectedTaskAsync()
    {
        if (_selectedTask is null) return;

        var result = await TaskService.CloseTaskAsync(_selectedTask.Id);
        if (result.IsSuccess)
        {
            CloseModals();
            var fresh = await TaskService.GetTasksByProjectAsync(_currentProject!.Id);
            _tasks = fresh.ToList();
        }
    }

    private async Task ReopenSelectedTaskAsync()
    {
        if (_selectedTask is null) return;

        var result = await TaskService.ReopenTaskAsync(_selectedTask.Id);
        if (result.IsSuccess)
        {
            CloseModals();
            var fresh = await TaskService.GetTasksByProjectAsync(_currentProject!.Id);
            _tasks = fresh.ToList();
        }
    }

    private async Task PostCommentAsync()
    {
        if (_selectedTask is null || string.IsNullOrWhiteSpace(_newCommentText)) return;

        _isPostingComment = true;
        try
        {
            var result = await TaskService.AddCommentAsync(_selectedTask.Id, _newCommentText);
            if (result.IsSuccess)
            {
                _newCommentText = string.Empty;
                _selectedTaskComments = (await TaskService.GetCommentsAsync(_selectedTask.Id)).ToList();
            }
        }
        finally
        {
            _isPostingComment = false;
        }
    }

    private static string GetPriorityColor(UserTaskPriority priority) => priority switch
    {
        UserTaskPriority.Urgent => "#d13438", // Red
        UserTaskPriority.High => "#ff8c00",   // Orange
        UserTaskPriority.Medium => "#0078d4", // Blue
        _ => "#605e5c"                    // Gray
    };

    private void HandleTimeZoneChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        TimeZoneService.OnChange -= HandleTimeZoneChanged;
    }
}
