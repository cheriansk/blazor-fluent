        color: var(--neutral-foreground-rest, #242424);
    }

    .comment-time {
        color: var(--neutral-foreground-hint, #8a8a8a);
    }

    .comment-body {
        font-size: 0.85rem;
        white-space: pre-wrap;
    }

    .no-comments-placeholder {
        padding: 2rem 1rem;
        text-align: center;
        color: #8a8a8a;
        font-size: 0.85rem;
