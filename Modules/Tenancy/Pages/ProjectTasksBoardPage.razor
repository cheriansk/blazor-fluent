@page "/projects/{ProjectId:guid}/tasks"
@page "/tasks"
@rendermode InteractiveServer
@using BlazorFluent.Components.Common
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Core.DataListTypes
@using BlazorFluent.Core.Domain.Tasks
@using BlazorFluent.Core.Domain.Tenancy
@using BlazorFluent.Persistence.Context
@using Microsoft.EntityFrameworkCore
@inject IUserTaskService TaskService
@inject AppDbContext DbContext
@inject ITenantContext TenantContext
@inject IProjectContext ProjectContext
@inject ICurrentUser CurrentUser
@inject IUserTimeZoneService TimeZoneService
@inject NavigationManager Navigation
@implements IDisposable

<PageTitle>Tasks — @(_currentProject?.Name ?? "Project Work Items")</PageTitle>

<div class="tasks-page-header">
    <div class="tasks-page-header-left">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="4px">
            <FluentLink Href="/tenancy/projects">Projects</FluentLink>
            <FluentIcon Value="@(new Icons.Regular.Size12.ChevronRight())" />
            <FluentLink>@(_currentProject?.Name ?? "Tasks")</FluentLink>
            <FluentIcon Value="@(new Icons.Regular.Size12.ChevronRight())" />
            <FluentLink >Task Board</FluentLink>
        </FluentStack>
        <div class="tasks-header-title-row">
            <FluentLabel Typo="Typography.H3">@(_currentProject?.Name ?? "Project Tasks")</FluentLabel>
            @if (_currentProject is not null)
            {
                <FluentBadge Appearance="@BadgeAppearance.Filled">Project ID: @_currentProject.Id.ToString()[..8]...</FluentBadge>
            }
        </div>
    </div>

    <div class="tasks-page-header-actions">
        <!-- Project Switcher -->
        @if (_availableProjects.Count > 1)
        {
            <div style="min-width: 200px;">
                <FluentSelect Items="@_availableProjects"
                              OptionText="@(p => p.Name)"
                              OptionValue="@(p => p.Id.ToString())"
                              SelectedOption="@_currentProject"
                              SelectedOptionChanged="OnProjectChanged"
                              Label="Switch Project" />
            </div>
        }

        <FluentButton Appearance="ButtonAppearance.Subtle"
                      IconStart="@(new Icons.Regular.Size16.ArrowSync())"
                      OnClick="@(() => Navigation.NavigateTo("/imports"))">
            Import
        </FluentButton>
        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size16.Add())" OnClick="OpenCreateTaskModal">
            New Task
        </FluentButton>
    </div>
</div>

@if (_isLoading)
{
    <FluentProgressRing Style="margin: 3rem auto;" />
}
else if (_currentProject is null)
{
    <FluentMessageBar Intent="MessageBarIntent.Warning" Style="margin-top: 1.5rem;">
        No active project selected or found. Please navigate to a valid project.
    </FluentMessageBar>
}
else
{
    <!-- Swimlane Metrics Bar -->
    <div class="metrics-bar">
        <div class="metric-item">
            <span class="metric-count">@_tasks.Count</span>
            <span class="metric-label">Total Tasks</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
            <span class="metric-count text-danger">@_tasks.Count(t => !t.IsClosed && t.DueDate.HasValue && t.DueDate.Value.Date < _today)</span>
            <span class="metric-label">Past Due</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
            <span class="metric-count text-warning">@_tasks.Count(t => !t.IsClosed && t.DueDate.HasValue && t.DueDate.Value.Date == _today)</span>
            <span class="metric-label">Due Today</span>
        </div>
        <div class="metric-divider"></div>
        <div class="metric-item">
            <span class="metric-count text-success">@_tasks.Count(t => t.IsClosed || t.Status == UserTaskStatus.Closed)</span>
            <span class="metric-label">Completed</span>
        </div>
    </div>

    <!-- Reusable 6-Column Swimlane Board -->
    <FluentSwimlaneBoardComp TItem="UserTaskEntity"
                         Columns="@_columns"
                         Items="@_tasks"
                         OnItemClick="OpenTaskDetailsModal">
        <ItemTemplate>
            <FluentCard Class="task-card">
                <div class="task-card-header">
                    <FluentBadge Appearance="@BadgeAppearance.Tint" BackgroundColor="@GetPriorityColor(context.Priority)">
                        @context.Priority
                    </FluentBadge>
                    <span class="task-card-due @(context.DueDate.HasValue && context.DueDate.Value.Date < _today && !context.IsClosed ? "due-overdue" : "")">
                        @(context.DueDate.HasValue ? TimeZoneService.FormatDate(context.DueDate.Value, "MMM dd") : "No Due Date")
                    </span>
                </div>

                <div class="task-card-title">@context.Title</div>

                @if (!string.IsNullOrWhiteSpace(context.Labels))
                {
                    <div class="task-card-labels">
                        @foreach (var label in context.GetParsedLabels())
                        {
                            <span class="jira-label-pill">@label</span>
                        }
                    </div>
                }

                <div class="task-card-footer">
                    <div class="task-card-assignees" title="@context.AssigneeEmails">
                        @if (!string.IsNullOrWhiteSpace(context.AssigneeEmails))
                        {
                            <span>👤 @(context.GetParsedAssigneeEmails().FirstOrDefault() ?? "")</span>
                            @if (context.GetParsedAssigneeEmails().Count > 1)
                            {
                                <span class="badge-more">+@(context.GetParsedAssigneeEmails().Count - 1)</span>
                            }
                        }
                        else
                        {
                            <span class="unassigned-text">Unassigned</span>
                        }
                    </div>
                    <div class="task-card-comments-count">
                        💬 @(context.Comments?.Count ?? 0)
                    </div>
                </div>
            </FluentCard>
        </ItemTemplate>
    </FluentSwimlaneBoardComp>
}

<!-- Create Task Modal -->
@if (_showCreateModal)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-dialog" @onclick:stopPropagation="true">
            <div class="modal-header">
                <FluentLabel Typo="Typography.H4">Create New Task</FluentLabel>
                <FluentButton Appearance="ButtonAppearance.Default" IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="CloseModals" />
            </div>

            <div class="modal-body">
                <FluentTextInput @bind-Value="_newTask.Title" Label="Task Title" Required="true" Style="width: 100%;" Placeholder="Brief headline of the task..." />

                <FluentTextArea @bind-Value="_newTask.Description" Label="Description & Details" Rows="4" Style="width: 100%; margin-top: 12px;" Placeholder="Add detailed description, acceptance criteria, or repro steps..." />

                <div class="modal-grid-row" style="margin-top: 12px;">
                    <FluentSelect TOption="DataListItem<UserTaskPriority>"
                                  TValue="string"
                                  Items="@(DataListExtensions.GetDataListItems<UserTaskPriority>())"
                                  OptionText="@(i => i.DisplayName)"
                                  OptionValue="@(i => i.Code)"
                                  @bind-Value:get="_newTask.Priority.ToString()"
                                  @bind-Value:set="code => { if (Enum.TryParse<UserTaskPriority>(code, out var p)) _newTask.Priority = p; }"
                                  Label="Priority" Style="width: 100%;" />

                    <FluentDatePicker @bind-Value="_newTaskDueDate" Label="Due Date" Style="width: 100%;" />
                </div>

                <FluentTextInput @bind-Value="_newTask.AssigneeEmails"
                                 Label="Assignee Email(s) (Semicolon-Separated)"
                                 Placeholder="alice@company.com; bob@company.com"
                                 Style="width: 100%; margin-top: 12px;" />

                <FluentTextInput @bind-Value="_newTask.Labels"
                                 Label="Labels / Tags (Comma-Separated)"
                                 Placeholder="Frontend, Bug, HighPriority"
                                 Style="width: 100%; margin-top: 12px;" />
            </div>

            <div class="modal-footer">
                <FluentButton Appearance="ButtonAppearance.Default" OnClick="CloseModals">Cancel</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveNewTaskAsync" Loading="@_isSaving">Create Task</FluentButton>
            </div>
        </div>
    </div>
}

<!-- Task Details & Jira Discussion Modal -->
@if (_selectedTask is not null)
{
    <div class="modal-backdrop" @onclick="CloseModals">
        <div class="modal-dialog modal-dialog-large" @onclick:stopPropagation="true">
            <div class="modal-header">
                <div style="display: flex; align-items: center; gap: 8px;">
                    <FluentBadge Appearance="@BadgeAppearance.Tint" BackgroundColor="@GetPriorityColor(_selectedTask.Priority)">
                        @_selectedTask.Priority
                    </FluentBadge>
                    <FluentLabel Typo="Typography.H4">@_selectedTask.Title</FluentLabel>
                </div>
                <FluentButton Appearance="ButtonAppearance.Default" IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="CloseModals" />
            </div>

            <div class="modal-body-split">
                <!-- Left Pane: Task Details & Editing -->
                <div class="modal-pane-left">
                    <FluentTextInput @bind-Value="_selectedTask.Title" Label="Title" Style="width: 100%;" />

                    <FluentTextArea @bind-Value="_selectedTask.Description" Label="Description" Rows="4" Style="width: 100%; margin-top: 12px;" />

                    <div class="modal-grid-row" style="margin-top: 12px;">
                        <FluentSelect TOption="DataListItem<UserTaskPriority>"
                                      TValue="string"
                                      Items="@(DataListExtensions.GetDataListItems<UserTaskPriority>())"
                                      OptionText="@(i => i.DisplayName)"
                                      OptionValue="@(i => i.Code)"
                                      @bind-Value:get="_selectedTask.Priority.ToString()"
                                      @bind-Value:set="code => { if (Enum.TryParse<UserTaskPriority>(code, out var p)) _selectedTask.Priority = p; }"
                                      Label="Priority" Style="width: 100%;" />

                        <FluentDatePicker @bind-Value="_selectedTaskDueDate" Label="Due Date" Style="width: 100%;" />
                    </div>

                    <div class="modal-grid-row" style="margin-top: 12px;">
                        <FluentSelect TOption="DataListItem<UserTaskStatus>"
                                      TValue="string"
                                      Items="@(DataListExtensions.GetDataListItems<UserTaskStatus>())"
                                      OptionText="@(i => i.DisplayName)"
                                      OptionValue="@(i => i.Code)"
                                      @bind-Value:get="_selectedTask.Status.ToString()"
                                      @bind-Value:set="code => { if (Enum.TryParse<UserTaskStatus>(code, out var s)) _selectedTask.Status = s; }"
                                      Label="Status" Style="width: 100%;" />

                        <FluentTextInput @bind-Value="_selectedTask.AssigneeEmails"
                                         Label="Assignees"
                                         Placeholder="email1@co.com; email2@co.com"
                                         Style="width: 100%;" />
                    </div>

                    <FluentTextInput @bind-Value="_selectedTask.Labels"
                                     Label="Labels"
                                     Placeholder="UI, Release-1.0"
                                     Style="width: 100%; margin-top: 12px;" />

                    <div style="display: flex; gap: 8px; margin-top: 20px;">
                        <FluentButton Appearance="ButtonAppearance.Primary" OnClick="UpdateSelectedTaskAsync" Loading="@_isSaving">
                            Save Changes
                        </FluentButton>

                        @if (_selectedTask.IsClosed)
                        {
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="ReopenSelectedTaskAsync">
                                Reopen Task
                            </FluentButton>
                        }
                        else
                        {
                            <FluentButton Appearance="ButtonAppearance.Default" OnClick="CloseSelectedTaskAsync">
                                Mark as Closed
                            </FluentButton>
                        }
                    </div>
                </div>

                <!-- Right Pane: Jira-Style Discussion Comments Thread -->
                <div class="modal-pane-right">
                    <FluentLabel Typo="Typography.H5">Activity & Comments (@(_selectedTaskComments.Count))</FluentLabel>

                    <div class="comments-thread">
                        @if (_selectedTaskComments.Count == 0)
                        {
                            <div class="no-comments-placeholder">No comments yet. Start the discussion below.</div>
                        }
                        else
                        {
                            @foreach (var c in _selectedTaskComments)
                            {
                                <div class="comment-bubble">
                                    <div class="comment-bubble-header">
                                        <span class="comment-author">@c.AuthorName</span>
                                        <span class="comment-time">@TimeZoneService.FormatDateTime(c.CreatedAtUtc, "MMM dd, yyyy HH:mm")</span>
                                    </div>
                                    <div class="comment-body">@c.CommentText</div>
                                </div>
                            }
                        }
                    </div>

                    <!-- Add Comment Form -->
                    <div class="add-comment-box">
                        <FluentTextArea @bind-Value="_newCommentText" Placeholder="Add a comment similar to Jira..." Rows="3" Style="width: 100%;" />
                        <FluentButton Appearance="ButtonAppearance.Primary" Style="margin-top: 8px; align-self: flex-end;" OnClick="PostCommentAsync" Loading="@_isPostingComment">
                            Post Comment
                        </FluentButton>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
