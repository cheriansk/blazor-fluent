<Project>
  <PropertyGroup>
    <!--
      NuGet CVE Auditing (NuGet 6.8+, built into .NET 8+ SDK).
      Warns on 'dotnet restore' when packages have known vulnerabilities.
      NuGetAuditMode=all: audits both direct and transitive dependencies.
      NuGetAuditLevel=moderate: flags Moderate, High, and Critical CVEs.
    -->
    <NuGetAudit>true</NuGetAudit>
    <NuGetAuditMode>all</NuGetAuditMode>
    <NuGetAuditLevel>moderate</NuGetAuditLevel>

    <!--
      Treat vulnerable package warnings as build errors in CI.
      Set to false locally if you need to unblock temporarily.
    -->
    <WarningsAsErrors Condition="'$(CI)' == 'true'">$(WarningsAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsAsErrors>
    <NoWarn Condition="'$(CI)' != 'true'">$(NoWarn);NU1901;NU1902;NU1903;NU1904</NoWarn>
  </PropertyGroup>

  <PropertyGroup>
    <!--
      TemplateGuard Governance Mode:
      - 'TemplateAuthoring': Used while developing this base product template.
                             Validation errors (TG001-TG004) are bypassed so the author can build freely.
                             Base manifest is automatically updated on build.
      - 'DownstreamEnforce': Used when downstream client teams consume this project.
                             Strictly enforces TG001, TG002, TG003, and TG004 as fatal build errors.
    -->
    <TemplateGuardMode Condition="'$(TemplateGuardMode)' == ''">TemplateAuthoring</TemplateGuardMode>
    <SkipBaseManifestUpdate Condition="'$(SkipBaseManifestUpdate)' == ''">false</SkipBaseManifestUpdate>
    <NoWarn Condition="'$(TemplateGuardMode)' == 'TemplateAuthoring'">$(NoWarn);TG001;TG002;TG003;TG004</NoWarn>
  </PropertyGroup>

  <!-- Solution Explorer file nesting for downstream .Custom.cs files -->
  <ItemGroup>
    <Compile Update="**\*.Custom.cs">
      <DependentUpon>$([System.String]::Copy('%(Filename)').Replace('.Custom', '.cs'))</DependentUpon>
    </Compile>
  </ItemGroup>

  <!-- TemplateGuard Roslyn Analyzer & Base Manifest Wiring -->
  <ItemGroup Condition="Exists('$(MSBuildThisFileDirectory)tools\TemplateGuard\TemplateGuard.Analyzers.dll') And '$(MSBuildProjectName)' != 'TemplateGuard.Analyzers' And '$(MSBuildProjectName)' != 'TemplateGuard.Tool' And '$(IsTestProject)' != 'true' And '$(MSBuildProjectName)' != 'BlazorEnterprise.Benchmarks'">
    <Analyzer Include="$(MSBuildThisFileDirectory)tools\TemplateGuard\TemplateGuard.Analyzers.dll" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)tools\TemplateGuard\.basefiles.json" 
                     Condition="Exists('$(MSBuildThisFileDirectory)tools\TemplateGuard\.basefiles.json')" />
    <AdditionalFiles Include="**\*.razor" />
    <AdditionalFiles Include="**\*.css" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src\BlazorEnterprise.Web\wwwroot\**\*.css"
                     Condition="'$(MSBuildProjectName)' != 'BlazorEnterprise.Web'" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)src\BlazorEnterprise.Shared.UI\**\*.css"
                     Condition="'$(MSBuildProjectName)' != 'BlazorEnterprise.Shared.UI'" />
  </ItemGroup>

  <ItemGroup Condition="'$(MSBuildProjectName)' != 'BlazorEnterprise.AppHost' And '$(MSBuildProjectName)' != 'TemplateGuard.Analyzers' And '$(MSBuildProjectName)' != 'TemplateGuard.Tool'">
    <Using Include="BlazorEnterprise.Shared.Common" />
    <Using Include="BlazorEnterprise.Shared.Attributes" />
    <Using Include="BlazorEnterprise.Shared.DataListTypes" />
    <Using Include="BlazorEnterprise.Shared.Models" />
    <Using Include="BlazorEnterprise.Shared.Contracts.Common" />
    <Using Include="BlazorEnterprise.Shared.Contracts.Engine.Client" />
    <Using Include="BlazorEnterprise.Shared.Security" />
    <Using Include="BlazorEnterprise.Shared.Extensions" />
  </ItemGroup>

</Project>
