      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="FluentAssertions" />
    <PackageReference Include="Moq" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\BlazorEnterprise.Shared\BlazorEnterprise.Shared.csproj" />
    <ProjectReference Include="..\..\src\BlazorEnterprise.Core\BlazorEnterprise.Core.csproj" />
    <ProjectReference Include="..\..\src\BlazorEnterprise.RulesEngine\BlazorEnterprise.RulesEngine.csproj" />
    <ProjectReference Include="..\..\src\BlazorEnterprise.Api\BlazorEnterprise.Api.csproj" />
    <ProjectReference Include="..\..\src\BlazorEnterprise.Infrastructure\BlazorEnterprise.Infrastructure.csproj" />
  </ItemGroup>

</Project>
