{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=blazorfluent_db;Username=postgres;Password=__SET_VIA_ENV_OR_KEYVAULT__;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=100;Connection Idle Lifetime=300;",
    "Redis": ""
  },
  "Caching": {
    "DefaultExpirationMinutes": 60,
    "LocalCacheExpirationMinutes": 15
  },
  "Jobs": {
    "EnableScheduler": false,
    "CronServiceAccountEmail": "",
    "Schedules": {
      "CatalogSyncJob": "*/15 * * * *",
      "AuditPurgeJob": "0 2 * * *",
      "DailyTaskSummaryJob": "0 18 * * *",
      "TaskCadenceAlertJob": "0 8 * * *"
    }
  },
  "Audit": {
    "RetentionDays": 365
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "BlazorFluent": "Information",
        "BlazorFluent.Components": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "Notifications": {
    "Teams": {
      "Enabled": false,
      "DefaultWebhookUrl": "",
      "ProjectWebhooks": {}
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "localhost",
      "SmtpPort": 587,
      "UseSsl": false,
      "SenderEmail": "",
      "SenderName": "BlazorFluent Notifications",
      "DefaultMailbox": "",
      "ProjectMailboxes": {}
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "KeyVault": {
    "Uri": ""
  },
  "Security": {
    "IntegritySecret": "__SET_VIA_KEYVAULT_OR_USER_SECRETS__",
    "MasterEncryptionKey": "__SET_VIA_KEYVAULT_OR_USER_SECRETS__",
    "RootAdmins": "",
    "SystemBootstrapEmail": "",
    "Csp": {
      "Enforce": true,
      "ReportOnly": false,
      "ReportUri": "",
      "Profile": "PureStrict"
    }
  },
  "Engine": {
    "Mode": "Remote",
    "ApiBaseUrl": "https://localhost:7150",
    "LicenseKey": "DEV-COMMUNITY-KEY-0000"
  },
  "AllowedHosts": "*"
}
