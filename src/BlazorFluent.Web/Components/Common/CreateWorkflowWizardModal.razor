@namespace BlazorFluent.Components.Common
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Shared.DataListTypes
@using BlazorFluent.Core.Domain.Tasks
@using BlazorFluent.Core.Domain.Tenancy
@using BlazorFluent.Core.Dtos
@using BlazorFluent.Persistence.Context
@using BlazorFluent.UI.Templates.Wizards
@using Microsoft.EntityFrameworkCore
@inject IWorkflowService WorkflowService
@inject ICurrentUser CurrentUser
@inject ITenantContext TenantContext
@inject AppDbContext DbContext

<FluentWizardModal @ref="_wizardModal"
                   TState="CreateWorkflowReqDto"
                   IsOpen="@IsOpen"
                   IsOpenChanged="@IsOpenChanged"
                   Title="@(IsEditMode ? "Edit Sequential Workflow" : "Design Sequential Workflow")"
                   Subtitle="@(IsEditMode ? "Update workflow governance, append/insert tasks, or cancel steps" : "Design multi-level stage-gated workflows with dedicated step owners and delegated subtasks")"
                   InitialState="@_initialState"
                   OnFinish="@HandleFinishAsync"
                   OnCancel="@HandleCancel">
    <Steps>
        <WizardStep Title="Scope & Governance"
                    Summary="Scoping level & constant workflow owner"
                    OnValidateAsync="@ValidateStep1Async">
            <div class="wizard-form-grid">
                @* Scoping Level *@
                <div class="form-half-width">
                    <FluentSelect TOption="TaskLevelEnum"
                                  TValue="TaskLevelEnum"
                                  @bind-Value="_initialState.Level"
                                  Label="Workflow Scoping Level *"
                                  Disabled="@IsEditMode"
                                  Style="width: 100%;">
                        <FluentOption Value="@TaskLevelEnum.Tenant">🏢 Tenant Level (Executive Governance)</FluentOption>
                        <FluentOption Value="@TaskLevelEnum.Program">📁 Program Level (Multi-Project Initiative)</FluentOption>
                        <FluentOption Value="@TaskLevelEnum.Project">📋 Project Level (Team Delivery)</FluentOption>
                    </FluentSelect>
                    @if (IsEditMode)
                    {
                        <span class="field-help-text">Workflow scope level is locked after creation.</span>
                    }
                </div>

                @* Context Selector (Program or Project) *@
                <div class="form-half-width">
                    @if (_initialState.Level == TaskLevelEnum.Program)
                    {
                        <label class="fluent-label" style="font-size: 0.85rem; font-weight: 600; margin-bottom: 4px; display: block;">Target Program *</label>
                        <FluentSelect TOption="ProgramEntity"
                                      TValue="string"
                                      Items="@_availablePrograms"
                                      OptionText="@(p => p.Name)"
                                      OptionValue="@(p => p.Id.ToString())"
                                      Value="@(_initialState.ProgramId?.ToString())"
                                      ValueChanged="@OnProgramSelectedChanged"
                                      Disabled="@IsEditMode"
                                      Placeholder="Select strategic program..."
                                      Style="width: 100%;" />
                        @if (_stepErrors.TryGetValue("ProgramId", out var progErr))
                        {
                            <span class="field-error-text">@progErr</span>
                        }
                    }
                    else if (_initialState.Level == TaskLevelEnum.Project)
                    {
                        <label class="fluent-label" style="font-size: 0.85rem; font-weight: 600; margin-bottom: 4px; display: block;">Target Project *</label>
                        <FluentSelect TOption="ProjectEntity"
                                      TValue="string"
                                      Items="@_availableProjects"
                                      OptionText="@(p => p.Name)"
                                      OptionValue="@(p => p.Id.ToString())"
                                      Value="@(_initialState.ProjectId?.ToString())"
                                      ValueChanged="@OnProjectSelectedChanged"
                                      Disabled="@IsEditMode"
                                      Placeholder="Select delivery project..."
                                      Style="width: 100%;" />
                        @if (_stepErrors.TryGetValue("ProjectId", out var projErr))
                        {
                            <span class="field-error-text">@projErr</span>
                        }
                    }
                    else
                    {
                        <div style="padding-top: 24px; color: var(--neutral-foreground-hint, #616161); font-size: 0.825rem;">
                            🏢 Applies across the entire tenant organization.
                        </div>
                    }
                </div>

                @* Constant Workflow Owner *@
                <div class="form-half-width">
                    <FluentTextInput Label="Constant Workflow Owner Email *"
                                     @bind-Value="_initialState.WorkflowOwnerEmail"
                                     Style="width: 100%;"
                                     Placeholder="orchestrator@company.local" />
                    <span class="field-help-text">Accountable from start to finish; follows up across all steps without changing ownership.</span>
                    @if (_stepErrors.TryGetValue("WorkflowOwnerEmail", out var ownerErr))
                    {
                        <span class="field-error-text">@ownerErr</span>
                    }
                </div>

                @* Priority *@
                <div class="form-half-width">
                    <FluentSelect TOption="TaskPriorityEnum"
                                  TValue="TaskPriorityEnum"
                                  @bind-Value="_initialState.Priority"
                                  Label="Priority"
                                  Style="width: 100%;">
                        <FluentOption Value="@TaskPriorityEnum.Low">Low</FluentOption>
                        <FluentOption Value="@TaskPriorityEnum.Medium">Medium</FluentOption>
                        <FluentOption Value="@TaskPriorityEnum.High">High</FluentOption>
                        <FluentOption Value="@TaskPriorityEnum.Urgent">Urgent</FluentOption>
                    </FluentSelect>
                </div>

                @* Workflow Title *@
                <div class="form-full-width">
                    <FluentTextInput Label="Workflow Title *"
                                     @bind-Value="_initialState.Title"
                                     Style="width: 100%;"
                                     Placeholder="E.g. SOC2 Type II Audit Compliance Rollout" />
                    @if (_stepErrors.TryGetValue("Title", out var titleErr))
                    {
                        <span class="field-error-text">@titleErr</span>
                    }
                </div>

                @* Description *@
                <div class="form-full-width">
                    <FluentTextArea Label="Description & Governance Objectives"
                                    @bind-Value="_initialState.Description"
                                    Rows="2"
                                    Style="width: 100%;"
                                    Placeholder="Outline key business outcomes, prerequisites, and overarching governance rules..." />
                </div>

                @* Target Due Date *@
                <div class="form-half-width">
                    <FluentDatePicker Label="Overall Target Due Date"
                                      @bind-Value="_initialState.DueDate"
                                      Style="width: 100%;" />
                </div>

                @* Watchers *@
                <div class="form-half-width">
                    <FluentTextInput Label="Watcher Emails (Comma-separated)"
                                     @bind-Value="_initialState.WatcherEmails"
                                     Style="width: 100%;"
                                     Placeholder="auditor@company.com, pmo@company.com" />
                </div>
            </div>
        </WizardStep>

        <WizardStep Title="Steps & Subtasks"
                    Summary="Ordered tasks & delegated subtasks"
                    OnValidateAsync="@ValidateStep2Async">
            <div class="step-builder-container">
                <div class="step-builder-header">
                    <span class="step-builder-title">Execution Pipeline Steps (Tasks)</span>
                    <div style="display: flex; gap: 8px;">
                        <FluentButton Appearance="ButtonAppearance.Outline"
                                      IconStart="@(new Icons.Regular.Size16.Search())"
                                      OnClick="@ToggleTaskSearch">
                            Attach Existing Task
                        </FluentButton>
                        <FluentButton Appearance="ButtonAppearance.Primary"
                                      IconStart="@(new Icons.Regular.Size16.Add())"
                                      OnClick="@AddNewStep">
                            Add Next Step (Task)
                        </FluentButton>
                    </div>
                </div>

                @* Search & Attach Existing Task Panel *@
                @if (_showTaskSearch)
                {
                    <div class="task-search-picker-box">
                        <div class="task-search-picker-header">
                            <div style="display: flex; align-items: center; gap: 6px;">
                                <FluentIcon Value="@(new Icons.Filled.Size16.Search())" Color="Color.Primary" />
                                <strong>Search & Attach Existing Task to Workflow</strong>
                            </div>
                            <FluentButton Appearance="ButtonAppearance.Subtle"
                                          IconStart="@(new Icons.Regular.Size16.Dismiss())"
                                          OnClick="@(() => _showTaskSearch = false)"
                                          Title="Close picker" />
                        </div>

                        <div style="display: flex; gap: 8px; margin-bottom: 10px;">
                            <FluentTextInput @bind-Value="_taskSearchTerm"
                                             Placeholder="Search existing task by title, number, or assignee..."
                                             Style="flex: 1;" />
                            <FluentButton Appearance="ButtonAppearance.Primary"
                                          OnClick="@SearchExistingTasksAsync">
                                Search
                            </FluentButton>
                        </div>

                        @if (_isSearchingTasks)
                        {
                            <div style="padding: 12px; text-align: center;">
                                <FluentSpinner Size="@SpinnerSize.Small" />
                                <span style="font-size: 0.85rem; margin-left: 8px;">Searching eligible tasks...</span>
                            </div>
                        }
                        else if (_availableExistingTasks.Count == 0)
                        {
                            <div class="task-search-empty">
                                No eligible unassigned tasks found for this scope. You can author a new step above.
                            </div>
                        }
                        else
                        {
                            <div class="task-search-results-list">
                                @foreach (var task in _availableExistingTasks)
                                {
                                    <div class="task-search-item-row">
                                        <div class="task-search-item-info">
                                            <div style="display: flex; align-items: center; gap: 6px;">
                                                <span class="task-number-pill">#@task.Id.ToString()[..8]</span>
                                                <span class="task-item-title">@task.Title</span>
                                            </div>
                                            <div class="task-item-meta">
                                                <span>Assignee: <strong>@(string.IsNullOrWhiteSpace(task.AssigneeEmails) ? "Unassigned" : task.AssigneeEmails)</strong></span>
                                                @if (task.DueDate.Year > 2000)
                                                {
                                                    <span>Due: @task.DueDate.ToString("yyyy-MM-dd")</span>
                                                }
                                                <span>Priority: @task.Priority</span>
                                            </div>
                                        </div>
                                        <FluentButton Appearance="ButtonAppearance.Primary"
                                                      OnClick="@(() => AttachExistingTask(task))"
                                                      Style="font-size: 0.8rem; padding: 4px 10px;">
                                            Attach as Step
                                        </FluentButton>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (_stepErrors.TryGetValue("Steps", out var stepsErr))
                {
                    <div class="field-error-banner">@stepsErr</div>
                }

                <div class="step-cards-list">
                    @for (int i = 0; i < _initialState.Steps.Count; i++)
                    {
                        var stepIndex = i;
                        var step = _initialState.Steps[stepIndex];
                        var isExistingAttached = step.ExistingTaskId.HasValue && step.ExistingTaskId.Value != Guid.Empty;

                        <div class="step-builder-card @(isExistingAttached ? "card-attached" : "")">
                            <div class="step-card-top-bar">
                                <div class="step-card-order-tag">
                                    <span class="order-number">Step #@(stepIndex + 1) (Task)</span>
                                    @if (stepIndex == 0)
                                    {
                                        <span class="first-step-tag">Kickoff Step</span>
                                    }
                                    @if (isExistingAttached)
                                    {
                                        <span class="attached-tag">📎 Existing Task Attached</span>
                                    }
                                </div>

                                <div style="display: flex; align-items: center; gap: 4px;">
                                    @* Move Up / Down *@
                                    @if (stepIndex > 0 && !IsEditMode)
                                    {
                                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                                      IconStart="@(new Icons.Regular.Size16.ArrowUp())"
                                                      OnClick="@(() => MoveStepUp(stepIndex))"
                                                      Title="Move Step Up" />
                                    }
                                    @if (stepIndex < _initialState.Steps.Count - 1 && !IsEditMode)
                                    {
                                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                                      IconStart="@(new Icons.Regular.Size16.ArrowDown())"
                                                      OnClick="@(() => MoveStepDown(stepIndex))"
                                                      Title="Move Step Down" />
                                    }

                                    @* In Edit Mode: Cancel Step instead of Delete *@
                                    @if (IsEditMode && WorkflowToEdit != null)
                                    {
                                        var existingEntity = WorkflowToEdit.Steps.FirstOrDefault(s => s.Id == step.ExistingTaskId);
                                        var isCancelled = existingEntity?.Status == TaskStatusEnum.Cancelled;
                                        var isCompleted = existingEntity?.Status == TaskStatusEnum.Closed;

                                        @if (isCancelled)
                                        {
                                            <span class="cancelled-tag">Cancelled</span>
                                        }
                                        else if (isCompleted)
                                        {
                                            <span class="completed-tag">Completed</span>
                                        }
                                        else
                                        {
                                            <FluentButton Appearance="ButtonAppearance.Subtle"
                                                          IconStart="@(new Icons.Regular.Size16.Dismiss())"
                                                          OnClick="@(() => PromptCancelExistingStep(step))"
                                                          Style="color: var(--error, #d13438);"
                                                          Title="Cancel this step (cannot be deleted)" />
                                        }
                                    }
                                    else if (_initialState.Steps.Count > 1)
                                    {
                                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                                      IconStart="@(new Icons.Regular.Size16.Delete())"
                                                      OnClick="@(() => RemoveStep(stepIndex))"
                                                      Title="Remove this step" />
                                    }
                                </div>
                            </div>

                            <div class="wizard-form-grid" style="margin-top: 10px;">
                                <div class="form-half-width">
                                    <FluentTextInput Label="Step Title *"
                                                     @bind-Value="step.Title"
                                                     Style="width: 100%;"
                                                     Disabled="@(isExistingAttached && IsEditMode)"
                                                     Placeholder="E.g. Security Vulnerability Scanning" />
                                    @if (_stepErrors.TryGetValue($"Step_{stepIndex}_Title", out var stepTitleErr))
                                    {
                                        <span class="field-error-text">@stepTitleErr</span>
                                    }
                                </div>

                                <div class="form-half-width">
                                    <FluentTextInput Label="Step Owner Email *"
                                                     @bind-Value="step.StepOwnerEmail"
                                                     Style="width: 100%;"
                                                     Placeholder="lead-engineer@company.local" />
                                    @if (_stepErrors.TryGetValue($"Step_{stepIndex}_Owner", out var stepOwnerErr))
                                    {
                                        <span class="field-error-text">@stepOwnerErr</span>
                                    }
                                </div>

                                <div class="form-half-width">
                                    <FluentDatePicker Label="Step Deadline"
                                                      @bind-Value="step.DueDate"
                                                      Style="width: 100%;" />
                                </div>

                                <div class="form-half-width">
                                    <FluentTextInput Label="Deliverable Instructions / Acceptance"
                                                     @bind-Value="step.Description"
                                                     Style="width: 100%;"
                                                     Placeholder="Actionable criteria required for sign-off" />
                                </div>
                            </div>

                            @* Subtasks Builder under this step *@
                            <div class="subtask-builder-section">
                                <div class="subtask-builder-header">
                                    <span class="subtask-builder-title">
                                        <FluentIcon Value="@(new Icons.Regular.Size16.TaskListSquareLtr())" Color="Color.Default" />
                                        Subtasks Delegated to Team (@step.SubTasks.Count)
                                    </span>
                                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                                  IconStart="@(new Icons.Regular.Size12.Add())"
                                                  OnClick="@(() => AddSubTaskToStep(step))"
                                                  Style="font-size: 0.75rem; padding: 2px 6px;">
                                        Add Subtask
                                    </FluentButton>
                                </div>

                                @if (step.SubTasks.Count > 0)
                                {
                                    <div class="subtask-inputs-list">
                                        @for (int j = 0; j < step.SubTasks.Count; j++)
                                        {
                                            var subIndex = j;
                                            var sub = step.SubTasks[subIndex];

                                            <div class="subtask-input-row">
                                                <span class="sub-number">#@(subIndex + 1)</span>
                                                <FluentTextInput Placeholder="Subtask title / work item"
                                                                 @bind-Value="sub.Title"
                                                                 Style="flex: 2;" />
                                                <FluentTextInput Placeholder="Team member email"
                                                                 @bind-Value="sub.AssigneeEmail"
                                                                 Style="flex: 2;" />
                                                <FluentDatePicker @bind-Value="sub.DueDate"
                                                                  Style="flex: 1;" />
                                                <FluentButton Appearance="ButtonAppearance.Subtle"
                                                              IconStart="@(new Icons.Regular.Size12.Dismiss())"
                                                              OnClick="@(() => RemoveSubTaskFromStep(step, subIndex))"
                                                              Title="Remove subtask" />
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            </div>
        </WizardStep>

        <WizardStep Title="Review & Launch"
                    Summary="Final review before orchestrating">
            <div class="wizard-review-container">
                <div class="review-section">
                    <FluentLabel Typo="Typography.H6" Style="font-weight: 600;">@_initialState.Title</FluentLabel>
                    <p class="review-desc">@(string.IsNullOrWhiteSpace(_initialState.Description) ? "No description provided." : _initialState.Description)</p>

                    <div class="review-meta-pills">
                        <span class="review-pill">
                            <strong>Level:</strong>
                            <span class="scope-pill scope-@_initialState.Level.ToString().ToLowerInvariant()">@_initialState.Level</span>
                        </span>
                        @if (_initialState.Level == TaskLevelEnum.Program && _selectedProgram != null)
                        {
                            <span class="review-pill"><strong>Program:</strong> @_selectedProgram.Name</span>
                        }
                        @if (_initialState.Level == TaskLevelEnum.Project && _selectedProject != null)
                        {
                            <span class="review-pill"><strong>Project:</strong> @_selectedProject.Name</span>
                        }
                        <span class="review-pill"><strong>Priority:</strong> @_initialState.Priority</span>
                        <span class="review-pill"><strong>Constant Owner:</strong> @_initialState.WorkflowOwnerEmail</span>
                        @if (_initialState.DueDate.HasValue)
                        {
                            <span class="review-pill"><strong>Deadline:</strong> @_initialState.DueDate.Value.ToString("yyyy-MM-dd")</span>
                        }
                        @if (!string.IsNullOrWhiteSpace(_initialState.WatcherEmails))
                        {
                            <span class="review-pill"><strong>Watchers:</strong> @_initialState.WatcherEmails</span>
                        }
                    </div>
                </div>

                <div class="review-section">
                    <FluentLabel Typo="Typography.Body" Style="font-weight: 600; margin-bottom: 8px;">
                        Sequential Execution Flow (@_initialState.Steps.Count Steps)
                    </FluentLabel>
                    <div class="review-steps-list">
                        @for (int i = 0; i < _initialState.Steps.Count; i++)
                        {
                            var step = _initialState.Steps[i];
                            var isFirst = i == 0;
                            <div class="review-step-item">
                                <div class="review-step-num">#@(i + 1)</div>
                                <div class="review-step-body">
                                    <div class="review-step-header">
                                        <strong>@step.Title</strong>
                                        @if (isFirst)
                                        {
                                            <span class="first-active-pill">Will activate immediately</span>
                                        }
                                        else
                                        {
                                            <span class="pending-pill">Pending Step #@(i) completion</span>
                                        }
                                    </div>
                                    <div class="review-step-owner">
                                        Step Owner: <em>@step.StepOwnerEmail</em>
                                        @if (step.DueDate.HasValue)
                                        {
                                            <span> • Due: @step.DueDate.Value.ToString("yyyy-MM-dd")</span>
                                        }
                                        @if (step.SubTasks.Count > 0)
                                        {
                                            <span> • Delegated Subtasks: <strong>@step.SubTasks.Count</strong></span>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </div>
                </div>

                <div class="review-notice-box">
                    <FluentIcon Value="@(new Icons.Regular.Size16.Info())" Color="Color.Primary" />
                    <span>
                        Workflow orchestration enforces single active step ownership. The constant workflow owner
                        (@_initialState.WorkflowOwnerEmail) retains accountability and receives alerts throughout execution.
                    </span>
                </div>
            </div>
        </WizardStep>
    </Steps>
</FluentWizardModal>

@* Step Cancellation Modal Dialog (Edit Mode) *@
@if (_showCancelStepModal && _stepToCancel != null)
{
    <div class="cancel-step-dialog-backdrop">
        <div class="cancel-step-dialog">
            <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 12px;">
                <FluentIcon Value="@(new Icons.Filled.Size20.Warning())" Color="Color.Warning" />
                <FluentLabel Typo="Typography.H6" Style="font-weight: 600;">Cancel Step on Workflow</FluentLabel>
            </div>
            <p style="font-size: 0.85rem; color: var(--neutral-foreground-hint, #616161); margin-bottom: 12px;">
                Tasks once added to a workflow cannot be deleted to maintain compliance audit trails. Instead, this step will be marked as <strong>Cancelled</strong>. If the step is currently active, the workflow will be paused.
            </p>
            <FluentTextInput Label="Mandatory Cancellation Reason *"
                             @bind-Value="_cancelStepReason"
                             Placeholder="Reason for cancelling step..."
                             Style="width: 100%; margin-bottom: 16px;" />
            @if (!string.IsNullOrWhiteSpace(_cancelStepError))
            {
                <div class="field-error-text" style="margin-bottom: 12px;">@_cancelStepError</div>
            }
            <div style="display: flex; justify-content: flex-end; gap: 8px;">
                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => _showCancelStepModal = false)">Dismiss</FluentButton>
                <FluentButton Appearance="ButtonAppearance.Primary"
                              Style="background: var(--error, #d13438);"
                              OnClick="@ConfirmCancelExistingStepAsync">
                    Confirm Cancellation
                </FluentButton>
            </div>
        </div>
    </div>
}

<style>
    .wizard-form-grid {
        display: flex;
        flex-wrap: wrap;
        gap: 16px;
    }

    .form-half-width {
        flex: 1 1 calc(50% - 8px);
        min-width: 260px;
    }

    .form-full-width {
        flex: 1 1 100%;
    }

    .field-error-text {
        font-size: 0.75rem;
        color: #d13438;
        display: block;
        margin-top: 4px;
    }

    .field-help-text {
        font-size: 0.75rem;
        color: var(--neutral-foreground-hint, #616161);
        margin-top: 4px;
        display: block;
    }

    .step-builder-container {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .step-builder-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
    }

    .step-builder-title {
        font-weight: 600;
        font-size: 0.95rem;
    }

    .field-error-banner {
        background: #fde7e9;
        color: #d13438;
        padding: 8px 12px;
        border-radius: 4px;
        font-size: 0.825rem;
    }

    .step-cards-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
        max-height: 480px;
        overflow-y: auto;
        padding-right: 4px;
    }

    .step-builder-card {
        background: var(--neutral-fill-subtle-rest, #f9f9f9);
        border: 1px solid var(--neutral-stroke-subtle, #edebe9);
        border-radius: 6px;
        padding: 12px 16px;
    }

    .step-builder-card.card-attached {
        border-left: 4px solid var(--accent-fill-rest, #0078d4);
    }

    .step-card-top-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .step-card-order-tag {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .order-number {
        font-weight: 600;
        font-size: 0.85rem;
    }

    .first-step-tag {
        background: #e6f4ea;
        color: #137333;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .attached-tag {
        background: #e1f5fe;
        color: #0288d1;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .cancelled-tag {
        background: #fde7e9;
        color: #d13438;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
    }

    .completed-tag {
        background: #e6f4ea;
        color: #137333;
        font-size: 0.7rem;
        font-weight: 600;
        padding: 2px 6px;
        border-radius: 4px;
    }

    /* Task Search Picker */
    .task-search-picker-box {
        background: #f0f8ff;
        border: 1px solid #c7e0f4;
        border-radius: 6px;
        padding: 12px;
        margin-bottom: 8px;
    }

    .task-search-picker-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        font-size: 0.85rem;
    }

    .task-search-empty {
        font-size: 0.825rem;
        color: var(--neutral-foreground-hint, #616161);
        padding: 12px;
        text-align: center;
    }

    .task-search-results-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 220px;
        overflow-y: auto;
