@using System.Reflection
@using BlazorFluent.Shared.DataListTypes
@using BlazorFluent.Shared.Extensions
@using BlazorFluent.Shared.Models
@typeparam TEnum where TEnum : struct, Enum
@typeparam TValue

<FluentSelect TOption="string"
              TValue="string"
              Value="@CurrentStringValue"
              ValueChanged="@OnStringValueChangedAsync"
              Label="@Label"
              Style="@Style"
              Disabled="@Disabled">
    @if (!string.IsNullOrEmpty(Placeholder))
    {
        <FluentOption Value="">@Placeholder</FluentOption>
    }
    @foreach (var item in GetSelectableItems())
    {
        <FluentOption Value="@item.Code" Selected="@(item.Code == CurrentStringValue)">
            @item.DisplayName
        </FluentOption>
    }
</FluentSelect>

@code {
    [Parameter]
    public TValue Value { get; set; } = default!;

    [Parameter]
    public EventCallback<TValue> ValueChanged { get; set; }

    [Parameter]
    public string? Label { get; set; }

    [Parameter]
    public string? Placeholder { get; set; }

    [Parameter]
    public string? Style { get; set; }

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool Required { get; set; }

    /// <summary>
    /// Optional Category code to restrict selectable options (e.g. "TASK", "RISK").
    /// </summary>
    [Parameter]
    public string? Category { get; set; }

    /// <summary>
    /// Optional current lifecycle status. When provided on a LifecycleEnum, restricts
    /// selectable options to legal next states plus the current state.
    /// </summary>
    [Parameter]
    public TEnum? CurrentState { get; set; }

    /// <summary>
    /// Optional manual whitelist of allowed enum values.
    /// </summary>
    [Parameter]
    public IReadOnlyCollection<TEnum>? AllowedValues { get; set; }

    private string CurrentStringValue
    {
        get
        {
            if (Value == null) return string.Empty;
            if (Value is TEnum enumVal) return enumVal.ToString();
            return Value.ToString() ?? string.Empty;
        }
    }

    private IEnumerable<DataListItem<TEnum>> GetSelectableItems()
    {
        var allItems = string.IsNullOrWhiteSpace(Category)
            ? DataListExtensions.GetDataListItems<TEnum>()
            : DataListExtensions.GetDataListItemsByCategory<TEnum>(Category);

        if (AllowedValues != null && AllowedValues.Count > 0)
        {
            var allowedSet = new HashSet<TEnum>(AllowedValues);
            allItems = allItems.Where(i => allowedSet.Contains(i.Value)).ToList();
        }

        if (CurrentState.HasValue && DataListExtensions.IsLifecycleEnum<TEnum>())
        {
            var legalNext = CurrentState.Value.GetAllowedNextStates(Category);
            allItems = allItems.Where(i =>
                EqualityComparer<TEnum>.Default.Equals(i.Value, CurrentState.Value) ||
                legalNext.Contains(i.Value)).ToList();
        }

        return allItems;
    }

    private async Task OnStringValueChangedAsync(string? stringVal)
    {
        if (string.IsNullOrWhiteSpace(stringVal))
        {
            if (typeof(TValue) == typeof(TEnum?))
            {
                await ValueChanged.InvokeAsync(default!);
            }
            return;
        }

        if (stringVal.TryToEnum<TEnum>(out var parsed))
        {
            if (typeof(TValue) == typeof(TEnum))
            {
                await ValueChanged.InvokeAsync((TValue)(object)parsed);
            }
            else if (typeof(TValue) == typeof(TEnum?))
            {
                await ValueChanged.InvokeAsync((TValue)(object)(TEnum?)parsed);
            }
        }
    }
}
