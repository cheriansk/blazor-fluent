@rendermode InteractiveServer
@using BlazorFluent.Core.Contracts
@inject ITenantContext TenantContext
@inject ICurrentUser CurrentUser
@inject INavigationStateService NavState
@implements IDisposable

<div class="navmenu-container @(NavState.IsCollapsed ? "nav-collapsed" : "nav-expanded")">
    <!-- Top Toggle Row inside NavMenu -->
    <div class="nav-toggle-row">
        @if (!NavState.IsCollapsed)
        {
            <span class="nav-header-title">Menu</span>
        }
        <FluentButton Appearance="ButtonAppearance.Subtle"
                      IconStart="@(NavState.IsCollapsed ? new Icons.Regular.Size20.PanelLeftExpand() : new Icons.Regular.Size20.PanelLeftContract())"
                      OnClick="@NavState.Toggle"
                      Title="@(NavState.IsCollapsed ? "Expand Navigation Menu" : "Collapse Navigation Menu")" />
    </div>

    <FluentNav Id="main-menu" Width="@(NavState.IsCollapsed ? "54px" : "260px")">
        @if (CurrentUser.IsAuthenticated && TenantContext.HasActiveTenant)
        {
            <FluentNavItem Href="/" Match="NavLinkMatch.All" IconRest="@(new Icons.Regular.Size20.Home())" IconActive="@(new Icons.Filled.Size20.Home())" Tooltip="Home">@(!NavState.IsCollapsed ? "Home" : null)</FluentNavItem>

            @if (!TenantContext.IsRootTenant)
            {
                <FluentNavItem Href="knowledge" IconRest="@(new Icons.Regular.Size20.BookOpen())" IconActive="@(new Icons.Filled.Size20.BookOpen())" Tooltip="Knowledge Base">@(!NavState.IsCollapsed ? "Knowledge Base" : null)</FluentNavItem>
                <FluentNavItem Href="tasks" IconRest="@(new Icons.Regular.Size20.TaskListLtr())" IconActive="@(new Icons.Filled.Size20.TaskListLtr())" Tooltip="Tasks">@(!NavState.IsCollapsed ? "Tasks" : null)</FluentNavItem>
                <FluentNavItem Href="workflows" IconRest="@(new Icons.Regular.Size20.Flowchart())" IconActive="@(new Icons.Filled.Size20.Flowchart())" Tooltip="Workflows">@(!NavState.IsCollapsed ? "Workflows" : null)</FluentNavItem>
                <FluentNavItem Href="imports" IconRest="@(new Icons.Regular.Size20.ArrowSync())" IconActive="@(new Icons.Filled.Size20.ArrowSync())" Tooltip="File Imports">@(!NavState.IsCollapsed ? "File Imports" : null)</FluentNavItem>
            }
        }
    </FluentNav>
</div>

@code {
    protected override void OnInitialized()
    {
        NavState.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavState.OnChange -= HandleStateChanged;
    }
}
