@using BlazorFluent.Components.Common
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Shared.DataListTypes
@using BlazorFluent.Core.Domain.Calendar
@using BlazorFluent.Core.Domain.Tasks
@using BlazorFluent.Core.Domain.Tenancy


@using Microsoft.FluentUI.AspNetCore.Components

@inject ITenantContext TenantContext
@inject ITenantService TenantService
@inject IProgramService ProgramService
@inject ICalendarService CalendarService
@inject IHierarchyAuthorizationService HierarchyAuth
@inject ICurrentUser CurrentUser
@inject IUserTimeZoneService TimeZoneService
@inject IUnsavedChangesStateService UnsavedChanges
@implements IDisposable

<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">
    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Class="full-width">
        <div>
            <FluentLabel Typo="Typography.H4">Enterprise Programs</FluentLabel>
            <FluentLabel Typo="Typography.Body" Class="text-hint">
                Manage multi-year programs, cross-project dependencies, program health roll-ups, and project scoping.
            </FluentLabel>
        </div>
        @if (_isTenantAdmin || CurrentUser.IsRootAdmin)
        {
            <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())" OnClick="@OpenCreateProgramModal">
                Add Program
            </FluentButton>
        }
    </FluentStack>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)" AllowDismiss="true" OnDismiss="@(() => _statusMessage = null)">
            @_statusMessage
        </FluentMessageBar>
    }

    <!-- Tenant Selection Toolbar -->
    <FluentCard Class="p-4">
        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16" Wrap="true">
            <FluentSelect TOption="TenantFilterOption"
                          TValue="string"
                          Items="@_availableTenants"
                          OptionText="@(t => t.Name)"
                          OptionValue="@(t => t.Id)"
                          Value="@_selectedTenantId"
                          ValueChanged="@OnTenantSelectedAsync"
                          Disabled="@(_availableTenants.Count <= 1)"
                          Label="Filter by Tenant"
                          Placeholder="-- Select a tenant --"
                          Class="min-w-300" />

            @if (!string.IsNullOrWhiteSpace(_selectedTenantId))
            {
                <FluentButton Appearance="ButtonAppearance.Subtle"
                              IconStart="@(new Icons.Regular.Size16.ArrowSync())"
                              OnClick="@LoadProgramsAsync">
                    Refresh
                </FluentButton>
            }
        </FluentStack>
    </FluentCard>

    @* Add / Edit Program Form Card *@
    @if (_showProgramModal)
    {
        <FluentCard Class="card-accent-border p-5">
            <FluentLabel Typo="Typography.H5" Class="mb-3">
                @(_editingProgramId.HasValue ? $"Edit Program: {_programFormName}" : "Create New Program")
            </FluentLabel>

            <FluentStack Orientation="Orientation.Vertical" VerticalGap="14">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Class="full-width">
                    <FluentTextInput Label="Program Code" @bind-Value="_programFormCode" Required="true" Class="flex-1" Placeholder="e.g. PRG-CORE" Disabled="@_editingProgramId.HasValue" />
                    <FluentTextInput Label="Program Name" @bind-Value="_programFormName" Required="true" Class="flex-2" Placeholder="e.g. Cloud Modernization Program" />
                </FluentStack>

                <div>
                    <FluentLabel Typo="Typography.Body" Class="mb-1">Description / Strategic Scope</FluentLabel>
                    <FluentTextArea @bind-Value="_programFormDescription" Placeholder="Enter the high-level scope, strategic objectives, and milestones..." Rows="3" Class="full-width" />
                </div>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Class="full-width">
                    <FluentDatePicker Label="Start Date" @bind-Value="_programFormStartDate" Class="flex-1" />
                    <FluentDatePicker Label="Target Completion Date" @bind-Value="_programFormTargetEndDate" Class="flex-1" />
                    <div class="flex-1">
                        <DataListSelect TEnum="ProgramStatusEnum" TValue="ProgramStatusEnum" Label="Status" @bind-Value="_programFormStatus" Class="full-width" />
                    </div>
                </FluentStack>

                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Class="mt-2">
                    <FluentButton Appearance="ButtonAppearance.Primary"
                                  Disabled="@(!IsProgramFormValid)"
                                  OnClick="@SaveProgramAsync">
                        @(_editingProgramId.HasValue ? "Update Program" : "Create Program")
                    </FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@CloseProgramModal">
                        Cancel
                    </FluentButton>
                </FluentStack>
            </FluentStack>
        </FluentCard>
    }

    @* Programs DataGrid *@
    <FluentCard Class="p-5">
        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Class="mb-4">
            <div>
                <FluentLabel Typo="Typography.H5">Programs for &ldquo;@_selectedTenantName&rdquo;</FluentLabel>
                <FluentLabel Typo="Typography.Body" Class="text-hint">
                    Showing @_programs.Count program(s). Select a program to inspect health and manage member projects.
                </FluentLabel>
            </div>
            <FluentTextInput Placeholder="Filter programs by name, code..."
                             @bind-Value="_programSearchText"
                             @bind-Value:after="StateHasChanged"
                             Class="w-280">
                <StartTemplate>
                    <FluentIcon Value="@(new Icons.Regular.Size16.Search())" />
                </StartTemplate>
            </FluentTextInput>
        </FluentStack>

        @if (_isLoading)
        {
            <div class="d-flex justify-center p-5">
                <FluentSpinner Size="SpinnerSize.Medium" />
            </div>
        }
        else if (_programs.Count == 0)
        {
            <div class="text-center p-5 text-hint">
                <FluentIcon Value="@(new Icons.Regular.Size32.Folder())" Color="Color.Default" />
                <div class="mt-2 font-weight-600">No programs found for this tenant or your assigned roles.</div>
            </div>
        }
        else
        {
            <FluentDataGrid Items="@FilteredPrograms" ResizableColumns="true" GridTemplateColumns="120px 1.5fr 110px 140px 100px 220px">
                <PropertyColumn Property="@(p => p.Code)" Title="Code" Sortable="true" />
                <PropertyColumn Property="@(p => p.Name)" Title="Program Name" Sortable="true" />
                <TemplateColumn Title="Status" SortBy="@(GridSort<ProgramEntity>.ByAscending(p => p.Status))">
                    @switch (context.Status)
                    {
                        case ProgramStatusEnum.Active:
                            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Active</FluentBadge>
                            break;
                        case ProgramStatusEnum.Planning:
                            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Informative">Planning</FluentBadge>
                            break;
                        case ProgramStatusEnum.AtRisk:
                            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Danger">At Risk</FluentBadge>
                            break;
                        case ProgramStatusEnum.OnHold:
                            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning">On Hold</FluentBadge>
                            break;
                        case ProgramStatusEnum.Completed:
                            <FluentBadge Appearance="BadgeAppearance.Tint">Completed</FluentBadge>
                            break;
                    }
                </TemplateColumn>
                <TemplateColumn Title="Timeline" SortBy="@(GridSort<ProgramEntity>.ByAscending(p => p.StartDate))">
                    <span class="font-size-sm">
                        @TimeZoneService.FormatDate(context.StartDate) ~ @TimeZoneService.FormatDate(context.EndDate ?? context.DueDate)
                    </span>
                </TemplateColumn>
                <TemplateColumn Title="Projects">
                    <FluentBadge Appearance="BadgeAppearance.Tint">@context.Projects.Count</FluentBadge>
                </TemplateColumn>
                <TemplateColumn Title="Actions">
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6">
                        <FluentButton Appearance="@(_selectedProgram?.Id == context.Id ? ButtonAppearance.Primary : ButtonAppearance.Outline)"
                                      Size="ButtonSize.Small"
                                      IconStart="@(new Icons.Regular.Size16.Checkmark())"
                                      OnClick="@(() => SelectProgramAsync(context))">
                            @(_selectedProgram?.Id == context.Id ? "Selected" : "Select")
                        </FluentButton>
                        @if (_isTenantAdmin || CurrentUser.IsRootAdmin || _programAdminIds.Contains(context.Id))
                        {
                            <FluentButton Appearance="ButtonAppearance.Subtle"
                                          Size="ButtonSize.Small"
                                          IconStart="@(new Icons.Regular.Size16.Edit())"
                                          OnClick="@(() => OpenEditProgramModal(context))">
                                Edit
                            </FluentButton>
                        }
                        <EntityHistoryButton EntityName="ProgramEntity" EntityId="@context.Id.ToString()" Tooltip="View program history" />
                    </FluentStack>
                </TemplateColumn>
            </FluentDataGrid>
        }
    </FluentCard>

    @* Selected Program Workspace Panel *@
    @if (_selectedProgram is not null)
    {
        <FluentCard Class="card-accent-border p-5">
            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Class="mb-4">
                <div>
                    <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="10">
                        <FluentLabel Typo="Typography.H5">@_selectedProgram.Name</FluentLabel>
                        <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Brand">@_selectedProgram.Code</FluentBadge>
                        <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">@_selectedProgram.Status</FluentBadge>
                    </FluentStack>
                    <div class="font-size-sm text-hint mt-1">
                        ID: <code>@_selectedProgram.Id</code> &bull; Tenant: <code>@_selectedProgram.TenantId</code>
                    </div>
                </div>
                <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size16.Dismiss())" OnClick="@(() => _selectedProgram = null)">
                    Close Panel
                </FluentButton>
            </FluentStack>

            <FluentTabs @bind-ActiveTabId="_activeProgramTab">
                <!-- Tab 1: Health & Cross-Project Dependencies -->
                <FluentTab Id="tab-health">
                    <HeaderTemplate>
                        <FluentIcon Value="@(new Icons.Regular.Size16.LightbulbPulse())" Class="me-2" />
                        Health & Roll-Up
                    </HeaderTemplate>
                    <Content>
                    <div class="pt-4">
                        @if (_isLoadingHealth)
                        {
                            <FluentSpinner Size="SpinnerSize.Small" />
                        }
                        else if (_healthSummary is not null)
                        {
                            <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                                <!-- Health KPI Cards -->
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Wrap="true">
                                    <FluentCard Class="flex-1 min-w-180 p-3">
                                        <div class="font-size-sm text-hint">Overall Health</div>
                                        <div class="mt-1">
                                            @switch (_healthSummary.Health)
                                            {
                                                case ProgramHealthRatingEnum.OnTrack:
                                                    <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success" Class="font-size-sm p-1">🟢 Healthy (On Track)</FluentBadge>
                                                    break;
                                                case ProgramHealthRatingEnum.AtRisk:
                                                    <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning" Class="font-size-sm p-1">🟡 At Risk</FluentBadge>
                                                    break;
                                                case ProgramHealthRatingEnum.Critical:
                                                    <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Danger" Class="font-size-sm p-1">🔴 Critical</FluentBadge>
                                                    break;
                                            }
                                        </div>
                                    </FluentCard>

                                    <FluentCard Class="flex-1 min-w-140 p-3">
                                        <div class="font-size-sm text-hint">Member Projects</div>
                                        <div class="metric-kpi-val mt-1">
                                            @_healthSummary.ActiveProjects / @_healthSummary.TotalProjects
                                        </div>
                                    </FluentCard>

                                    <FluentCard Class="flex-1 min-w-140 p-3">
                                        <div class="font-size-sm text-hint">Overdue Tasks</div>
                                        <div class="@(_healthSummary.OverdueTasks > 0 ? "metric-kpi-val mt-1 text-danger" : "metric-kpi-val mt-1")">
                                            @_healthSummary.OverdueTasks
                                        </div>
                                    </FluentCard>

                                    <FluentCard Class="flex-1 min-w-180 p-3">
                                        <div class="font-size-sm text-hint">Cross-Project Blockers</div>
                                        <div class="@(_healthSummary.CrossProjectBlockersCount > 0 ? "metric-kpi-val mt-1 text-danger" : "metric-kpi-val mt-1")">
                                            @_healthSummary.CrossProjectBlockersCount
                                        </div>
                                    </FluentCard>
                                </FluentStack>

                                <!-- Cross-Project Dependencies Breakdown -->
                                <FluentLabel Typo="Typography.H6" Class="mt-2">Cross-Project Dependencies</FluentLabel>
                                @if (_healthSummary.CrossProjectDependencies.Count == 0)
                                {
                                    <div class="text-hint font-size-sm">
                                        No cross-project dependencies detected between member projects.
                                    </div>
                                }
                                else
                                {
                                    <FluentDataGrid Items="@_healthSummary.CrossProjectDependencies.AsQueryable()" ResizableColumns="true">
                                        <TemplateColumn Title="Blocked Task">
                                            <strong>@context.SourceTaskTitle</strong>
                                            <span class="font-size-xs text-hint d-block">in @context.SourceProjectName</span>
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(d => d.DependencyType)" Title="Relation" />
                                        <TemplateColumn Title="Depends On (Blocker)">
                                            <strong>@context.TargetTaskTitle</strong>
                                            <span class="font-size-xs text-hint d-block">in @context.TargetProjectName</span>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Blocker Status">
                                            @if (context.IsResolved)
                                            {
                                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Resolved</FluentBadge>
                                            }
                                            else
                                            {
                                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Danger">Blocking</FluentBadge>
                                            }
                                        </TemplateColumn>
                                    </FluentDataGrid>
                                }
                            </FluentStack>
                        }
                    </div>
                </FluentTab>

                <!-- Tab 2: Projects in this Program -->
                </Content>
                </FluentTab>
                <FluentTab Id="tab-projects">
                    <HeaderTemplate>
                        <FluentIcon Value="@(new Icons.Regular.Size16.BuildingMultiple())" Class="me-2" />
                        Projects in Program
                    </HeaderTemplate>
                    <Content>
                    <div class="pt-4">
                        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Class="mb-3">
                            <FluentLabel Typo="Typography.H6">Member Projects (@_programProjects.Count)</FluentLabel>
                            @if (_canManageSelectedProgramProjects)
                            {
                                <FluentButton Appearance="ButtonAppearance.Primary"
                                              Size="ButtonSize.Small"
                                              IconStart="@(new Icons.Regular.Size16.Add())"
                                              OnClick="@OpenAddProjectModal">
                                    Add Project to Program
                                </FluentButton>
                            }
                        </FluentStack>

                        @* Add Project Sub-Card *@
                        @if (_showAddProjectModal)
                        {
                            <FluentCard Class="mb-4 p-4">
                                <FluentLabel Typo="Typography.H6" Class="mb-3">
                                    Add Project to Program: @_selectedProgram.Name
                                </FluentLabel>
                                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Class="full-width">
                                        <FluentTextInput Label="Project Name" @bind-Value="_projName" Required="true" Class="flex-2" Placeholder="e.g. Identity Architecture Modernization" />
                                        <FluentTextInput Label="Short Code" @bind-Value="_projShortCode" Required="true" Class="flex-1" Placeholder="e.g. IAM-01" />
                                    </FluentStack>

                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16" Class="full-width">
                                        <FluentTextInput Label="Location" @bind-Value="_projLocation" Class="flex-2" Placeholder="e.g. Headquarters / Remote" />
                                        <div class="flex-1">
                                            <DataListSelect TEnum="ProjectStatusEnum" TValue="ProjectStatusEnum" Label="Status" @bind-Value="_projStatus" Class="full-width" />
                                        </div>
                                    </FluentStack>

                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="16">
                                        <FluentDatePicker Label="Tentative Start Date" @bind-Value="_projStartDate" />
                                        <FluentDatePicker Label="Tentative End Date" @bind-Value="_projEndDate" />
                                    </FluentStack>

                                    <div>
                                        <FluentLabel Typo="Typography.Body" Class="mb-1">Summary of Scope of Project</FluentLabel>
                                        <FluentTextArea @bind-Value="_projScopeSummary" Placeholder="Brief summary of project scope, deliverables, and goals..." Rows="3" Class="full-width" />
                                    </div>

                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Class="mt-2">
                                        <FluentButton Appearance="ButtonAppearance.Primary"
                                                      Disabled="@(!IsProjectFormValid)"
                                                      OnClick="@CreateProgramProjectAsync">
                                            Save Project
                                        </FluentButton>
                                        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@CloseProjectModal">
                                            Cancel
                                        </FluentButton>
                                    </FluentStack>
                                </FluentStack>
                            </FluentCard>
                        }

                        @if (_isLoadingProjects)
                        {
                            <FluentSpinner Size="SpinnerSize.Small" />
                        }
                        else if (_programProjects.Count == 0)
                        {
                            <div class="text-hint font-size-sm p-4">
                                No projects currently assigned to this program. Click &ldquo;Add Project to Program&rdquo; to create a project workspace.
                            </div>
                        }
                        else
                        {
                            <FluentDataGrid Items="@_programProjects.AsQueryable()" ResizableColumns="true" GridTemplateColumns="120px 1.5fr 110px 140px 180px">
                                <PropertyColumn Property="@(p => p.ShortCode)" Title="Code" Sortable="true" />
                                <PropertyColumn Property="@(p => p.Name)" Title="Project Name" Sortable="true" />
                                <TemplateColumn Title="Status">
                                    @switch (context.Status)
                                    {
                                        case ProjectStatusEnum.Active:
                                            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Active</FluentBadge>
                                            break;
                                        case ProjectStatusEnum.New:
                                            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Informative">New</FluentBadge>
                                            break;
                                        case ProjectStatusEnum.OnHold:
                                            <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning">OnHold</FluentBadge>
                                            break;
                                        case ProjectStatusEnum.Done:
                                            <FluentBadge Appearance="BadgeAppearance.Tint">Done</FluentBadge>
                                            break;
                                    }
                                </TemplateColumn>
                                <TemplateColumn Title="Timeline">
                                    <span class="font-size-sm">
                                        @TimeZoneService.FormatDate(context.StartDate) ~ @TimeZoneService.FormatDate(context.EndDate ?? context.DueDate)
                                    </span>
                                </TemplateColumn>
                                <TemplateColumn Title="Actions">
                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6">
                                        <FluentLink Appearance="LinkAppearance.Subtle" Href="@($"/projects/{context.Id}/tasks")" Class="font-size-sm">
                                            Tasks
                                        </FluentLink>
                                        <EntityHistoryButton EntityName="ProjectEntity" EntityId="@context.Id.ToString()" Tooltip="View project history" />
                                    </FluentStack>
                                </TemplateColumn>
                            </FluentDataGrid>
                        }
                    </div>
                </FluentTab>

                <!-- Tab 3: Program Calendar & Deadlines -->
                </Content>
                </FluentTab>
                <FluentTab Id="tab-calendar">
                    <HeaderTemplate>
                        <FluentIcon Value="@(new Icons.Regular.Size16.Calendar())" Class="me-2" />
                        Calendar & Deadlines
                    </HeaderTemplate>
                    <Content>
                    <div class="pt-4">
                        @if (_isLoadingCalendar)
                        {
                            <FluentSpinner Size="SpinnerSize.Small" />
                        }
                        else
                        {
                            <FluentCalendarScheduleComp Items="@_programCalendarItems"
                                                        @bind-SelectedDate="_selectedCalendarDate"
                                                        ReadOnly="@(!_canManageSelectedProgramProjects)"
                                                        OnAddEntry="@OpenAddProgramCalendarModal" />
                        }
                    </div>
                </FluentTab>

                <!-- Tab 4: Program R.A.I.D. Log -->
                </Content>
                </FluentTab>
                <FluentTab Id="tab-raid">
                    <HeaderTemplate>
                        <FluentIcon Value="@(new Icons.Regular.Size16.ShieldTask())" Class="me-2" />
                        Program R.A.I.D. Log
                    </HeaderTemplate>
                    <Content>
                    <div class="pt-4">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
                            <FluentRadioGroup @bind-Value="_selectedRaidCategory">
                                <FluentRadio Value="@("Risks")">Risks (R: @_programRisks.Count)</FluentRadio>
                                <FluentRadio Value="@("Assumptions")">Assumptions (A: @_programAssumptions.Count)</FluentRadio>
                                <FluentRadio Value="@("Issues")">Issues (I: @_programIssues.Count)</FluentRadio>
                                <FluentRadio Value="@("Blockers")">Blocker Dependencies (D: @_programBlockers.Count)</FluentRadio>
                            </FluentRadioGroup>

                            @if (_selectedRaidCategory == "Risks")
                            {
                                @if (_programRisks.Count == 0)
                                {
                                    <div class="text-hint font-size-sm">No program risks logged.</div>
                                }
                                else
                                {
                                    <FluentDataGrid Items="@_programRisks.AsQueryable()" ResizableColumns="true">
                                        <PropertyColumn Property="@(r => r.Title)" Title="Risk Title" />
                                        <PropertyColumn Property="@(r => r.Impact)" Title="Impact" />
                                        <PropertyColumn Property="@(r => r.Probability)" Title="Probability" />
                                        <TemplateColumn Title="Exposure">
                                            <FluentBadge Appearance="BadgeAppearance.Filled" Color="@(context.ExposureScore >= 6 ? BadgeColor.Danger : BadgeColor.Warning)">
                                                Score: @context.ExposureScore
                                            </FluentBadge>
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(r => r.RiskStatus)" Title="Status" />
                                        <TemplateColumn Title="Target Due Date">
                                            @TimeZoneService.FormatDate(context.DueDate)
                                        </TemplateColumn>
                                    </FluentDataGrid>
                                }
                            }
                            else if (_selectedRaidCategory == "Assumptions")
                            {
                                @if (_programAssumptions.Count == 0)
                                {
                                    <div class="text-hint font-size-sm">No program assumptions logged.</div>
                                }
                                else
                                {
                                    <FluentDataGrid Items="@_programAssumptions.AsQueryable()" ResizableColumns="true">
                                        <PropertyColumn Property="@(a => a.Title)" Title="Assumption" />
                                        <PropertyColumn Property="@(a => a.ValidationCriteria)" Title="Validation Criteria" />
                                        <PropertyColumn Property="@(a => a.ValidationStatus)" Title="Status" />
                                        <PropertyColumn Property="@(a => a.ImpactIfInvalid)" Title="Impact if Invalid" />
                                        <TemplateColumn Title="Validation Due Date">
                                            @TimeZoneService.FormatDate(context.DueDate)
                                        </TemplateColumn>
                                    </FluentDataGrid>
                                }
                            }
                            else if (_selectedRaidCategory == "Issues")
                            {
                                @if (_programIssues.Count == 0)
                                {
                                    <div class="text-hint font-size-sm">No active program impediments logged.</div>
                                }
                                else
                                {
                                    <FluentDataGrid Items="@_programIssues.AsQueryable()" ResizableColumns="true">
                                        <PropertyColumn Property="@(i => i.Title)" Title="Issue Title" />
                                        <PropertyColumn Property="@(i => i.Severity)" Title="Severity" />
                                        <PropertyColumn Property="@(i => i.Status)" Title="Status" />
                                        <PropertyColumn Property="@(i => i.Workaround)" Title="Workaround" />
                                        <PropertyColumn Property="@(i => i.ResolutionStrategy)" Title="Resolution" />
                                        <TemplateColumn Title="Resolution Due Date">
                                            @TimeZoneService.FormatDate(context.DueDate)
                                        </TemplateColumn>
                                    </FluentDataGrid>
                                }
                            }
                            else if (_selectedRaidCategory == "Blockers")
                            {
                                @if (_programBlockers.Count == 0)
                                {
                                    <div class="text-hint font-size-sm">No blocker dependency contracts logged.</div>
                                }
                                else
                                {
                                    <FluentDataGrid Items="@_programBlockers.AsQueryable()" ResizableColumns="true">
                                        <TemplateColumn Title="Dependent Item (Blocked)">
                                            <strong>@context.Title</strong>
                                        </TemplateColumn>
                                        <TemplateColumn Title="Prerequisite Item (Blocking)">
                                            <strong>@(context.DependsOnSnapshotTitle ?? "Prerequisite Item")</strong>
                                            @if (context.IsScheduleConflict)
                                            {
                                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Warning" Class="ml-2">Schedule Conflict</FluentBadge>
                                            }
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(b => b.Criticality)" Title="Criticality" />
                                        <TemplateColumn Title="Status">
                                            @if (context.IsResolved)
                                            {
                                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Success">Resolved</FluentBadge>
                                            }
                                            else
                                            {
                                                <FluentBadge Appearance="BadgeAppearance.Filled" Color="BadgeColor.Danger">Blocking</FluentBadge>
                                            }
                                        </TemplateColumn>
                                        <PropertyColumn Property="@(b => b.ImpactDetails)" Title="Impact Details" />
                                        <TemplateColumn Title="SLA Resolve Due Date">
                                            @TimeZoneService.FormatDate(context.DueDate)
                                        </TemplateColumn>
                                    </FluentDataGrid>
                                }
                            }
                        </FluentStack>
                    </div>
                </FluentTab>
                    </Content>
                </FluentTab>
            </FluentTabs>
        </FluentCard>
    }
</FluentStack>

@code {
    public record TenantFilterOption(string Id, string Name);

    private List<TenantFilterOption> _availableTenants = [];
    private string? _selectedTenantId;
    private string _selectedTenantName = string.Empty;

    private List<ProgramEntity> _programs = [];
    private HashSet<Guid> _accessibleProgramIds = [];
    private HashSet<Guid> _programAdminIds = [];
    private bool _isTenantAdmin = false;
    private bool _isLoading = false;
    private string? _statusMessage;
    private bool _isError;
    private string _programSearchText = string.Empty;

    // Selected Program state
    private ProgramEntity? _selectedProgram;
    private string _activeProgramTab = "tab-health";
    private bool _isLoadingHealth = false;
    private ProgramHealthSummaryDto? _healthSummary;
    private bool _isLoadingProjects = false;
    private List<ProjectEntity> _programProjects = [];
    private bool _canManageSelectedProgramProjects = false;

    // Program Calendar & RAID State
    private bool _isLoadingCalendar = false;
    private DateTime _selectedCalendarDate = DateTime.UtcNow.Date;
    private IReadOnlyList<CalendarItemDto> _programCalendarItems = [];
    private string _selectedRaidCategory = "Risks";
    private List<RiskEntity> _programRisks = [];
    private List<AssumptionEntity> _programAssumptions = [];
    private List<IssueEntity> _programIssues = [];
    private List<WorkDependencyEntity> _programBlockers = [];

    // Add / Edit Program Form
    private bool _showProgramModal = false;
    private Guid? _editingProgramId = null;
    private string _programFormCode = string.Empty;
    private string _programFormName = string.Empty;
    private string _programFormDescription = string.Empty;
    private DateTime? _programFormStartDate;
    private DateTime? _programFormTargetEndDate;
    private ProgramStatusEnum _programFormStatus = ProgramStatusEnum.Active;

    // Add Project Modal under selected program
    private bool _showAddProjectModal = false;
    private string _projName = string.Empty;
    private string _projShortCode = string.Empty;
    private string _projLocation = string.Empty;
    private ProjectStatusEnum _projStatus = ProjectStatusEnum.New;
    private DateTime? _projStartDate;
    private DateTime? _projEndDate;
    private string _projScopeSummary = string.Empty;

    private bool IsProgramFormValid =>
        !string.IsNullOrWhiteSpace(_programFormCode) &&
        !string.IsNullOrWhiteSpace(_programFormName);

    private bool IsProjectFormValid =>
        !string.IsNullOrWhiteSpace(_projName) &&
        !string.IsNullOrWhiteSpace(_projShortCode);

    private IQueryable<ProgramEntity> FilteredPrograms
    {
        get
        {
            var result = _programs.AsQueryable();
            if (!string.IsNullOrWhiteSpace(_programSearchText))
            {
                result = result.Where(p =>
                    p.Name.Contains(_programSearchText, StringComparison.OrdinalIgnoreCase) ||
                    p.Code.Contains(_programSearchText, StringComparison.OrdinalIgnoreCase));
            }
            return result;
        }
    }

    protected override async Task OnInitializedAsync()
    {
        await LoadAvailableTenantsAsync();
    }

    private async Task LoadAvailableTenantsAsync()
    {
        if (CurrentUser.IsRootAdmin)
        {
            try
            {
                var allTenants = await TenantService.GetAllTenantsAsync();
                _availableTenants = allTenants
                    .Where(t => t.IsActive)
                    .OrderBy(t => t.Name)
                    .Select(t => new TenantFilterOption(t.Slug, t.Name))
                    .ToList();
            }
            catch
            {
                _availableTenants = [];
            }
        }
        else
        {
            _availableTenants = TenantContext.AllowedTenants
                .Where(t => t.IsActive && t.Slug != "default")
                .OrderBy(t => t.Name)
                .Select(t => new TenantFilterOption(t.Id.ToString(), t.Name))
                .ToList();

            if (_availableTenants.Count == 0 && TenantContext.HasActiveTenant && TenantContext.TenantId != Guid.Empty)
            {
                _availableTenants.Add(new TenantFilterOption(TenantContext.TenantId.ToString(), TenantContext.TenantName ?? string.Empty));
            }
        }

        var defaultSlug = TenantContext.HasActiveTenant && TenantContext.TenantId != Guid.Empty ? TenantContext.TenantId.ToString() : _availableTenants.FirstOrDefault()?.Id;
        if (!string.IsNullOrWhiteSpace(defaultSlug))
        {
            await OnTenantSelectedAsync(defaultSlug);
        }
    }

    private async Task OnTenantSelectedAsync(string? tenantSlug)
    {
        _selectedTenantId = tenantSlug;
        _selectedTenantName = _availableTenants.FirstOrDefault(t => t.Id == tenantSlug)?.Name ?? tenantSlug ?? string.Empty;
        _selectedProgram = null;
        _healthSummary = null;
        _programProjects.Clear();

        if (!string.IsNullOrWhiteSpace(_selectedTenantId))
        {
            await LoadProgramsAsync();
        }
        else
        {
            _programs.Clear();
        }
    }

    private async Task LoadProgramsAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedTenantId)) return;

        _isLoading = true;
        try
        {
            var userId = CurrentUser.IsAuthenticated ? CurrentUser.UserId : string.Empty;
            _isTenantAdmin = await HierarchyAuth.IsTenantAdminAsync(_selectedTenantId, userId);
            var accessible = await HierarchyAuth.GetAccessibleProgramIdsAsync(_selectedTenantId, userId);
            _accessibleProgramIds = accessible.ToHashSet();

            var allTenantPrograms = await ProgramService.GetProgramsAsync(_selectedTenantId);

            // Zero Trust gate: Tenant Admin receives all programs; Program Admin receives strictly accessible programs
            if (_isTenantAdmin || CurrentUser.IsRootAdmin)
            {
                _programs = allTenantPrograms.ToList();
            }
            else
            {
                _programs = allTenantPrograms.Where(p => _accessibleProgramIds.Contains(p.Id)).ToList();
            }

            // Identify which programs the current user is an admin of
            _programAdminIds.Clear();
            foreach (var prog in _programs)
            {
                if (await HierarchyAuth.IsProgramAdminAsync(prog.Id, userId))
                {
                    _programAdminIds.Add(prog.Id);
                }
            }

            if (_selectedProgram != null)
            {
                _selectedProgram = _programs.FirstOrDefault(p => p.Id == _selectedProgram.Id);
            }
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to load programs: {ex.Message}";
            _isError = true;
            _programs.Clear();
        }
        finally
        {
            _isLoading = false;
        }
    }

    private async Task SelectProgramAsync(ProgramEntity program)
    {
        _selectedProgram = program;
        _activeProgramTab = "tab-health";
        _canManageSelectedProgramProjects = _isTenantAdmin || CurrentUser.IsRootAdmin || _programAdminIds.Contains(program.Id);
        await LoadProgramHealthAsync();
        await LoadProgramProjectsAsync();
        await LoadProgramCalendarAsync();
        await LoadProgramRaidAsync();
    }

    private async Task LoadProgramCalendarAsync()
    {
        if (_selectedProgram == null || string.IsNullOrWhiteSpace(_selectedTenantId)) return;
        _isLoadingCalendar = true;
        try
        {
            var start = DateTime.UtcNow.Date.AddMonths(-2);
            var end = DateTime.UtcNow.Date.AddMonths(10);
            var tenantGuid = Guid.TryParse(_selectedTenantId, out var g) ? g : Guid.Empty;
            _programCalendarItems = await CalendarService.GetProgramCalendarAsync(tenantGuid, _selectedProgram.Id, start, end);
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to load program calendar: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isLoadingCalendar = false;
        }
    }

    private async Task LoadProgramRaidAsync()
    {
        if (_selectedProgram == null || string.IsNullOrWhiteSpace(_selectedTenantId)) return;
        var tenantGuid = Guid.TryParse(_selectedTenantId, out var g) ? g : Guid.Empty;
        try
        {
            _programRisks = (await ProgramService.GetProgramRisksAsync(_selectedProgram.Id)).ToList();
            _programAssumptions = (await ProgramService.GetProgramAssumptionsAsync(_selectedProgram.Id)).ToList();
            _programIssues = (await ProgramService.GetProgramIssuesAsync(_selectedProgram.Id)).ToList();
            _programBlockers = (await ProgramService.GetProgramBlockersAsync(_selectedProgram.Id)).ToList();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to load program RAID items: {ex.Message}";
            _isError = true;
        }
    }

    private void OpenAddProgramCalendarModal(DateTime date)
    {
        _selectedCalendarDate = date;
        _statusMessage = $"Schedule event for {date:yyyy-MM-dd}.";
        _isError = false;
    }

    private async Task LoadProgramHealthAsync()
    {
        if (_selectedProgram == null) return;
        _isLoadingHealth = true;
        try
        {
            _healthSummary = await ProgramService.GetProgramHealthAsync(_selectedProgram.Id);
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to calculate program health: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isLoadingHealth = false;
        }
    }

    private async Task LoadProgramProjectsAsync()
    {
        if (_selectedProgram == null) return;
        _isLoadingProjects = true;
        try
        {
            var projects = await ProgramService.GetProgramProjectsAsync(_selectedProgram.Id);
            _programProjects = projects.ToList();
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to load program projects: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isLoadingProjects = false;
        }
    }

    // --- Add / Edit Program ---
    private void OpenCreateProgramModal()
    {
        _editingProgramId = null;
        _programFormCode = string.Empty;
        _programFormName = string.Empty;
        _programFormDescription = string.Empty;
        _programFormStartDate = DateTime.UtcNow.Date;
        _programFormTargetEndDate = DateTime.UtcNow.Date.AddMonths(12);
        _programFormStatus = ProgramStatusEnum.Active;
        _showProgramModal = true;
        UnsavedChanges.RegisterChange("Settings > Programs", "Creating new program");
    }

    private void OpenEditProgramModal(ProgramEntity program)
    {
        _editingProgramId = program.Id;
        _programFormCode = program.Code;
        _programFormName = program.Name;
        _programFormDescription = program.Description;
        _programFormStartDate = program.StartDate;
        _programFormTargetEndDate = program.EndDate ?? program.DueDate;
        _programFormStatus = program.Status;
        _showProgramModal = true;
        UnsavedChanges.RegisterChange("Settings > Programs", $"Editing program '{program.Name}'");
    }

    private void CloseProgramModal()
    {
        _showProgramModal = false;
        UnsavedChanges.ClearChange("Settings > Programs");
    }

    private async Task SaveProgramAsync()
    {
        if (string.IsNullOrWhiteSpace(_selectedTenantId) || !IsProgramFormValid) return;

        if (_editingProgramId.HasValue)
        {
            var updateResult = await ProgramService.UpdateProgramAsync(
                _editingProgramId.Value,
                _programFormName,
                _programFormCode,
                _programFormDescription,
                _programFormStartDate,
                _programFormTargetEndDate,
                _programFormStatus,
                isActive: true);

            if (updateResult.Succeeded && updateResult.Data is not null)
            {
                _statusMessage = $"Program '{updateResult.Data.Name}' updated successfully.";
                _isError = false;
                CloseProgramModal();
                await LoadProgramsAsync();
                if (_selectedProgram?.Id == _editingProgramId)
                {
                    await SelectProgramAsync(updateResult.Data);
                }
            }
            else
            {
                _statusMessage = updateResult.Errors.FirstOrDefault() ?? "Failed to update program.";
                _isError = true;
            }
        }
        else
        {
            var createResult = await ProgramService.CreateProgramAsync(
                _selectedTenantId,
                _programFormName,
                _programFormCode,
                _programFormDescription,
                _programFormStartDate,
                _programFormTargetEndDate,
                _programFormStatus);

            if (createResult.Succeeded && createResult.Data is not null)
            {
                _statusMessage = $"Program '{createResult.Data.Name}' created successfully.";
                _isError = false;
                CloseProgramModal();
                await LoadProgramsAsync();
                await SelectProgramAsync(createResult.Data);
            }
            else
            {
                _statusMessage = createResult.Errors.FirstOrDefault() ?? "Failed to create program.";
                _isError = true;
            }
        }
    }

    // --- Add Project to Program ---
    private void OpenAddProjectModal()
    {
        _projName = string.Empty;
        _projShortCode = string.Empty;
        _projLocation = string.Empty;
        _projStatus = ProjectStatusEnum.New;
        _projStartDate = DateTime.UtcNow.Date;
        _projEndDate = DateTime.UtcNow.Date.AddMonths(6);
        _projScopeSummary = string.Empty;
        _showAddProjectModal = true;
        UnsavedChanges.RegisterChange("Settings > Programs", "Adding project to program");
    }

    private void CloseProjectModal()
    {
        _showAddProjectModal = false;
        UnsavedChanges.ClearChange("Settings > Programs");
    }

    private async Task CreateProgramProjectAsync()
    {
        if (_selectedProgram == null || string.IsNullOrWhiteSpace(_selectedTenantId) || !IsProjectFormValid) return;

        var result = await TenantService.CreateTenantProjectAsync(
            _selectedTenantId,
            _projName,
            _projShortCode,
            _projLocation,
            _projStartDate,
            _projEndDate,
            _projScopeSummary,
            _projStatus,
            programId: _selectedProgram.Id);

        if (result.Succeeded && result.Data is not null)
        {
            _statusMessage = $"Project '{result.Data.Name}' added to program '{_selectedProgram.Name}'.";
            _isError = false;
            CloseProjectModal();
            await LoadProgramProjectsAsync();
            await LoadProgramHealthAsync();
        }
        else
        {
            _statusMessage = result.Errors.FirstOrDefault() ?? "Failed to add project.";
            _isError = true;
        }
    }

    public void Dispose()
    {
        UnsavedChanges.ClearChange("Settings > Programs");
    }
}