@using BlazorFluent.Components.Common
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Shared.DataListTypes
@using BlazorFluent.Core.Domain.Calendar
@using Microsoft.FluentUI.AspNetCore.Components
@inject ICalendarService CalendarService
@inject ICurrentUser CurrentUser
@inject ITenantContext TenantContext

<FluentStack Orientation="Orientation.Vertical" VerticalGap="16">
    <div style="display: flex; justify-content: space-between; align-items: center; width: 100%;">
        <div>
            <FluentLabel Typo="Typography.H4">My Schedule & Calendar</FluentLabel>
            <FluentLabel Typo="Typography.Body" Style="color: var(--neutral-foreground-hint);">
                Your consolidated schedule: personal appointments, sprint commitments, and assigned work item deadlines across all projects.
            </FluentLabel>
        </div>
        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.Add())" OnClick="OpenNewEventModal">
            Add Appointment
        </FluentButton>
    </div>

    @if (!string.IsNullOrWhiteSpace(_statusMessage))
    {
        <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)" AllowDismiss="true" OnDismiss="@(() => _statusMessage = null)">
            @_statusMessage
        </FluentMessageBar>
    }

    @if (_isLoading)
    {
        <div style="display: flex; justify-content: center; padding: 40px;">
            <FluentSpinner Size="SpinnerSize.Medium" />
        </div>
    }
    else
    {
        <FluentCalendarScheduleComp Items="@_calendarItems" 
                                    @bind-SelectedDate="_selectedDate" 
                                    OnItemClick="HandleItemClick"
                                    OnAddEntry="HandleAddEntryForDate" />
    }

    <!-- Add Appointment Modal -->
    @if (_showEventModal)
    {
        <div class="calendar-modal-backdrop">
            <div class="calendar-modal-card">
                <div class="modal-header">
                    <h4>New Personal Appointment</h4>
                    <FluentButton Appearance="ButtonAppearance.Subtle" 
                                  IconStart="@(new Icons.Regular.Size16.Dismiss())" 
                                  OnClick="() => _showEventModal = false" />
                </div>
                <div class="modal-body">
                    @if (!string.IsNullOrWhiteSpace(_modalError))
                    {
                        <FluentMessageBar Intent="MessageBarIntent.Error" AllowDismiss="true" OnDismiss="@(() => _modalError = null)" Style="margin-bottom: 12px;">
                            @_modalError
                        </FluentMessageBar>
                    }
                    <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">
                        <FluentTextInput Label="Title *" @bind-Value="_newEventTitle" Placeholder="e.g. Sprint Review Prep, Focus Time" Style="width: 100%;" />
                        
                        <FluentSelect TOption="CalendarEntryTypeEnum" TValue="CalendarEntryTypeEnum" Label="Category" @bind-Value="_newEntryType" Style="width: 100%;">
                            <FluentOption Value="CalendarEntryTypeEnum.General">General</FluentOption>
                            <FluentOption Value="CalendarEntryTypeEnum.WorkingSession">Working Focus Session</FluentOption>
                            <FluentOption Value="CalendarEntryTypeEnum.Planning">Planning</FluentOption>
                            <FluentOption Value="CalendarEntryTypeEnum.TimeOff">Planned Time Off</FluentOption>
                        </FluentSelect>

                        <FluentDatePicker Label="Date" @bind-Value="_newEventDate" Style="width: 100%;" />

                        <FluentTextArea Label="Description / Agenda" @bind-Value="_newEventDescription" Rows="3" Style="width: 100%;" />

                        <FluentTextInput Label="Location or Meeting Link" @bind-Value="_newLocation" Placeholder="e.g. Teams, Room 402" Style="width: 100%;" />
                    </FluentStack>
                </div>
                <div class="modal-footer">
                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="() => _showEventModal = false">Cancel</FluentButton>
                    <FluentButton Appearance="ButtonAppearance.Primary" OnClick="SaveNewEventAsync" Loading="_isSaving">Save Event</FluentButton>
                </div>
            </div>
        </div>
    }
</FluentStack>

<style>
    .calendar-modal-backdrop {
        position: fixed;
        inset: 0;
        background: rgba(0,0,0,0.45);
        display: flex;
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }
    .calendar-modal-card {
        background: var(--neutral-fill-layer-rest, #fff);
        border-radius: 8px;
        width: 100%;
        max-width: 480px;
        box-shadow: 0 8px 24px rgba(0,0,0,0.2);
    }
    .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 1rem;
        border-bottom: 1px solid var(--neutral-stroke-divider-rest, #e0e0e0);
    }
    .modal-header h4 {
        margin: 0;
    }
    .modal-body {
        padding: 1rem;
    }
    .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 0.5rem;
        padding: 0.75rem 1rem;
        border-top: 1px solid var(--neutral-stroke-divider-rest, #e0e0e0);
        background: var(--neutral-fill-subtle-rest, #fafafa);
    }
</style>

@code {
    private bool _isLoading = true;
    private bool _isSaving;
    private string? _statusMessage;
    private bool _isError;
    private string? _modalError;
    private DateTime _selectedDate = DateTime.UtcNow.Date;
    private IReadOnlyList<CalendarItemDto> _calendarItems = [];

    // Modal state
    private bool _showEventModal;
    private string _newEventTitle = string.Empty;
    private string _newEventDescription = string.Empty;
    private string _newLocation = string.Empty;
    private DateTime? _newEventDate = DateTime.UtcNow.Date;
    private CalendarEntryTypeEnum _newEntryType = CalendarEntryTypeEnum.General;

    protected override async Task OnInitializedAsync()
    {
        await LoadCalendarAsync();
    }

    private async Task LoadCalendarAsync()
    {
        _isLoading = true;
        try
        {
            var start = DateTime.UtcNow.Date.AddMonths(-2);
            var end = DateTime.UtcNow.Date.AddMonths(4);

            _calendarItems = await CalendarService.GetUserCalendarAsync(TenantContext.TenantId, CurrentUser.UserId, start, end);
        }
        catch (Exception ex)
        {
            _statusMessage = $"Failed to load schedule: {ex.Message}";
            _isError = true;
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void OpenNewEventModal()
    {
        _newEventTitle = string.Empty;
        _newEventDescription = string.Empty;
        _newLocation = string.Empty;
        _newEventDate = _selectedDate;
        _newEntryType = CalendarEntryTypeEnum.General;
        _showEventModal = true;
    }

    private void HandleAddEntryForDate(DateTime date)
    {
        _selectedDate = date;
        _newEventDate = date;
        OpenNewEventModal();
    }

    private void HandleItemClick(CalendarItemDto item)
    {
        _statusMessage = $"Selected: {item.Title} ({item.ItemCategory}) - Due: {item.EndUtc:yyyy-MM-dd}";
        _isError = false;
    }

    private async Task SaveNewEventAsync()
    {
        if (string.IsNullOrWhiteSpace(_newEventTitle))
        {
            _modalError = "Event title is required.";
            return;
        }

        _isSaving = true;
        try
        {
            var tenantId = TenantContext.TenantId;
            Guid.TryParse(CurrentUser.UserId, out var userGuid);
            var eventDate = _newEventDate ?? DateTime.UtcNow.Date;

            var baseDesc = _newEventDescription?.Trim() ?? string.Empty;
            var description = !string.IsNullOrWhiteSpace(_newLocation)
                ? (string.IsNullOrWhiteSpace(baseDesc) ? $"Location: {_newLocation.Trim()}" : $"{baseDesc}\nLocation: {_newLocation.Trim()}")
                : baseDesc;

            var entry = new UserCalendarEntity
            {
                TenantId = tenantId,
                UserId = userGuid,
                Title = _newEventTitle.Trim(),
                Description = description,
                StartDate = eventDate,
                EndDate = eventDate.AddHours(1),
                EntryType = _newEntryType,
                Status = CalendarEntryStatusEnum.Confirmed
            };

            var result = await CalendarService.CreateUserCalendarEntryAsync(entry);
            if (result.IsSuccess)
            {
                _statusMessage = "Personal appointment scheduled.";
                _isError = false;
                _showEventModal = false;
                await LoadCalendarAsync();
            }
            else
            {
                _modalError = result.Error ?? "Failed to save appointment.";
            }
        }
        catch (Exception ex)
        {
            _modalError = $"Error creating event: {ex.Message}";
        }
        finally
        {
            _isSaving = false;
        }
    }
}
