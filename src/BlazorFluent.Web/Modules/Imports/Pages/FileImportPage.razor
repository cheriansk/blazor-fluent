@page "/imports"
@attribute [RequiredClearance(ProjectRoleEnum.Lead)]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("file-upload")]
@rendermode InteractiveServer
@using BlazorFluent.Shared.Attributes
@using BlazorFluent.Components.Common
@using BlazorFluent.Core.Contracts
@using BlazorFluent.Core.Dtos.Imports
@using BlazorFluent.Shared.DataListTypes
@using BlazorFluent.Core.Domain.Tenancy
@using BlazorFluent.Core.Extensions
@using BlazorFluent.Modules.Imports.Components
@using BlazorFluent.Persistence.Context
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms

@inject IImportFileService ImportService
@inject ITenantService TenantService
@inject ITenantContext TenantContext
@inject ICurrentUser CurrentUser
@inject NavigationManager Navigation

<PageTitle>File Import & Processing — BlazorFluent</PageTitle>

<PageHeaderComp Title="File Import & Batch Processing Pipeline"
                Subtitle="Upload single or bulk multi-format payloads, client-side encrypted per-tenant, and processed asynchronously.">
    <Actions>
        <FluentButton Appearance="ButtonAppearance.Outline"
                      IconStart="@(new Icons.Regular.Size16.ArrowClockwise())"
                      OnClick="@RefreshHistoryAsync">
            Refresh Status
        </FluentButton>
    </Actions>
</PageHeaderComp>

<FluentGrid Spacing="3" AdaptiveRendering="true">
    <!-- Left Column: Upload Form Card -->
    <FluentGridItem xs="12" lg="5">
        <FluentCard Class="p-card full-height">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="15">
                <FluentLabel Typo="Typography.H6">Upload Batch Payloads</FluentLabel>
                <FluentLabel Typo="Typography.Body" Class="text-hint">
                    Select single or multiple files. All files in a batch share a unified Batch ID and are client-side encrypted with AES-256-GCM.
                </FluentLabel>

                <!-- Project Selector -->
                @if (_availableProjects.Count > 1)
                {
                    <FluentSelect TOption="ProjectEntity" TValue="string"
                                  Items="@_availableProjects"
                                  OptionText="@(p => p.Name)"
                                  OptionValue="@(p => p.Id.ToString())"
                                  Value="@(_currentProject?.Id.ToString())"
                                  ValueChanged="@OnProjectChanged"
                                  Label="Target Project Workspace"
                                  Class="full-width" />
                }
                else if (_currentProject != null)
                {
                    <FluentTextInput Value="@_currentProject.Name" ReadOnly="true" Label="Target Project Workspace" Class="full-width" />
                }
                else
                {
                    <FluentMessageBar Intent="MessageBarIntent.Warning">
                        No active projects found. Please create a project workspace first.
                    </FluentMessageBar>
                }

                <!-- Multi-File Picker Dropzone -->
                <div class="file-drop-zone">
                    <FluentLabel Typo="Typography.Body" Class="mb-2 d-block">
                        Choose one or more task files (.csv, .txt, .tsv)
                    </FluentLabel>
                    <InputFile OnChange="@HandleFilesSelected" multiple accept=".csv,.txt,.tsv" class="full-width" />
                </div>

                <!-- Pending Files Table -->
                @if (_pendingFiles.Count > 0)
                {
                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center">
                        <FluentLabel Typo="Typography.Subtitle">Queued Files (@_pendingFiles.Count)</FluentLabel>
                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                      IconStart="@(new Icons.Regular.Size16.Dismiss())"
                                      OnClick="@ClearPendingFiles">
                            Clear All
                        </FluentButton>
                    </FluentStack>

                    <div class="import-files-list">
                        <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                            @foreach (var item in _pendingFiles)
                            {
                                <div class="import-file-item" @key="item.Id">
                                    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Class="mb-2">
                                        <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6" VerticalAlignment="VerticalAlignment.Center">
                                            <FluentIcon Value="@(new Icons.Regular.Size16.Document())" />
                                            <div>
                                                <FluentLabel Typo="Typography.Body" Class="font-weight-600">@item.FileName</FluentLabel>
                                                <FluentLabel Typo="Typography.Caption" Class="text-hint">@FormatBytes(item.Size)</FluentLabel>
                                            </div>
                                        </FluentStack>
                                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                                      IconStart="@(new Icons.Regular.Size16.Delete())"
                                                      OnClick="@(() => RemovePendingFile(item.Id))"
                                                      Title="Remove from batch" />
                                    </FluentStack>

                                    <!-- Per-file Combined Format & Target Type Selector -->
                                    <FluentSelect TOption="DataListItem<ImportFileTypeEnum>" TValue="string"
                                                  Items="@_fileTypeOptions"
                                                  OptionText="@(i => i.DisplayName)"
                                                  OptionValue="@(i => i.Code)"
                                                  Value="@item.SelectedFileType.ToString()"
                                                  ValueChanged="@((string? v) => OnItemFileTypeChanged(item, v))"
                                                  Label="Payload Specification"
                                                  Class="full-width" />
                                </div>
                            }
                        </FluentStack>
                    </div>
                }

                @if (!string.IsNullOrWhiteSpace(_statusMessage))
                {
                    <FluentMessageBar Intent="@_messageIntent">
                        @_statusMessage
                    </FluentMessageBar>
                }

                <!-- Submit Button -->
                <FluentButton Appearance="ButtonAppearance.Primary"
                              IconStart="@(new Icons.Regular.Size16.ArrowSync())"
                              Disabled="@(_isUploading || _pendingFiles.Count == 0 || _currentProject == null)"
                              Loading="@_isUploading"
                              Class="full-width mt-2"
                              OnClick="@UploadBatchAsync">
                    @(_isUploading ? "Encrypting & Storing Batch..." : $"Upload & Ingest Batch ({_pendingFiles.Count} files)")
                </FluentButton>
            </FluentStack>
        </FluentCard>
    </FluentGridItem>

    <!-- Right Column: Staging History Grid -->
    <FluentGridItem xs="12" lg="7">
        <FluentCard Class="p-card full-height">
            <FluentStack Orientation="Orientation.Vertical" VerticalGap="15">
                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween">
                    <FluentLabel Typo="Typography.H6">Payload Staging History</FluentLabel>
                    <FluentBadge Appearance="@BadgeAppearance.Filled">@_history.Count file(s)</FluentBadge>
                </FluentStack>

                @if (_isLoadingHistory)
                {
                    <FluentSpinner Class="import-spinner" />
                }
                else if (_history.Count == 0)
                {
                    <EmptyStateComp Title="No Files Ingested"
                                    Description="Uploaded payloads and their background staging progress will appear here."
                                    IconValue="@(new Icons.Regular.Size32.DocumentSearch())" />
                }
                else
                {
                    <div class="overflow-x-auto">
                        <FluentDataGrid Items="@_history.AsQueryable()"
                                        ResizableColumns="true"
                                        TGridItem="ImportFileSummaryDto"
                                        Class="full-width">
                            <TemplateColumn Title="Batch ID" Width="100px">
                                <span title="@context.ImportId.ToString()" class="mono-code">
                                    @context.ImportId.ToString()[..8]...
                                </span>
                            </TemplateColumn>
                            <PropertyColumn Property="@(f => f.OriginalFileName)" Title="File Name" Width="170px" />
                            <TemplateColumn Title="Format Specification" Width="140px">
                                <FluentBadge Appearance="@BadgeAppearance.Outline">@context.FileType</FluentBadge>
                            </TemplateColumn>
                            <TemplateColumn Title="Pipeline Stage" Width="100px">
                                <FluentBadge Appearance="@BadgeAppearance.Filled" Color="BadgeColor.Subtle">
                                    @(string.IsNullOrWhiteSpace(context.StepStage) ? "Uploaded" : context.StepStage)
                                </FluentBadge>
                            </TemplateColumn>
                            <TemplateColumn Title="Status" Width="140px">
                                @switch (context.Status)
                                {
                                    case ImportStatusEnum.Uploaded:
                                        <FluentBadge Color="BadgeColor.Informative">Uploaded</FluentBadge>
                                        break;
                                    case ImportStatusEnum.Validating:
                                        <FluentBadge Color="BadgeColor.Brand">Validating</FluentBadge>
                                        break;
                                    case ImportStatusEnum.ValidationSuccess:
                                        <FluentBadge Color="BadgeColor.Brand">Validated</FluentBadge>
                                        break;
                                    case ImportStatusEnum.ValidationFailed:
                                        <FluentBadge Color="BadgeColor.Severe">Validation Failed</FluentBadge>
                                        break;
                                    case ImportStatusEnum.Staging:
                                        <FluentBadge Color="BadgeColor.Brand">Staging</FluentBadge>
                                        break;
                                    case ImportStatusEnum.StagingSuccess:
                                        <FluentBadge Color="BadgeColor.Brand">Staged</FluentBadge>
                                        break;
                                    case ImportStatusEnum.StagingFailed:
                                        <FluentBadge Color="BadgeColor.Severe">Staging Failed</FluentBadge>
                                        break;
                                    case ImportStatusEnum.Processing:
                                        <FluentBadge Color="BadgeColor.Brand">Processing</FluentBadge>
                                        break;
                                    case ImportStatusEnum.Completed:
                                        <FluentBadge Color="BadgeColor.Success">Completed</FluentBadge>
                                        break;
                                    case ImportStatusEnum.ProcessingFailed:
                                        <FluentBadge Color="BadgeColor.Severe">Processing Failed</FluentBadge>
                                        break;
                                    default:
                                        <FluentBadge>@context.Status</FluentBadge>
                                        break;
                                }
                            </TemplateColumn>
                            <TemplateColumn Title="Metrics" Width="100px">
                                <span>@context.ValidRowsCount / @context.TotalRowsCount ok</span>
                            </TemplateColumn>
                            <TemplateColumn Title="Size" Width="80px">
                                <span>@FormatBytes(context.FileSizeBytes)</span>
                            </TemplateColumn>
                            <TemplateColumn Title="Actions" Width="130px">
                                <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="6">
                                    @if (context.Status is ImportStatusEnum.ValidationFailed or ImportStatusEnum.StagingFailed or ImportStatusEnum.ProcessingFailed)
                                    {
                                        <FluentButton Appearance="ButtonAppearance.Subtle"
                                                      IconStart="@(new Icons.Regular.Size16.ErrorCircle())"
                                                      Class="text-danger"
                                                      OnClick="@(() => ViewDiagnosticsAsync(context.Id))">
                                            Errors
                                        </FluentButton>
                                    }
                                    <FluentButton Appearance="ButtonAppearance.Subtle"
                                                  IconStart="@(new Icons.Regular.Size16.Delete())"
                                                  OnClick="@(() => PromptDelete(context.Id))" />
                                </FluentStack>
                            </TemplateColumn>
                        </FluentDataGrid>
                    </div>
                }
            </FluentStack>
        </FluentCard>
    </FluentGridItem>
</FluentGrid>

<!-- Diagnostics Modal -->
<ImportErrorsModal @ref="_errorsModal" />

<!-- Confirmation Modal -->
<ConfirmDialogModal @ref="_confirmDialog"
                    Title="Delete Import Record"
                    Message="Are you sure you want to delete this import record and its staged items?"
                    ConfirmLabel="Delete"
                    OnConfirmed="@DeleteConfirmedAsync" />

@code {
    private ImportErrorsModal? _errorsModal;
    private ConfirmDialogModal? _confirmDialog;

    private List<ProjectEntity> _availableProjects = new();
    private ProjectEntity? _currentProject;

    private IReadOnlyList<DataListItem<ImportFileTypeEnum>> _fileTypeOptions = Array.Empty<DataListItem<ImportFileTypeEnum>>();
    private readonly List<PendingUploadItem> _pendingFiles = new();

    private bool _isUploading;
    private bool _isLoadingHistory = true;
    private string? _statusMessage;
    private MessageBarIntent _messageIntent = MessageBarIntent.Info;

    private List<ImportFileSummaryDto> _history = new();
    private Guid _pendingDeleteId;

    private sealed class PendingUploadItem
    {
        public Guid Id { get; } = Guid.NewGuid();
        public IBrowserFile File { get; set; } = default!;
        public string FileName => File.Name;
        public long Size => File.Size;
        public ImportFileTypeEnum SelectedFileType { get; set; } = ImportFileTypeEnum.TaskExcel;
    }

    protected override async Task OnInitializedAsync()
    {
        _fileTypeOptions = DataListExtensions.GetDataListItems<ImportFileTypeEnum>();

        await LoadProjectsAsync();
        await RefreshHistoryAsync();
    }

    private async Task LoadProjectsAsync()
    {
        _availableProjects = (await TenantService.GetTenantProjectsAsync(TenantContext.TenantSlug))

            .Where(p => p.IsActive && !p.IsDeleted)
            .OrderBy(p => p.Name)
            .ToList();

        if (_availableProjects.Count > 0)
        {
            _currentProject = _availableProjects[0];
        }
    }

    private async Task OnProjectChanged(string? newProjectIdStr)
    {
        _currentProject = Guid.TryParse(newProjectIdStr, out var projId)
            ? _availableProjects.FirstOrDefault(p => p.Id == projId)
            : null;
        await RefreshHistoryAsync();
    }

    private void HandleFilesSelected(InputFileChangeEventArgs e)
    {
        _statusMessage = null;
        var selected = e.GetMultipleFiles(50);
        foreach (var file in selected)
        {
            var ext = Path.GetExtension(file.Name).ToLowerInvariant();
            var detectedType = ext switch
            {
                ".xlsx" or ".xls" => ImportFileTypeEnum.TaskExcel,
                ".json" => ImportFileTypeEnum.TaskJson,
                ".xml" => ImportFileTypeEnum.TaskXml,
                ".csv" or ".txt" or ".tsv" => ImportFileTypeEnum.TaskCsv,
                _ => ImportFileTypeEnum.TaskExcel
            };

            _pendingFiles.Add(new PendingUploadItem
            {
                File = file,
                SelectedFileType = detectedType
            });
        }
    }

    private void OnItemFileTypeChanged(PendingUploadItem item, string? newCode)
    {
        if (newCode.TryToEnum<ImportFileTypeEnum>(out var fileType))
        {
            item.SelectedFileType = fileType;
        }
    }

    private void RemovePendingFile(Guid id)
    {
        _pendingFiles.RemoveAll(f => f.Id == id);
    }

    private void ClearPendingFiles()
    {
        _pendingFiles.Clear();
    }

    private async Task UploadBatchAsync()
    {
        if (_pendingFiles.Count == 0 || _currentProject == null) return;

        _isUploading = true;
        _statusMessage = null;

        try
        {
            const long maxFileSize = 52_428_800; // 50MB per file
            var fileItems = new List<UploadBatchFileItem>(_pendingFiles.Count);

            foreach (var pending in _pendingFiles)
            {
                var memoryStream = new MemoryStream();
                using var readStream = pending.File.OpenReadStream(maxFileSize);
                await readStream.CopyToAsync(memoryStream);
                memoryStream.Position = 0;

                fileItems.Add(new UploadBatchFileItem
                {
                    FileType = pending.SelectedFileType,
                    FileName = pending.FileName,
                    ContentType = pending.File.ContentType ?? "application/octet-stream",
                    FileSizeBytes = pending.Size,
                    ContentStream = memoryStream
                });
            }

            var request = new UploadBatchRequest
            {
                ProjectId = _currentProject.Id,
                Files = fileItems
            };

            var result = await ImportService.UploadBatchAndQueueAsync(request);
            if (result.IsSuccess)
            {
                _messageIntent = MessageBarIntent.Success;
                _statusMessage = $"Batch {result.Value:N} uploaded successfully ({fileItems.Count} file(s)). Pipeline queued for background validation, staging, and domain processing.";
                _pendingFiles.Clear();
                await RefreshHistoryAsync();
            }
            else
            {
                _messageIntent = MessageBarIntent.Error;
                _statusMessage = result.Error;
            }
        }
        catch (Exception ex)
        {
            _messageIntent = MessageBarIntent.Error;
            _statusMessage = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _isUploading = false;
        }
    }

    private async Task RefreshHistoryAsync()
    {
        if (_currentProject == null)
        {
            _history.Clear();
            _isLoadingHistory = false;
            return;
        }

        _isLoadingHistory = true;
        try
        {
            _history = (await ImportService.GetImportHistoryAsync(_currentProject.Id)).ToList();
        }
        finally
        {
            _isLoadingHistory = false;
        }
    }

    private async Task ViewDiagnosticsAsync(Guid importFileId)
    {
        if (_currentProject is null) return;
        var details = await ImportService.GetImportFileDetailsAsync(_currentProject.Id, importFileId);
        if (details != null && _errorsModal != null)
        {
            _errorsModal.Show(details);
        }
    }

    private void PromptDelete(Guid importFileId)
    {
        _pendingDeleteId = importFileId;
        _confirmDialog?.Show();
    }

    private async Task DeleteConfirmedAsync()
    {
        if (_pendingDeleteId != Guid.Empty && _currentProject is not null)
        {
            await ImportService.DeleteImportFileAsync(_currentProject.Id, _pendingDeleteId);
            _pendingDeleteId = Guid.Empty;
            await RefreshHistoryAsync();
        }
    }

    private static string FormatBytes(long bytes)
    {
        string[] suffixes = { "B", "KB", "MB", "GB" };
        int counter = 0;
        decimal number = bytes;
        while (Math.Round(number / 1024) >= 1)
        {
            number /= 1024;
            counter++;
        }
        return $"{number:n1} {suffixes[counter]}";
    }
}
