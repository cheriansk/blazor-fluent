@using BlazorFluent.Core.Abstractions.Imports
@using BlazorFluent.Core.Dtos.Imports

<FluentDialog @ref="_dialog"
              Modal="true"
              Style="--dialog-width: 850px; --dialog-height: 550px;">
    <FluentDialogBody Style="max-height: 400px; overflow-y: auto;">
        <TitleTemplate>
            <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="10" Style="align-items: center;">
                <FluentIcon Value="@(new Icons.Filled.Size24.ErrorCircle())" Color="Color.Error" />
                <FluentLabel Typo="Typography.H6">Validation Diagnostics: @FileDetails?.OriginalFileName</FluentLabel>
            </FluentStack>
        </TitleTemplate>
        <ChildContent>
            @if (FileDetails != null)
            {
                <FluentStack Orientation="Orientation.Vertical" VerticalGap="10">
                    <FluentMessageBar Intent="MessageBarIntent.Error">
                        Strict fail-closed policy: @FileDetails.ValidationErrors.Count error(s) detected. 0 records staged.
                    </FluentMessageBar>

                    <FluentDataGrid Items="@FileDetails.ValidationErrors.AsQueryable()"
                                    ResizableColumns="true"
                                    TGridItem="FileValidationError"
                                    Style="width: 100%;">
                        <PropertyColumn Property="@(e => e.SheetName)" Title="Sheet / Section" Width="130px" />
                        <PropertyColumn Property="@(e => e.RowIndex)" Title="Row #" Width="80px" />
                        <PropertyColumn Property="@(e => e.ColumnName)" Title="Column / Field" Width="140px" />
                        <PropertyColumn Property="@(e => e.ErrorMessage)" Title="Validation Message" />
                        <PropertyColumn Property="@(e => e.AttemptedValue)" Title="Attempted Value" Width="140px" />
                    </FluentDataGrid>
                </FluentStack>
            }
            else
            {
                <FluentLabel Typo="Typography.Body">No diagnostic errors recorded.</FluentLabel>
            }
        </ChildContent>
        <ActionTemplate>
            <FluentButton Appearance="ButtonAppearance.Primary" OnClick="@CloseAsync">Close</FluentButton>
        </ActionTemplate>
    </FluentDialogBody>
</FluentDialog>

@code {
    private FluentDialog? _dialog;

    [Parameter] public ImportFileDetailsDto? FileDetails { get; set; }

    public async Task ShowAsync(ImportFileDetailsDto details)
    {
        FileDetails = details;
        if (_dialog is not null)
        {
            await _dialog.ShowAsync();
        }
        StateHasChanged();
    }

    public void Show(ImportFileDetailsDto details)
    {
        _ = ShowAsync(details);
    }

    private async Task CloseAsync()
    {
        if (_dialog is not null)
        {
            await _dialog.HideAsync();
        }
    }
}
