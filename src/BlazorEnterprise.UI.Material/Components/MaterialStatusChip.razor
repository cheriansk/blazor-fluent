@namespace BlazorEnterprise.UI.Material.Components
@using Microsoft.FluentUI.AspNetCore.Components

<span class="mat-chip @GetColorClass() @Class" style="@Style">
    @if (Icon is not null)
    {
        <FluentIcon Value="@Icon" Width="14px" />
    }
    @Text
</span>

@code {
    public enum ChipVariant
    {
        Primary,
        Success,
        Warning,
        Error,
        Info,
        Neutral
    }

    [Parameter, EditorRequired] public string Text { get; set; } = string.Empty;
    [Parameter] public ChipVariant Variant { get; set; } = ChipVariant.Primary;
    [Parameter] public Icon? Icon { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string Style { get; set; } = string.Empty;

    private string GetColorClass() => Variant switch
    {
        ChipVariant.Success => "mat-chip-success",
        ChipVariant.Warning => "mat-chip-warning",
        ChipVariant.Error => "mat-chip-error",
        ChipVariant.Info => "mat-chip-info",
        ChipVariant.Neutral => "mat-chip-neutral",
        _ => "mat-chip-primary"
    };
}
