@namespace BlazorEnterprise.Shared.UI.Components

@if (_isOpen)
{
    <div class="csk-dialog-backdrop"
         @onclick="HandleBackdropClick">
        <div class="csk-dialog-surface @Class" role="dialog" aria-modal="@(Modal ? "true" : "false")"
             @onclick:stopPropagation="true"
             @attributes="AdditionalAttributes">
            <CascadingValue Value="this" IsFixed="true">
                @if (TitleTemplate is not null)
                {
                    <div class="csk-dialog-title">
                        @TitleTemplate
                    </div>
                }

                @ChildContent

                @if (ActionTemplate is not null)
                {
                    <div class="csk-dialog-actions">
                        @ActionTemplate
                    </div>
                }
            </CascadingValue>
        </div>
    </div>
}
