@namespace BlazorEnterprise.Shared.UI.Components

<div class="csk-section-header @Class">
    <div class="csk-section-header-title-group">
        <h2 class="csk-section-title">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <span class="csk-section-icon">
                    <CskIcon Icon="@Icon" Class="csk-section-icon-svg" />
                </span>
            }
            <span>@Title</span>
        </h2>
        @if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <div class="csk-section-subtitle">@Subtitle</div>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="csk-section-actions">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string Subtitle { get; set; } = string.Empty;
    [Parameter] public string? Icon { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
}
