@namespace BlazorEnterprise.Shared.UI.Components

<label class="csk-switch-wrapper @(Disabled ? "csk-switch-disabled" : "") @Class" @attributes="AdditionalAttributes">
    <input type="checkbox"
           class="csk-switch-input"
           checked="@Value"
           disabled="@Disabled"
           @onchange="HandleChangeAsync" />
    <span class="csk-switch-track">
        <span class="csk-switch-thumb"></span>
    </span>
    @if (!string.IsNullOrEmpty(Label))
    {
        <span class="csk-switch-label">@Label</span>
    }
    @if (ChildContent != null)
    {
        <span class="csk-switch-label">@ChildContent</span>
    }
</label>
