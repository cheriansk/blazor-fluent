<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorEnterprise.Shared.UI</RootNamespace>
    
    <!-- NuGet Package Metadata for Enterprise Distribution -->
    <PackageId>BlazorEnterprise.Shared.UI</PackageId>
    <Version>1.0.0</Version>
    <Authors>BlazorEnterprise Architecture Team</Authors>
    <Company>BlazorEnterprise</Company>
    <Product>BlazorEnterprise Shared UI &amp; Component Library</Product>
    <Description>Enterprise-grade shared Razor Class Library (RCL) housing native Material Design 3 components, icons, and reusable wizard framework with 100% strict CSP compliance.</Description>
    <PackageTags>blazor;material;material3;enterprise;shared;ui;components;wizard;zero-trust;csp</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <WarningsAsErrors>CS0618</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorEnterprise.Shared\BlazorEnterprise.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="BlazorEnterprise.Shared.DataListTypes.TaskStatus" />
  </ItemGroup>

</Project>
