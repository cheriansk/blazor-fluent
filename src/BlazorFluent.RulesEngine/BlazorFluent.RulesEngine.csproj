  <ItemGroup>
    <PackageReference Include="DocumentFormat.OpenXml" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorFluent.Shared\BlazorFluent.Shared.csproj" />
  </ItemGroup>

</Project>
