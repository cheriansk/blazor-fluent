<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>BlazorFluent.RulesEngine</RootNamespace>
    <AssemblyName>BlazorFluent.RulesEngine</AssemblyName>
    <Description>Proprietary calculation algorithms, OpenXML/CSV parsing engine, DAG cycle detection, and rollup formulas. 100% in-memory CPU execution with zero database dependencies.</Description>
