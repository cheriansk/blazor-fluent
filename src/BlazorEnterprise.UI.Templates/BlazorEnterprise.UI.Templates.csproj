<Project Sdk="Microsoft.NET.Sdk.Razor">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    
    <!-- NuGet Package Metadata -->
    <PackageId>BlazorEnterprise.UI.Templates</PackageId>
    <Version>1.0.0</Version>
    <Authors>BlazorEnterprise Enterprise Architecture Team</Authors>
    <Company>BlazorEnterprise</Company>
    <Product>BlazorEnterprise UI Templates &amp; Wizard Framework</Product>
    <Description>Enterprise-grade, decoupled Blazor UI templates and generic multi-step Wizard framework built natively on Microsoft Fluent UI Blazor V5.</Description>
    <PackageTags>blazor;fluentui;fluent;wizard;enterprise;templates;components;v5</PackageTags>
    <GeneratePackageOnBuild>false</GeneratePackageOnBuild>
    <WarningsAsErrors>CS0618</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.Web" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorEnterprise.Shared\BlazorEnterprise.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="BlazorEnterprise.Shared.DataListTypes.TaskStatus" />
  </ItemGroup>

</Project>
