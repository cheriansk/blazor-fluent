{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=blazorfluent_db;Username=postgres;Password=__SET_VIA_ENV_OR_USER_SECRETS__;Pooling=true;Minimum Pool Size=5;Maximum Pool Size=50;Connection Idle Lifetime=300;",
    "Redis": ""
  },
  "Caching": {
    "DefaultExpirationMinutes": 60,
    "LocalCacheExpirationMinutes": 15
  },
  "Jobs": {
    "EnableHostedListener": true,
    "EnableScheduler": true,
    "CronServiceAccountEmail": "daemon-worker@local.system",
    "Schedules": {
      "CatalogSyncJob": "*/15 * * * *",
      "AuditPurgeJob": "0 2 * * *",
      "DailyTaskSummaryJob": "0 18 * * *",
      "TaskCadenceAlertJob": "0 8 * * *"
    }
  },
  "Audit": {
    "RetentionDays": 365
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "BlazorFluent": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "Security": {
    "IntegritySecret": "__SET_VIA_KEYVAULT_OR_USER_SECRETS__",
    "MasterEncryptionKey": "__SET_VIA_KEYVAULT_OR_USER_SECRETS__",
    "SystemBootstrapEmail": "daemon-worker@local.system"
  },
  "Engine": {
    "Mode": "Remote",
    "ApiBaseUrl": "https://localhost:7150"
  }
}
