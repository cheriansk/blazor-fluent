<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorFluent.Worker</RootNamespace>
    <AssemblyName>BlazorFluent.Worker</AssemblyName>
    <WarningsAsErrors>CS0108</WarningsAsErrors>
    <UserSecretsId>dotnet-BlazorFluent.Worker-88339281-2291-419b-bc39-8ddd2ea18833</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorFluent.Core\BlazorFluent.Core.csproj" />
    <ProjectReference Include="..\BlazorFluent.Shared\BlazorFluent.Shared.csproj" />
    <ProjectReference Include="..\BlazorFluent.Persistence\BlazorFluent.Persistence.csproj" />
    <ProjectReference Include="..\BlazorFluent.Infrastructure\BlazorFluent.Infrastructure.csproj" />
    <ProjectReference Include="..\BlazorFluent.Jobs\BlazorFluent.Jobs.csproj" />
    <ProjectReference Include="..\BlazorFluent.ServiceDefaults\BlazorFluent.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="BlazorFluent.Shared.DataListTypes.TaskStatus" />
  </ItemGroup>

</Project>
