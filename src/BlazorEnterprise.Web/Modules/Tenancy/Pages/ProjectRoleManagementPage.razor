@page "/tenancy/project-roles"

@attribute [RequiredClearance(ProjectRoleEnum.Admin)]

@rendermode InteractiveServer

@using BlazorEnterprise.Shared.Attributes

@using BlazorEnterprise.Core.Contracts

@using BlazorEnterprise.Shared.DataListTypes

@using BlazorEnterprise.Core.Domain.Identity

@using BlazorEnterprise.Core.Domain.Tenancy

@using BlazorEnterprise.Infrastructure.Security



@using Microsoft.AspNetCore.Authorization



@using Microsoft.FluentUI.AspNetCore.Components

@inject IProjectAuthorizationService ProjectAuth

@inject ITenantContext TenantContext

@inject ITenantService TenantService

@inject ICurrentUser CurrentUser

@inject IImpersonationService ImpersonationService

@inject CurrentUserAuthenticationStateProvider AuthStateProvider

@inject NavigationManager NavigationManager



<PageTitle>Project Access Management</PageTitle>



<FluentStack Orientation="Orientation.Vertical" VerticalGap="20">

    <FluentMessageBar Intent="MessageBarIntent.Info" Class="mb-1">

        <strong>Moved to Settings:</strong> Project Roles management has been consolidated into the <FluentLink Href="/settings">Settings &gt; Projects</FluentLink> tab.

    </FluentMessageBar>



    <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Class="full-width">

        <div>

            <FluentLabel Typo="Typography.H3">Project Role & Access Management</FluentLabel>

            <FluentLabel Typo="Typography.Body">

                Assign and manage user roles (Admin, Dev, QA, ReadOnly) per project in tenant <strong>@TenantContext.TenantName</strong>.

            </FluentLabel>

        </div>

        <FluentButton Appearance="ButtonAppearance.Primary" IconStart="@(new Icons.Regular.Size16.PersonAdd())" OnClick="@OpenAddModal">

            Assign User

        </FluentButton>

    </FluentStack>



    @if (!string.IsNullOrWhiteSpace(_statusMessage))

    {

        <FluentMessageBar Intent="@(_isError ? MessageBarIntent.Error : MessageBarIntent.Success)" AllowDismiss="true" OnDismiss="@(() => _statusMessage = null)">

            @_statusMessage

        </FluentMessageBar>

    }



    <!-- Project Selection Bar -->

    <FluentCard>

        <FluentStack Orientation="Orientation.Horizontal" VerticalAlignment="VerticalAlignment.Center" HorizontalGap="16">

            <FluentLabel Typo="Typography.H5">Active Project:</FluentLabel>

            <FluentSelect TOption="ProjectEntity"

                          TValue="string"

                          Items="@_projects"

                          OptionText="@(p => p.Name)"

                          OptionValue="@(p => p.Id.ToString())"

                          Value="@_selectedProjectId"

                          ValueChanged="@OnProjectChanged"

                          Class="min-w-280" />



            @if (!string.IsNullOrWhiteSpace(_selectedProjectId))

            {

                <FluentBadge Appearance="BadgeAppearance.Tint">

                    ID: @_selectedProjectId

                </FluentBadge>

            }

        </FluentStack>

    </FluentCard>



    <!-- Role Assignment Form (Collapsible Card) -->

    @if (_showAssignModal)

    {

        <FluentCard Class="card-accent-border">

            <FluentLabel Typo="Typography.H5" Class="mb-3">

                @(_isEditing ? "Update Project Role" : "Assign Tenant User to Project")

            </FluentLabel>



            @if (!_isEditing && _tenantUsers.Count == 0)

            {

                <FluentMessageBar Intent="MessageBarIntent.Warning" Class="mb-3">

                    No active users are provisioned for tenant '@TenantContext.TenantName'. Please add users to this tenant first in <FluentLink Href="/tenants">Tenant Management</FluentLink>.

                </FluentMessageBar>

                <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@CancelModal">

                    Close

                </FluentButton>

            }

            else

            {

                <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">

                    @if (!_isEditing)

                    {

                        <FluentSelect TOption="UserEntity"

                                      TValue="string"

                                      Items="@_tenantUsers"

                                      OptionText="@(u => $"{u.FullName} ({u.Email}) — [{(u.UserType == UserTypeEnum.CompanyUser ? "Internal Staff" : "External Client")}]")"

                                      OptionValue="@(u => u.Id.ToString())"

                                      Value="@_selectedTenantUserId"

                                      ValueChanged="@OnTenantUserSelected"

                                      Label="Select Tenant User"

                                      Required="true"

                                      Class="full-width" />



                        @if (!string.IsNullOrWhiteSpace(_formEmail))

                        {

                            <div class="font-size-sm text-hint d-flex align-center gap-4 p-2">

                                <span>Member: <strong>@_formUserName</strong></span>

                                <span>Email: <code>@_formEmail</code></span>

                                <span>Type:

                                    @if (_formUserType == UserTypeEnum.CompanyUser)

                                    {

                                        <FluentBadge Appearance="BadgeAppearance.Filled">Internal Staff</FluentBadge>

                                    }

                                    else

                                    {

                                        <FluentBadge Appearance="BadgeAppearance.Tint">External Client</FluentBadge>

                                    }

                                </span>

                            </div>

                        }

                    }

                    else

                    {

                        <div class="font-size-sm text-hint p-2">

                            Updating Role for: <strong>@_formUserName</strong> (<code>@_formEmail</code>)

                        </div>

                    }



                    <div class="half-width">

                        <FluentLabel Typo="Typography.Body" Class="mb-1">Project Role</FluentLabel>

                        <FluentSelect TOption="string" TValue="string"

                                      Value="@_formRole.ToString()"

                                      ValueChanged="@(val => _formRole = val.ToEnum(ProjectRoleEnum.ReadOnly))"

                                      Class="full-width">

                            <FluentOption Value="@nameof(ProjectRoleEnum.ReadOnly)">👁️ ReadOnly</FluentOption>

                            <FluentOption Value="@nameof(ProjectRoleEnum.Contribute)">💻 Contribute</FluentOption>

                            <FluentOption Value="@nameof(ProjectRoleEnum.Lead)">⭐ Lead</FluentOption>

                            <FluentOption Value="@nameof(ProjectRoleEnum.ElevatedLead)">🛡️ ElevatedLead</FluentOption>

                            <FluentOption Value="@nameof(ProjectRoleEnum.PMO)">📊 PMO</FluentOption>

                            <FluentOption Value="@nameof(ProjectRoleEnum.Admin)">👑 Admin</FluentOption>

                        </FluentSelect>

                    </div>



                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="12" Class="mt-3">

                        <FluentButton Appearance="ButtonAppearance.Primary"

                                      Disabled="@(string.IsNullOrWhiteSpace(_formUserId))"

                                      OnClick="@SaveAssignmentAsync">

                            Save Assignment

                        </FluentButton>

                        <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@CancelModal">

                            Cancel

                        </FluentButton>

                    </FluentStack>

                </FluentStack>

            }

        </FluentCard>

    }



    <!-- Impersonation Form (Collapsible Card) -->

    @if (_showImpersonateModal)

    {

        <FluentCard Class="card-warning-border">

            <FluentLabel Typo="Typography.H5" Class="mb-3 text-dark-gray">

                ⚠️ Operator Impersonation (SuperAdmin Troubleshooting)

            </FluentLabel>



            <FluentLabel Typo="Typography.Body" Class="mb-3">

                You are about to impersonate <strong>@_impersonateTargetName</strong> (<code>@_impersonateTargetEmail</code>) in tenant <strong>@TenantContext.TenantName</strong>.

                This allows you to experience the application under this user's exact permissions.

            </FluentLabel>



            <FluentStack Orientation="Orientation.Vertical" VerticalGap="12">

                <FluentTextInput Label="Justification / Incident Ticket (Required)"

                                 @bind-Value="_impersonateReason"

                                 Placeholder="e.g. INC-4029: User reports cannot view analytics"

                                 Required="true"

                                 Class="full-width" />



                <div class="font-size-sm text-hint">

                    ⏳ Max Duration: 60 minutes. An exit button will be pinned to the top of all pages.

                </div>



                <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.Right" HorizontalGap="12">

                    <FluentButton Appearance="ButtonAppearance.Subtle" OnClick="@(() => _showImpersonateModal = false)">

                        Cancel

                    </FluentButton>

                    <FluentButton Appearance="ButtonAppearance.Primary"

                                  Class="impersonation-exit-btn"

                                  Disabled="@(string.IsNullOrWhiteSpace(_impersonateReason))"

                                  OnClick="StartImpersonationAsync">

                        Start Impersonating

                    </FluentButton>

                </FluentStack>

            </FluentStack>

        </FluentCard>

    }



    <!-- Members Grid -->

    <FluentCard>

        <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Class="mb-3">

            <FluentLabel Typo="Typography.H5">

                Assigned Team Members (@_members.Count)

            </FluentLabel>

            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size16.ArrowClockwise())" OnClick="@LoadMembersAsync">

                Refresh

            </FluentButton>

        </FluentStack>



        @if (_isLoading)

        {

            <FluentSpinner Class="m-auto" />

        }

        else if (_members.Count == 0)

        {

            <FluentMessageBar Intent="MessageBarIntent.Info">

                No users assigned to this project yet. Click &ldquo;Assign User&rdquo; above to grant access.

            </FluentMessageBar>

        }

        else

        {

            <FluentStack Orientation="Orientation.Horizontal" HorizontalAlignment="HorizontalAlignment.SpaceBetween" VerticalAlignment="VerticalAlignment.Center" Class="mb-2">

                <FluentTextInput Placeholder="Filter members by name, email, or role..."

                              @bind-Value="_memberFilterText"

                              @bind-Value:after="StateHasChanged"

                              Class="w-320" >

                    <StartTemplate>    

                        <FluentIcon Value="@(new Icons.Regular.Size16.Search())" />

                    </StartTemplate>

                </FluentTextInput>

                <span class="font-size-sm text-hint">

                    Showing @FilteredMembers.Count() of @_members.Count members

                </span>

            </FluentStack>



            <FluentDataGrid Items="@FilteredMembers" ResizableColumns="true" GridTemplateColumns="1.5fr 1.5fr 120px 120px 180px">

                <TemplateColumn Title="Member" SortBy="@(GridSort<ProjectUserRoleEntity>.ByAscending(m => m.UserName))">

                    <div>

                        <strong>@context.UserName</strong>

                        <div class="font-size-sm text-hint">@context.UserId</div>

                    </div>

                </TemplateColumn>

                <PropertyColumn Property="@(m => m.UserEmail)" Title="Email" Sortable="true" />

                <TemplateColumn Title="Type" SortBy="@(GridSort<ProjectUserRoleEntity>.ByAscending(m => m.UserType))">

                    @if (context.UserType == UserTypeEnum.CompanyUser)

                    {

                        <FluentBadge Appearance="BadgeAppearance.Filled">Company</FluentBadge>

                    }

                    else

                    {

                        <FluentBadge Appearance="BadgeAppearance.Tint">Client</FluentBadge>

                    }

                </TemplateColumn>

                <TemplateColumn Title="Role" SortBy="@(GridSort<ProjectUserRoleEntity>.ByAscending(m => m.Role))">

                    @switch (context.Role)

                    {

                        case ProjectRoleEnum.Admin:

                            <FluentBadge Appearance="BadgeAppearance.Filled">👑 Admin</FluentBadge>

                            break;

                        case ProjectRoleEnum.PMO:

                            <FluentBadge Appearance="BadgeAppearance.Tint">📊 PMO</FluentBadge>

                            break;

                        case ProjectRoleEnum.ElevatedLead:

                            <FluentBadge Appearance="BadgeAppearance.Tint">🛡️ ElevatedLead</FluentBadge>

                            break;

                        case ProjectRoleEnum.Lead:

                            <FluentBadge Appearance="BadgeAppearance.Tint">⭐ Lead</FluentBadge>

                            break;

                        case ProjectRoleEnum.Contribute:

                            <FluentBadge Appearance="BadgeAppearance.Tint">💻 Contribute</FluentBadge>

                            break;

                        case ProjectRoleEnum.ReadOnly:

                            <FluentBadge Appearance="BadgeAppearance.Tint">👁️ ReadOnly</FluentBadge>

                            break;

                        default:

                            <FluentBadge Appearance="BadgeAppearance.Tint">@context.Role.ToString()</FluentBadge>

                            break;

                    }

                </TemplateColumn>

                <TemplateColumn Title="Actions">

                    <FluentStack Orientation="Orientation.Horizontal" HorizontalGap="8">

                        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size16.Edit())" OnClick="@(() => EditAssignment(context))">

                            Edit

                        </FluentButton>

                        <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size16.Delete())" OnClick="@(() => RevokeAssignmentAsync(context.UserId))">

                            Revoke

                        </FluentButton>

                        <EntityHistoryButton EntityName="ProjectUserRoleEntity" EntityId="@context.Id.ToString()" Tooltip="View project role assignment history" />

                        @if (CurrentUser.IsRootAdmin && context.UserId != CurrentUser.UserId)

                        {

                            <FluentButton Appearance="ButtonAppearance.Subtle" IconStart="@(new Icons.Regular.Size16.PersonCircle())" OnClick="@(() => PromptImpersonation(context))">

                                Impersonate

                            </FluentButton>

                        }

                    </FluentStack>

                </TemplateColumn>

            </FluentDataGrid>

        }

    </FluentCard>



    <!-- Architecture Defense-in-Depth Info -->

    <FluentCard>

        <FluentLabel Typo="Typography.H5">Defense-in-Depth Architecture Highlights</FluentLabel>

        <ul class="mt-2 line-height-16">

            <li><strong>Compile-Time Contract:</strong> Pages inherit from <code>AuthorizedPageComponentBase</code> and must declare <code>MinimumVisitRole</code> &amp; <code>MinimumEditRole</code>.</li>

            <li><strong>Fail-Closed Gate 1 (Service Layer):</strong> <code>EnsureCanEditAsync(projectId)</code> throws <code>UnauthorizedAccessException</code> and logs security audits prior to data queries or mutations.</li>

            <li><strong>Fail-Closed Gate 2 (EF Core Safety Net):</strong> <code>ProjectSecurityInterceptor</code> prevents any <code>Added</code>, <code>Modified</code>, or <code>Deleted</code> project entities if the user lacks write permissions.</li>

            <li><strong>Live HybridCache Invalidation:</strong> Role updates immediately purge <code>proj_role_{tenantId}_{userId}_{projectId}</code> from L1/L2 memory so permissions take effect instantly without relogin.</li>

        </ul>

    </FluentCard>

</FluentStack>



@code {

    private List<ProjectEntity> _projects = new();

    private string? _selectedProjectId;

    private List<ProjectUserRoleEntity> _members = new();

    private string _memberFilterText = string.Empty;



    private IQueryable<ProjectUserRoleEntity> FilteredMembers

    {

        get

        {

            var query = _members.AsQueryable();

            if (!string.IsNullOrWhiteSpace(_memberFilterText))

            {

                var term = _memberFilterText.Trim();

                query = query.Where(m =>

                    (m.UserName != null && m.UserName.Contains(term, StringComparison.OrdinalIgnoreCase)) ||

                    (m.UserEmail != null && m.UserEmail.Contains(term, StringComparison.OrdinalIgnoreCase)) ||

                    (m.UserId != null && m.UserId.Contains(term, StringComparison.OrdinalIgnoreCase)) ||

                    m.Role.ToString().Contains(term, StringComparison.OrdinalIgnoreCase));

            }

            return query;

        }

    }



    private List<UserEntity> _tenantUsers = [];

    private string? _selectedTenantUserId;



    private bool _isLoading = false;

    private bool _showAssignModal = false;

    private bool _isEditing = false;

    private string? _statusMessage;

    private bool _isError = false;



    // Form inputs

    private string _formUserId = string.Empty;

    private string _formUserName = string.Empty;

    private string _formEmail = string.Empty;

    private UserTypeEnum _formUserType = UserTypeEnum.CompanyUser;

    private ProjectRoleEnum _formRole = ProjectRoleEnum.ReadOnly;



    protected override async Task OnInitializedAsync()

    {

        await LoadProjectsAsync();

        await LoadTenantUsersAsync();

        if (!string.IsNullOrWhiteSpace(_selectedProjectId))

        {

            await LoadMembersAsync();

        }

    }



    private async Task LoadTenantUsersAsync()

    {

        try

        {

            var tenantId = TenantContext.TenantId;

            _tenantUsers = (await TenantService.GetTenantUsersAsync(TenantContext.TenantSlug)).Where(u => u.IsActive && !u.IsDeleted).OrderBy(u => u.FullName).ToList();















        }

        catch

        {

            _tenantUsers = [];

        }

    }



    private void OnTenantUserSelected(string? userId)

    {

        _selectedTenantUserId = userId;

        var user = _tenantUsers.FirstOrDefault(u => u.Id.ToString() == userId);

        if (user != null)

        {

            _formUserId = user.Id.ToString();

            _formUserName = user.FullName;

            _formEmail = user.Email;

            _formUserType = user.UserType;

        }

        else

        {

            _formUserId = string.Empty;

            _formUserName = string.Empty;

            _formEmail = string.Empty;

        }

    }



    private async Task LoadProjectsAsync()

    {

        try

        {

            var dbProjects = (await TenantService.GetTenantProjectsAsync(TenantContext.TenantSlug)).Where(p => !p.IsDeleted).OrderBy(p => p.Name).ToList();











            if (dbProjects.Count > 0)

            {

                _projects = dbProjects;

            }

            else

            {

                // Fallback demo projects if database has not been seeded yet

                _projects = new List<ProjectEntity>();

            }



            _selectedProjectId = _projects.FirstOrDefault()?.Id.ToString();

        }

        catch (Exception ex)

        {

            _statusMessage = $"Failed to load projects: {ex.Message}";

            _isError = true;

            _projects = new List<ProjectEntity>();

        }

    }



    private async Task OnProjectChanged(string? id)

    {

        _selectedProjectId = id;

        await LoadMembersAsync();

    }



    private async Task LoadMembersAsync()

    {

        if (string.IsNullOrWhiteSpace(_selectedProjectId) || !Guid.TryParse(_selectedProjectId, out var projectId)) return;



        _isLoading = true;

        try

        {

            var members = await ProjectAuth.GetProjectMembersAsync(projectId);

            _members = members.ToList();

        }

        catch (Exception ex)

        {

            _statusMessage = $"Failed to load members: {ex.Message}";

            _isError = true;

        }

        finally

        {

            _isLoading = false;

        }

    }



    private void OpenAddModal()

    {

        _isEditing = false;

        var firstUser = _tenantUsers.FirstOrDefault();

        if (firstUser != null)

        {

            OnTenantUserSelected(firstUser.Id.ToString());

        }

        else

        {

            _selectedTenantUserId = null;

            _formUserId = string.Empty;

            _formUserName = string.Empty;

            _formEmail = string.Empty;

            _formUserType = UserTypeEnum.CompanyUser;

        }

        _formRole = ProjectRoleEnum.Contribute;

        _showAssignModal = true;

    }



    private void EditAssignment(ProjectUserRoleEntity member)

    {

        _isEditing = true;

        _selectedTenantUserId = member.UserId;

        _formUserId = member.UserId;

        _formUserName = member.UserName;

        _formEmail = member.UserEmail;

        _formUserType = member.UserType;

        _formRole = member.Role;

        _showAssignModal = true;

    }



    private void CancelModal()

    {

        _showAssignModal = false;

    }



    private async Task SaveAssignmentAsync()

    {

        if (string.IsNullOrWhiteSpace(_selectedProjectId) || !Guid.TryParse(_selectedProjectId, out var projectId)) return;



        if (string.IsNullOrWhiteSpace(_formUserId) || string.IsNullOrWhiteSpace(_formEmail))

        {

            _statusMessage = "User ID and Email are required.";

            _isError = true;

            return;

        }



        try

        {

            var result = await ProjectAuth.AssignUserRoleAsync(

                projectId,

                _formUserId,

                _formEmail,

                _formUserName,

                _formUserType,

                _formRole);



            if (result.IsSuccess)

            {

                _statusMessage = $"Successfully saved role '{_formRole}' for user '{_formUserName}'. HybridCache purged.";

                _isError = false;

                _showAssignModal = false;

                await LoadMembersAsync();

            }

            else

            {

                _statusMessage = result.Error;

                _isError = true;

            }

        }

        catch (Exception ex)

        {

            _statusMessage = $"Error saving assignment: {ex.Message}";

            _isError = true;

        }

    }



    private async Task RevokeAssignmentAsync(string userId)

    {

        if (string.IsNullOrWhiteSpace(_selectedProjectId) || !Guid.TryParse(_selectedProjectId, out var projectId)) return;



        try

        {

            var result = await ProjectAuth.RevokeUserRoleAsync(projectId, userId);

            if (result.IsSuccess)

            {

                _statusMessage = $"Access revoked for user '{userId}'. Cache purged.";

                _isError = false;

                await LoadMembersAsync();

            }

            else

            {

                _statusMessage = result.Error;

                _isError = true;

            }

        }

        catch (Exception ex)

        {

            _statusMessage = $"Error revoking role: {ex.Message}";

            _isError = true;

        }

    }



    // --- Impersonation ---

    private bool _showImpersonateModal = false;

    private string _impersonateTargetUserId = string.Empty;

    private string _impersonateTargetName = string.Empty;

    private string _impersonateTargetEmail = string.Empty;

    private string _impersonateReason = string.Empty;



    private void PromptImpersonation(ProjectUserRoleEntity member)

    {

        _impersonateTargetUserId = member.UserId;

        _impersonateTargetName = member.UserName;

        _impersonateTargetEmail = member.UserEmail;

        _impersonateReason = string.Empty;

        _showImpersonateModal = true;

    }



    private async Task StartImpersonationAsync()

    {

        if (string.IsNullOrWhiteSpace(_impersonateReason)) return;



        var result = await ImpersonationService.StartImpersonationAsync(

            _impersonateTargetUserId,

            _impersonateReason,

            durationMinutes: 60);



        if (result.IsSuccess)

        {

            if (CurrentUser is AppCurrentUser appUser)

            {

                var adminId = appUser.IsAuthenticated ? appUser.UserId : string.Empty;

                appUser.SetImpersonation(_impersonateTargetUserId, _impersonateTargetEmail, _impersonateTargetName, adminId);

            }



            AuthStateProvider.NotifyUserChanged();

            _showImpersonateModal = false;

            NavigationManager.NavigateTo("/", forceLoad: false);

        }

        else

        {

            _statusMessage = result.Error;

            _isError = true;

        }

    }

}

