@namespace BlazorEnterprise.Modules.Imports.Pages
@page "/imports"
@attribute [RequiredClearance(ProjectRoleEnum.Lead)]
@attribute [Microsoft.AspNetCore.RateLimiting.EnableRateLimiting("file-upload")]
@rendermode InteractiveServer
@using BlazorEnterprise.Shared.Attributes
@using BlazorEnterprise.Components.Common
@using BlazorEnterprise.Core.Contracts
@using BlazorEnterprise.Core.Dtos.Imports
@using BlazorEnterprise.Shared.DataListTypes
@using BlazorEnterprise.Core.Domain.Tenancy
@using BlazorEnterprise.Core.Extensions
@using BlazorEnterprise.Modules.Imports.Components
@using BlazorEnterprise.Persistence.Context
@using BlazorEnterprise.Web.Modules.Imports.Services
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Routing

<PageTitle>File Import & Processing — BlazorEnterprise</PageTitle>

<!-- Active Navigation Lock while validation/staging is executing -->
<NavigationLock ConfirmExternalNavigation="@_isStagingInProgress"
                OnBeforeInternalNavigation="@HandleBeforeInternalNavigation" />

<PageHeaderComp Title="File Import & Batch Processing Pipeline"
                Subtitle="Select file format, download configured templates, validate and stage payloads, and monitor batch execution.">
    <Actions>
        <CskButton Variant="CskButtonVariant.Outlined"
                   IconStart="@CskIcons.ArrowClockwise"
                   OnClick="@RefreshHistoryAsync">
            Refresh Status
        </CskButton>
    </Actions>
</PageHeaderComp>

<CskTabs @bind-ActiveTabId="_activeTabId" Class="mt-3">
    <!-- TAB 1: IMPORT FILE -->
    <CskTab Id="tab-import" Label="Import File">
        <CskCard Class="p-card mt-3">
            <CskStack Orientation="CskOrientation.Vertical" VerticalGap="18">
                <!-- Target Project (Bound to Active Workspace) -->
                @if (ProjectContext.ProjectId.HasValue && ProjectContext.ProjectId.Value != Guid.Empty && _currentProject != null)
                {
                    <div class="workspace-target-display">
                        <span class="workspace-target-label">Target Project Workspace</span>
                        <div class="workspace-target-box">
                            <CskIcon Icon="@CskIcons.Folder" Class="csk-icon-sm csk-icon-primary" />
                            <span class="workspace-target-name">@_currentProject.Name</span>
                            @if (!string.IsNullOrWhiteSpace(_currentProject.ShortCode))
                            {
                                <span class="workspace-target-code">(@_currentProject.ShortCode)</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(ProjectContext.ProgramName))
                            {
                                <span class="workspace-target-program">Program: @ProjectContext.ProgramName</span>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <CskMessageBar Intent="MessageBarIntent.Warning">
                        No active project selected in workspace. Please select a project from the top navigation switcher to enable file imports.
                    </CskMessageBar>
                }

                @if (ProjectContext.ProjectId.HasValue && ProjectContext.ProjectId.Value != Guid.Empty && _currentProject != null)
                {
                    <!-- STEP 1: Select File Type -->
                    <div class="import-section-group">
                        <CskLabel Typo="Typography.Subtitle" Class="mb-1 font-weight-600">1. Select Payload Specification</CskLabel>
                        <CskSelect TOption="ImportFileTypeMetadata" TValue="string"
                                   Items="@_availableTypes"
                                   OptionText="@(i => i.DisplayName)"
                                   OptionValue="@(i => i.FileType.ToString())"
                                   Value="@_selectedFileType.ToString()"
                                   ValueChanged="@OnFileTypeChanged"
                                   Disabled="@_isStagingInProgress"
                                   Label="File Type"
                                   Class="full-width" />
                    </div>

                    <!-- STEP 2: Template Information & Download Link -->
                    @if (_selectedMetadata != null)
                    {
                        <div class="template-info-box">
                            <CskStack Orientation="CskOrientation.Horizontal" HorizontalAlignment="CskHorizontalAlignment.SpaceBetween" VerticalAlignment="CskVerticalAlignment.Center">
                                <CskStack Orientation="CskOrientation.Vertical" VerticalGap="4">
                                    <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="8" VerticalAlignment="CskVerticalAlignment.Center">
                                        <CskIcon Icon="@CskIcons.Document" Class="csk-icon-primary" />
                                        <span class="template-title font-weight-600">Starter Template Available</span>
                                        <CskBadge Variant="@BadgeAppearance.Outline">@_selectedMetadata.Extension</CskBadge>
                                    </CskStack>
                                    <p class="template-desc">@_selectedMetadata.Description</p>
                                </CskStack>
                                <CskButton Variant="CskButtonVariant.Outlined"
                                           IconStart="@CskIcons.ArrowDown"
                                           Loading="@_isDownloadingTemplate"
                                           Disabled="@(_isStagingInProgress || _isDownloadingTemplate)"
                                           OnClick="@DownloadTemplateAsync">
                                    Download Blank Template
                                </CskButton>
                            </CskStack>
                        </div>
                    }

                    <!-- STEP 3: File Picker -->
                    <div class="import-section-group">
                        <CskLabel Typo="Typography.Subtitle" Class="mb-1 font-weight-600">2. Select File to Import</CskLabel>
                        <div class="file-drop-zone @(_isStagingInProgress ? "disabled-zone" : "")">
                            <CskLabel Typo="Typography.Body" Class="mb-2 d-block">
                                Choose a file matching the selected format (@(_selectedMetadata?.Extension ?? ".xlsx, .csv"))
                            </CskLabel>
                            <InputFile OnChange="@HandleFileSelected"
                                       accept="@(_selectedMetadata?.AcceptAttribute ?? ".xlsx,.csv")"
                                       disabled="@_isStagingInProgress"
                                       class="full-width" />
                        </div>
                    </div>

                    <!-- Selected File Preview -->
                    @if (_selectedFile != null)
                    {
                        <div class="selected-file-card">
                            <CskStack Orientation="CskOrientation.Horizontal" HorizontalAlignment="CskHorizontalAlignment.SpaceBetween" VerticalAlignment="CskVerticalAlignment.Center">
                                <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="10" VerticalAlignment="CskVerticalAlignment.Center">
                                    <CskIcon Icon="@CskIcons.Document" />
                                    <div>
                                        <div class="font-weight-600">@_selectedFileName</div>
                                        <div class="text-hint font-size-xs">@FormatBytes(_selectedFileSize) • Ready for staging</div>
                                    </div>
                                </CskStack>
                                @if (!_isStagingInProgress)
                                {
                                    <CskButton Variant="CskButtonVariant.Text"
                                               IconStart="@CskIcons.Dismiss"
                                               OnClick="@ClearSelectedFile"
                                               Title="Remove file" />
                                }
                            </CskStack>
                        </div>
                    }

                    <!-- Progress Bar while Staging -->
                    @if (_isStagingInProgress)
                    {
                        <div class="staging-progress-container mt-2">
                            <CskStack Orientation="CskOrientation.Vertical" VerticalGap="8">
                                <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="8" VerticalAlignment="CskVerticalAlignment.Center">
                                    <CskSpinner Class="csk-icon-sm" />
                                    <span class="font-weight-600">Validating schema & staging payload...</span>
                                </CskStack>
                                <CskProgressBar />
                                <span class="text-hint font-size-xs">
                                    Please do not navigate away or close the browser window. Client-side encryption and database staging are in flight.
                                </span>
                            </CskStack>
                        </div>
                    }

                    <!-- Status Notification Banner -->
                    @if (!string.IsNullOrWhiteSpace(_statusMessage))
                    {
                        <CskMessageBar Intent="@_messageIntent">
                            @_statusMessage
                        </CskMessageBar>
                    }

                    <!-- STEP 4: Action Button -->
                    <CskStack Orientation="CskOrientation.Horizontal" HorizontalAlignment="CskHorizontalAlignment.End" Class="mt-2">
                        <CskButton Variant="CskButtonVariant.Filled"
                                   IconStart="@CskIcons.ArrowSync"
                                   Disabled="@(_isStagingInProgress || _selectedFile == null || _currentProject == null)"
                                   Loading="@_isStagingInProgress"
                                   OnClick="@ImportAndStageFileAsync">
                            @(_isStagingInProgress ? "Validating & Staging..." : "Import & Stage Payload")
                        </CskButton>
                    </CskStack>
                }
            </CskStack>
        </CskCard>
    </CskTab>

    <!-- TAB 2: IMPORT STATUS & HISTORY -->
    <CskTab Id="tab-status" Label="Import Status">
        <CskCard Class="p-card mt-3">
            <CskStack Orientation="CskOrientation.Vertical" VerticalGap="15">
                <CskStack Orientation="CskOrientation.Horizontal" HorizontalAlignment="CskHorizontalAlignment.SpaceBetween" VerticalAlignment="CskVerticalAlignment.Center">
                    <CskLabel Typo="Typography.H6">Payload Staging & Batch Execution History</CskLabel>
                    <CskBadge Variant="@BadgeAppearance.Filled">@_history.Count file(s)</CskBadge>
                </CskStack>

                @if (_isLoadingHistory)
                {
                    <CskSpinner Class="import-spinner" />
                }
                else if (_history.Count == 0)
                {
                    <EmptyStateComp Title="No Files Ingested"
                                    Description="Uploaded payloads and their background staging progress will appear here."
                                    Icon="@CskIcons.DocumentSearch" />
                }
                else
                {
                    <div class="overflow-x-auto">
                        <CskDataGrid Items="@_history.AsQueryable()"
                                     ResizableColumns="true"
                                     TGridItem="ImportFileSummaryDto"
                                     Class="full-width">
                            <CskTemplateColumn Title="Batch ID" Width="100px">
                                <span title="@context.ImportId.ToString()" class="mono-code">
                                    @context.ImportId.ToString()[..8]...
                                </span>
                            </CskTemplateColumn>
                            <CskPropertyColumn Property="@(f => f.OriginalFileName)" Title="File Name" Width="170px" />
                            <CskTemplateColumn Title="Format Specification" Width="140px">
                                <CskBadge Variant="@BadgeAppearance.Outline">@context.FileType</CskBadge>
                            </CskTemplateColumn>
                            <CskTemplateColumn Title="Pipeline Stage" Width="100px">
                                <CskBadge Variant="@BadgeAppearance.Filled" Color="BadgeColor.Subtle">
                                    @(string.IsNullOrWhiteSpace(context.StepStage) ? "Uploaded" : context.StepStage)
                                </CskBadge>
                            </CskTemplateColumn>
                            <CskTemplateColumn Title="Status" Width="140px">
                                @switch (context.Status)
                                {
                                    case ImportStatusEnum.Uploaded:
                                        <CskBadge Color="BadgeColor.Informative">Uploaded</CskBadge>
                                        break;
                                    case ImportStatusEnum.Validating:
                                        <CskBadge Color="BadgeColor.Brand">Validating</CskBadge>
                                        break;
                                    case ImportStatusEnum.ValidationSuccess:
                                        <CskBadge Color="BadgeColor.Brand">Validated</CskBadge>
                                        break;
                                    case ImportStatusEnum.ValidationFailed:
                                        <CskBadge Color="BadgeColor.Severe">Validation Failed</CskBadge>
                                        break;
                                    case ImportStatusEnum.Staging:
                                        <CskBadge Color="BadgeColor.Brand">Staging</CskBadge>
                                        break;
                                    case ImportStatusEnum.StagingSuccess:
                                        <CskBadge Color="BadgeColor.Brand">Staged</CskBadge>
                                        break;
                                    case ImportStatusEnum.StagingFailed:
                                        <CskBadge Color="BadgeColor.Severe">Staging Failed</CskBadge>
                                        break;
                                    case ImportStatusEnum.Processing:
                                        <CskBadge Color="BadgeColor.Brand">Processing</CskBadge>
                                        break;
                                    case ImportStatusEnum.Completed:
                                        <CskBadge Color="BadgeColor.Success">Completed</CskBadge>
                                        break;
                                    case ImportStatusEnum.ProcessingFailed:
                                        <CskBadge Color="BadgeColor.Severe">Processing Failed</CskBadge>
                                        break;
                                    default:
                                        <CskBadge>@context.Status</CskBadge>
                                        break;
                                }
                            </CskTemplateColumn>
                            <CskTemplateColumn Title="Metrics" Width="100px">
                                <span>@context.ValidRowsCount / @context.TotalRowsCount ok</span>
                            </CskTemplateColumn>
                            <CskTemplateColumn Title="Size" Width="80px">
                                <span>@FormatBytes(context.FileSizeBytes)</span>
                            </CskTemplateColumn>
                            <CskTemplateColumn Title="Actions" Width="130px">
                                <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="6">
                                    @if (context.Status is ImportStatusEnum.ValidationFailed or ImportStatusEnum.StagingFailed or ImportStatusEnum.ProcessingFailed)
                                    {
                                        <CskButton Variant="CskButtonVariant.Text"
                                                   IconStart="@CskIcons.ErrorCircle"
                                                   Class="text-danger"
                                                   OnClick="@(() => ViewDiagnosticsAsync(context.Id))">
                                            Errors
                                        </CskButton>
                                    }
                                    <CskButton Variant="CskButtonVariant.Text"
                                               IconStart="@CskIcons.Delete"
                                               OnClick="@(() => PromptDelete(context.Id))" />
                                </CskStack>
                            </CskTemplateColumn>
                        </CskDataGrid>
                    </div>
                }
            </CskStack>
        </CskCard>
    </CskTab>
</CskTabs>

<!-- Diagnostics Modal -->
<ImportErrorsModal @ref="_errorsModal" />

<!-- Confirmation Modal -->
<ConfirmDialogModal @ref="_confirmDialog"
                    Title="Delete Import Record"
                    Message="Are you sure you want to delete this import record and its staged items?"
                    ConfirmLabel="Delete"
                    OnConfirmed="@DeleteConfirmedAsync" />
