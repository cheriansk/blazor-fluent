{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Admin": {
    "RootTenantId": "",
    "RootTenantSlug": "",
    "RootTenantName": "",
    "RootAdmins": ""
  },
  "Identity": {
    "SystemDaemonLocalPart": "",
    "SystemDaemonEmailDomain": "",
    "SystemActorName": ""
  },
  "Caching": {
    "DefaultExpirationMinutes": 60,
    "LocalCacheExpirationMinutes": 15
  },
  "Jobs": {
    "EnableScheduler": false,
    "CronServiceAccountEmail": "",
    "Schedules": {
      "AuditPurgeJob": "0 2 * * *",
      "DailyTaskSummaryJob": "0 18 * * *",
      "TaskCadenceAlertJob": "0 8 * * *"
    }
  },
  "Audit": {
    "RetentionDays": 365
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "BlazorEnterprise": "Information",
        "BlazorEnterprise.Components": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "Notifications": {
    "Teams": {
      "Enabled": false,
      "DefaultWebhookUrl": "",
      "ProjectWebhooks": {}
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "",
      "SmtpPort": 587,
      "UseSsl": false,
      "SenderEmail": "",
      "SenderName": "BlazorEnterprise Notifications",
      "DefaultMailbox": "",
      "ProjectMailboxes": {}
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "KeyVault": {
    "Uri": ""
  },
  "Security": {
    "IntegritySecret": "",
    "MasterEncryptionKey": "",
    "SystemBootstrapEmail": "",
    "Csp": {
      "Enforce": true,
      "ReportOnly": false,
      "ReportUri": "/api/security/csp-violations",
      "Profile": "PureStrict"
    }
  },
  "Engine": {
    "Mode": "Remote",
    "ApiBaseUrl": "",
    "LicenseKey": ""
  },
  "AllowedHosts": "*",
  "Alerting": {
    "Teams": {
      "Enabled": true,
      "WebhookUrl": "",
      "MinLevel": "Error",
      "MaxAlertsPerMinute": 10
    }
  }
}
