@typeparam TItem

<div class="swimlane-container">
    @foreach (var col in Columns)
    {
        var colItems = _groupedItems.TryGetValue(col, out var list) ? list : (IReadOnlyList<TItem>)[];

        <div class="swimlane-column">
            <!-- Column Header -->
            <div class="swimlane-header">
                <div class="swimlane-header-left">
                    <span class="swimlane-title">@col.Title</span>
                    @if (!string.IsNullOrWhiteSpace(col.Subtitle))
                    {
                        <span class="swimlane-subtitle">@col.Subtitle</span>
                    }
                </div>
                <CskBadge Appearance="@BadgeAppearance.Tint" ><!--Color="@col.BadgeColor">-->
                    @colItems.Count
                </CskBadge>
            </div>

            <!-- Column Card Stack -->
            <div class="swimlane-body">
                @if (colItems.Count == 0)
                {
                    <div class="swimlane-empty">
                        <span>No items</span>
                    </div>
                }
                else
                {
                    @foreach (var item in colItems)
                    {
                        <div class="swimlane-card-wrapper" @onclick="() => HandleItemClick(item)">
                            @if (ItemTemplate is not null)
                            {
                                @ItemTemplate(item)
                            }
                        </div>
                    }
                }
            </div>
        </div>
    }
</div>

@code {
    [Parameter]
    public IReadOnlyList<SwimlaneColumn<TItem>> Columns { get; set; } = [];

    [Parameter]
    public IReadOnlyList<TItem> Items { get; set; } = [];

    [Parameter]
    public RenderFragment<TItem>? ItemTemplate { get; set; }

    [Parameter]
    public EventCallback<TItem> OnItemClick { get; set; }

    private readonly Dictionary<SwimlaneColumn<TItem>, IReadOnlyList<TItem>> _groupedItems = new();

    protected override void OnParametersSet()
    {
        _groupedItems.Clear();
        foreach (var col in Columns)
        {
            _groupedItems[col] = Items.Where(col.Predicate).ToList();
        }
    }

    private async Task HandleItemClick(TItem item)
    {
        if (OnItemClick.HasDelegate)
        {
            await OnItemClick.InvokeAsync(item);
        }
    }
}
