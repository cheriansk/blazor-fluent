@inject NavigationManager NavigationManager
@inject ICurrentUser CurrentUser

<div class="flex-center min-h-50vh">
    <CskSpinner Size="CskSpinnerSize.Medium" />
</div>

@code {
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Allow MainLayout.OnAfterRenderAsync a brief window (250ms) to rehydrate session from browser sessionStorage
            await Task.Delay(250);
            if (!CurrentUser.IsAuthenticated)
            {
                var returnUrl = NavigationManager.ToBaseRelativePath(NavigationManager.Uri);
                if (string.IsNullOrWhiteSpace(returnUrl) || returnUrl.StartsWith("login", StringComparison.OrdinalIgnoreCase))
                {
                    NavigationManager.NavigateTo("/login", replace: true);
                }
                else
                {
                    NavigationManager.NavigateTo($"/login?returnUrl={Uri.EscapeDataString(returnUrl)}", replace: true);
                }
            }
        }
    }
}
