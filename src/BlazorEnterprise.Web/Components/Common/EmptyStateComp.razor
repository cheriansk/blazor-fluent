@namespace BlazorEnterprise.Web.Components.Common
@using BlazorEnterprise.Shared.UI.Components

@* Reusable empty-state card for data grids or lists with no records *@
<div class="csk-empty-state-root">
    <div class="csk-empty-state-box">
        <CskIcon Icon="@Icon" Class="csk-icon-muted csk-empty-icon-lg" />
        <h4 class="csk-empty-title">@Title</h4>
        @if (!string.IsNullOrWhiteSpace(Description))
        {
            <p class="csk-empty-desc">@Description</p>
        }
        @if (Actions is not null)
        {
            <div class="csk-empty-actions-box">@Actions</div>
        }
    </div>
</div>

@code {
    [Parameter] public string Icon { get; set; } = CskIcons.DocumentSearch;
    [Parameter] public string Title { get; set; } = "No records found";
    [Parameter] public string? Description { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
}