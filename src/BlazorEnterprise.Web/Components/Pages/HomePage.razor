@page "/"
@attribute [Authorize]
@rendermode InteractiveServer
@using BlazorEnterprise.Web.Components.Pages.Dashboard

<PageTitle>Dashboard — BlazorEnterprise Material</PageTitle>

<div class="homepage-container">
    @if (_isRootAdminOnly)
    {
        <!-- Platform Root Admin Notice -->
        <div class="root-admin-banner">
            <div class="banner-icon">
                <CskIcon Icon="@CskIcons.ShieldCheck" Class="csk-icon-primary" />
            </div>
            <div class="banner-content">
                <div class="banner-title">Root Administrator Context Active</div>
                <div class="banner-subtitle">
                    You are signed in as a platform Root Administrator. Program and Project delivery workspaces require an active tenant user membership. Use the Tenant Settings or Switcher above to manage tenant configurations.
                </div>
            </div>
        </div>
    }

    <!-- Material Section Header & Action Toolbar -->
    <CskSectionHeader Title="Operations Executive Dashboard"
                      Subtitle="Real-time multi-tenant operations, program delivery governance, and member projects."
                      Icon="@CskIcons.Apps">
        <Actions>
            @if (_userProjects.Count > 0)
            {
                <CskButton Variant="CskButtonVariant.Filled" IconStart="@CskIcons.Add" OnClick="@NavigateToTasks">
                    New Task
                </CskButton>
            }
            <CskButton Variant="CskButtonVariant.Outlined" IconStart="@CskIcons.ArrowSync" OnClick="@RefreshDataAsync">
                Refresh
            </CskButton>
        </Actions>
    </CskSectionHeader>

    @if (_isLoading)
    {
        <div class="dashboard-loading-state">
            <CskSpinner Size="CskSpinnerSize.Large" />
            <span class="loading-label">Loading real-time executive dashboard...</span>
        </div>
    }
    else if (!_isRootAdminOnly)
    {
        <!-- 1. Program-Level Executive Summary Card -->
        <ProgramSummaryCard Health="@_programHealth" />

        <!-- 2. My Projects Card Grid Section -->
        <MyProjectsGrid Projects="@_userProjects" OnOpenProject="@OpenProjectTasks" />

        <!-- 3. Bottom Content Area: Kanban Workflow Board & Recent Activity -->
        <div class="dashboard-columns-grid">
            <DashboardKanbanBoard Tasks="@_kanbanTasks" OnNavigateToTasks="@NavigateToTasks" />
            <DashboardAuditTrail Activities="@_auditActivities" />
        </div>
    }
</div>
