@namespace BlazorEnterprise.Web.Components.Pages.Settings.ProjectWizard.Steps
@using BlazorEnterprise.Shared.UI.Wizards
@using BlazorEnterprise.Core.Dtos
@using BlazorEnterprise.Shared.UI.Components
@using BlazorEnterprise.Core.Contracts
@implements IWizardStepComponent<CreateProjectWizardState>
@inject IUserTimeZoneService TimeZoneService

<div class="csk-wizard-step-container">
    <CskStack Orientation="CskOrientation.Vertical" VerticalGap="16" Class="w-full">
        @if (!string.IsNullOrWhiteSpace(_validationError))
        {
            <CskMessageBar Intent="MessageBarIntent.Error" AllowDismiss="true" OnDismiss="@(() => _validationError = null)">
                @_validationError
            </CskMessageBar>
        }

        <div class="font-size-sm text-hint">
            Define overall project delivery timeline and phase breakdown for team execution. Milestones will be added in the next step under each phase.
        </div>

        @if (!_isReadOnly)
        {
            <div class="csk-entry-form-card">
                <CskLabel Typo="Typography.H6" Class="mb-3">
                    @(_editingPhaseId.HasValue ? "Edit Timeline Phase" : "Add Timeline Phase")
                </CskLabel>
                <CskStack Orientation="CskOrientation.Vertical" VerticalGap="12">
                    <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="12" Class="full-width">
                        <CskTextInput Label="Phase Title / Scope *" @bind-Value="_phaseName" Placeholder="e.g. Iteration 1 - Core Backend" Class="flex-2" />
                        <CskDatePicker Label="Start Date *" @bind-Value="_phaseStartDate" Class="flex-1" />
                        <CskDatePicker Label="End Date *" @bind-Value="_phaseEndDate" Class="flex-1" />
                        <CskSelect TOption="string"
                                   TValue="string"
                                   Label="Status *"
                                   Items="@_statusOptions"
                                   OptionText="@(s => s)"
                                   OptionValue="@(s => s)"
                                   @bind-Value="_phaseStatus"
                                   Class="flex-1" />
                    </CskStack>

                    <CskTextArea Label="Comments"
                                 @bind-Value="_phaseComments"
                                 Placeholder="Optional comments or scope description..."
                                 Rows="2"
                                 Class="full-width" />

                    <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="8">
                        <CskButton Variant="CskButtonVariant.Filled"
                                   Size="CskButtonSize.Small"
                                   IconStart="@(_editingPhaseId.HasValue ? CskIcons.Checkmark : CskIcons.Add)"
                                   Disabled="@(string.IsNullOrWhiteSpace(_phaseName))"
                                   OnClick="@SavePhase">
                            @(_editingPhaseId.HasValue ? "Update Phase" : "Add Phase")
                        </CskButton>

                        @if (_editingPhaseId.HasValue)
                        {
                            <CskButton Variant="CskButtonVariant.Text"
                                       Size="CskButtonSize.Small"
                                       OnClick="@CancelEdit">
                                Cancel
                            </CskButton>
                        }
                    </CskStack>
                </CskStack>
            </div>
        }

        @if (_phases.Count == 0)
        {
            <div class="csk-empty-table-state">
                <CskIcon Icon="@CskIcons.Clock" Class="csk-empty-icon" />
                <p>No project timeline phases defined yet. Add a timeline phase above.</p>
            </div>
        }
        else
        {
            <CskDataGrid TGridItem="ProjectPhaseDto" Items="@_phases.AsQueryable()" Outlined="true" Dense="true" Hover="true">
                <CskPropertyColumn Property="@(p => p.Title)" Title="Phase Title" />
                <CskTemplateColumn Title="Start Date">
                    @TimeZoneService.FormatDate(context.StartDate)
                </CskTemplateColumn>
                <CskTemplateColumn Title="End Date">
                    @TimeZoneService.FormatDate(context.EndDate)
                </CskTemplateColumn>
                <CskTemplateColumn Title="Status">
                    <CskBadge Appearance="BadgeAppearance.Filled" Color="@GetStatusBadgeColor(context.Status)">
                        @context.Status
                    </CskBadge>
                </CskTemplateColumn>
                <CskTemplateColumn Title="Comments">
                    @(string.IsNullOrWhiteSpace(context.Comments) ? "—" : context.Comments)
                </CskTemplateColumn>
                <CskTemplateColumn Title="Actions">
                    @if (!_isReadOnly)
                    {
                        <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="6">
                            <CskButton Variant="CskButtonVariant.Text"
                                       Size="CskButtonSize.Small"
                                       IconStart="@CskIcons.Edit"
                                       OnClick="@(() => StartEdit(context))">
                                Edit
                            </CskButton>
                            <CskButton Variant="CskButtonVariant.Text"
                                       Size="CskButtonSize.Small"
                                       IconStart="@CskIcons.Delete"
                                       OnClick="@(() => RemovePhase(context.Id))" />
                        </CskStack>
                    }
                </CskTemplateColumn>
            </CskDataGrid>
        }
    </CskStack>
</div>

@code {
    [CascadingParameter]
    public WizardContext<CreateProjectWizardState>? CascadedContext { get; set; }

    [Parameter]
    public WizardContext<CreateProjectWizardState>? Context { get; set; }

    private WizardContext<CreateProjectWizardState>? EffectiveContext => Context ?? CascadedContext;

    private List<ProjectPhaseDto> _phases = new();
    private readonly List<string> _statusOptions = new() { "New", "Scheduled", "InProgress", "Completed" };

    private Guid? _editingPhaseId;
    private string _phaseName = string.Empty;
    private DateTime? _phaseStartDate = DateTime.UtcNow.Date;
    private DateTime? _phaseEndDate = DateTime.UtcNow.Date.AddMonths(1);
    private string _phaseStatus = "New";
    private string _phaseComments = string.Empty;

    private string? _validationError;
    private bool _isReadOnly;

    protected override void OnInitialized()
    {
        Context ??= CascadedContext;
        LoadState();
    }

    protected override void OnParametersSet()
    {
        Context ??= CascadedContext;
        LoadState();
    }

    private void LoadState()
    {
        var ctx = EffectiveContext;
        if (ctx != null)
        {
            _isReadOnly = ctx.IsReadOnly;
            if (ctx.State.Phases != null && ctx.State.Phases.Count > 0)
            {
                _phases = ctx.State.Phases;
            }
            else if (!ctx.State.CustomStepData.ContainsKey("TimelineInitialized") && _phases.Count == 0 && ctx.State.StartDate.HasValue)
            {
                ctx.State.CustomStepData["TimelineInitialized"] = true;
                _phases.Add(new ProjectPhaseDto
                {
                    Title = "Primary Execution Phase",
                    StartDate = ctx.State.StartDate,
                    EndDate = ctx.State.EndDate ?? ctx.State.StartDate.Value.AddMonths(3),
                    Status = "New"
                });
                SyncToContext();
            }
        }
    }

    private void StartEdit(ProjectPhaseDto phase)
    {
        _editingPhaseId = phase.Id;
        _phaseName = phase.Title;
        _phaseStartDate = phase.StartDate;
        _phaseEndDate = phase.EndDate;
        _phaseStatus = phase.Status;
        _phaseComments = phase.Comments ?? string.Empty;
        _validationError = null;
    }

    private void CancelEdit()
    {
        _editingPhaseId = null;
        _phaseName = string.Empty;
        _phaseStartDate = DateTime.UtcNow.Date;
        _phaseEndDate = DateTime.UtcNow.Date.AddMonths(1);
        _phaseStatus = "New";
        _phaseComments = string.Empty;
        _validationError = null;
    }

    private void SavePhase()
    {
        if (string.IsNullOrWhiteSpace(_phaseName))
        {
            _validationError = "Phase Title is required.";
            return;
        }

        if (!_phaseStartDate.HasValue || !_phaseEndDate.HasValue)
        {
            _validationError = "Start Date and End Date are required.";
            return;
        }

        if (_phaseEndDate < _phaseStartDate)
        {
            _validationError = "End Date cannot be earlier than Start Date.";
            return;
        }

        if (_editingPhaseId.HasValue)
        {
            var existing = _phases.FirstOrDefault(p => p.Id == _editingPhaseId.Value);
            if (existing != null)
            {
                existing.Title = _phaseName.Trim();
                existing.StartDate = _phaseStartDate;
                existing.EndDate = _phaseEndDate;
                existing.Status = _phaseStatus;
                existing.Comments = string.IsNullOrWhiteSpace(_phaseComments) ? null : _phaseComments.Trim();
            }
        }
        else
        {
            _phases.Add(new ProjectPhaseDto
            {
                Id = Guid.NewGuid(),
                Title = _phaseName.Trim(),
                StartDate = _phaseStartDate,
                EndDate = _phaseEndDate,
                Status = _phaseStatus,
                Comments = string.IsNullOrWhiteSpace(_phaseComments) ? null : _phaseComments.Trim(),
                Milestones = new List<ProjectMilestoneDto>()
            });
        }

        if (EffectiveContext != null)
        {
            EffectiveContext.State.CustomStepData["TimelineInitialized"] = true;
        }
        CancelEdit();
        SyncToContext();
    }

    private void RemovePhase(Guid id)
    {
        _phases.RemoveAll(p => p.Id == id);
        if (_editingPhaseId == id)
        {
            CancelEdit();
        }
        SyncToContext();
    }

    private void SyncToContext(WizardContext<CreateProjectWizardState>? targetContext = null)
    {
        var ctx = targetContext ?? EffectiveContext;
        if (ctx != null)
        {
            ctx.State.Phases = _phases;
            ctx.State.Milestones = _phases.SelectMany(p => p.Milestones ?? new List<ProjectMilestoneDto>()).ToList();
            ctx.MarkDirty();
        }
    }

    private static BadgeColor GetStatusBadgeColor(string status) => status?.ToLowerInvariant() switch
    {
        "completed" => BadgeColor.Success,
        "inprogress" or "active" => BadgeColor.Warning,
        "new" => BadgeColor.Brand,
        _ => BadgeColor.Neutral
    };

    public bool HasPendingChanges()
    {
        return !string.IsNullOrWhiteSpace(_phaseName);
    }

    private bool TrySavePhase()
    {
        if (string.IsNullOrWhiteSpace(_phaseName)) return true;

        if (!_phaseStartDate.HasValue || !_phaseEndDate.HasValue)
        {
            _validationError = "Start Date and End Date are required for the timeline phase in progress.";
            return false;
        }

        if (_phaseEndDate < _phaseStartDate)
        {
            _validationError = "End Date cannot be earlier than Start Date for the timeline phase in progress.";
            return false;
        }

        SavePhase();
        return true;
    }

    public Task<bool> ValidateStepAsync(WizardContext<CreateProjectWizardState> context)
    {
        _validationError = null;

        // Auto-commit any phase currently being typed or edited
        if (!string.IsNullOrWhiteSpace(_phaseName))
        {
            if (!TrySavePhase())
            {
                return Task.FromResult(false);
            }
        }

        if (_phases.Count == 0)
        {
            _validationError = "At least one project timeline phase is required.";
            return Task.FromResult(false);
        }

        Context = context;
        SyncToContext(context);

        // Also sync project overall StartDate and EndDate from earliest and latest phases
        if (_phases.Any(p => p.StartDate.HasValue))
        {
            context.State.StartDate = _phases.Where(p => p.StartDate.HasValue).Min(p => p.StartDate!.Value);
        }
        if (_phases.Any(p => p.EndDate.HasValue))
        {
            context.State.EndDate = _phases.Where(p => p.EndDate.HasValue).Max(p => p.EndDate!.Value);
        }

        return Task.FromResult(true);
    }
}
