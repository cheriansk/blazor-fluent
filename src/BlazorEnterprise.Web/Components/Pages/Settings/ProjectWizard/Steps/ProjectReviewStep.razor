@namespace BlazorEnterprise.Web.Components.Pages.Settings.ProjectWizard.Steps
@using BlazorEnterprise.Shared.UI.Wizards
@using BlazorEnterprise.Shared.UI.Components
@using BlazorEnterprise.Core.Dtos
@using BlazorEnterprise.Core.Contracts
@using BlazorEnterprise.Shared.DataListTypes
@implements IWizardStepComponent<CreateProjectWizardState>
@inject IUserTimeZoneService TimeZoneService

<div class="csk-wizard-step-container">
    <CskStack Orientation="CskOrientation.Vertical" VerticalGap="16">
        <CskLabel Typo="Typography.Body" Class="text-hint">
            Please review the project configuration before finalizing. All changes will be saved upon clicking Save / Finish.
        </CskLabel>

        <!-- Summary Card -->
        <CskCard Class="p-4">
            <div class="csk-review-header">
                <div>
                    <CskLabel Typo="Typography.H5">@EffectiveContext?.State.Name</CskLabel>
                    <span class="text-hint font-size-sm">Short Code: <code>@EffectiveContext?.State.ShortCode</code></span>
                    @if (!string.IsNullOrWhiteSpace(EffectiveContext?.State.SelectedTemplateId))
                    {
                        <span class="text-hint font-size-sm template-badge-space">Template: <strong>@EffectiveContext.State.SelectedTemplateId</strong></span>
                    }
                </div>
            </div>

            @if (!string.IsNullOrWhiteSpace(EffectiveContext?.State.ScopeSummary))
            {
                <div class="csk-review-desc">
                    @EffectiveContext?.State.ScopeSummary
                </div>
            }

            <div class="csk-review-grid">
                <div>
                    <span class="csk-review-metric-title">Timeline Window</span>
                    <span class="csk-review-metric-val">
                        @TimeZoneService.FormatDate(EffectiveContext?.State.StartDate) ~ @TimeZoneService.FormatDate(EffectiveContext?.State.EndDate)
                    </span>
                </div>
                <div>
                    <span class="csk-review-metric-title">Team Roster</span>
                    <span class="csk-review-metric-val">
                        @(EffectiveContext?.State.Roster?.Count ?? 0) member(s) assigned
                    </span>
                </div>
            </div>

            <!-- Team Roster with Diff Badges -->
            <div class="mt-4">
                <span class="font-size-sm font-weight-600 mb-2 d-block">Team Roster Members (@(EffectiveContext?.State.Roster?.Count ?? 0)):</span>
                @if (EffectiveContext?.State.Roster == null || EffectiveContext.State.Roster.Count == 0)
                {
                    <span class="text-hint font-size-sm">No roster members assigned.</span>
                }
                else
                {
                    <div class="csk-badge-list">
                        @foreach (var member in EffectiveContext.State.Roster)
                        {
                            var initialMember = _initialSnapshot?.Roster?.FirstOrDefault(r => r.Id == member.Id);
                            var isNewMember = initialMember == null;
                            var isModifiedMember = !isNewMember && (initialMember!.FullName != member.FullName || initialMember.Email != member.Email || initialMember.Role != member.Role);

                            <span class="csk-badge-item">
                                <span><strong>@member.FullName</strong> (@member.Email) - <em>@member.Role</em></span>
                                @if (isNewMember)
                                {
                                    <CskBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" Size="BadgeSize.Small">New</CskBadge>
                                }
                                else if (isModifiedMember)
                                {
                                    <CskBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Warning" Size="BadgeSize.Small">Modified</CskBadge>
                                }
                            </span>
                        }
                    </div>
                }
            </div>

            <!-- Timeline Phases & Nested Milestones with Diff Badges -->
            <div class="mt-4">
                <span class="font-size-sm font-weight-600 mb-2 d-block">Timeline Phases &amp; Milestones (@(EffectiveContext?.State.Phases?.Count ?? 0) phases):</span>
                @if (EffectiveContext?.State.Phases == null || EffectiveContext.State.Phases.Count == 0)
                {
                    <span class="text-hint font-size-sm">No timeline phases defined.</span>
                }
                else
                {
                    <div class="csk-timeline-stages-list">
                        @foreach (var phase in EffectiveContext.State.Phases)
                        {
                            var initialPhase = _initialSnapshot?.Phases?.FirstOrDefault(p => p.Id == phase.Id);
                            var isNewPhase = initialPhase == null;
                            var isModifiedPhase = !isNewPhase && (initialPhase!.Title != phase.Title || initialPhase.StartDate != phase.StartDate || initialPhase.EndDate != phase.EndDate || initialPhase.Status != phase.Status);

                            <div class="csk-stage-card">
                                <div class="csk-stage-header">
                                    <div class="csk-stage-title-group">
                                        <strong>@phase.Title</strong>
                                        @if (isNewPhase)
                                        {
                                            <CskBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" Size="BadgeSize.Small">Added</CskBadge>
                                        }
                                        else if (isModifiedPhase)
                                        {
                                            <CskBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Warning" Size="BadgeSize.Small">Modified</CskBadge>
                                        }
                                    </div>
                                    <div class="csk-stage-meta">
                                        <span>@TimeZoneService.FormatDate(phase.StartDate) ~ @TimeZoneService.FormatDate(phase.EndDate)</span>
                                        <CskBadge Appearance="BadgeAppearance.Filled" Color="@GetStatusBadgeColor(phase.Status)">@phase.Status</CskBadge>
                                    </div>
                                </div>

                                <!-- Nested Milestones -->
                                @if (phase.Milestones != null && phase.Milestones.Count > 0)
                                {
                                    <div class="csk-stage-milestones-box">
                                        <span class="csk-milestones-subheading">Milestones (@phase.Milestones.Count):</span>
                                        <div class="csk-milestone-sublist">
                                            @foreach (var m in phase.Milestones)
                                            {
                                                var initialM = initialPhase?.Milestones?.FirstOrDefault(im => im.Id == m.Id);
                                                var isNewM = initialM == null;
                                                var isModifiedM = !isNewM && (initialM!.Title != m.Title || initialM.StartDate != m.StartDate || initialM.EndDate != m.EndDate || initialM.OwnerEmails != m.OwnerEmails || initialM.Status != m.Status);

                                                <div class="csk-milestone-row">
                                                    <div class="csk-milestone-left">
                                                        <span>@m.Title</span>
                                                        @if (isNewM)
                                                        {
                                                            <CskBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Success" Size="BadgeSize.Small">New</CskBadge>
                                                        }
                                                        else if (isModifiedM)
                                                        {
                                                            <CskBadge Appearance="BadgeAppearance.Tint" Color="BadgeColor.Warning" Size="BadgeSize.Small">Edited</CskBadge>
                                                        }
                                                        @if (!string.IsNullOrWhiteSpace(m.OwnerEmails))
                                                        {
                                                            <span class="csk-milestone-email">(@m.OwnerEmails)</span>
                                                        }
                                                    </div>
                                                    <div class="csk-milestone-right">
                                                        <span>@TimeZoneService.FormatDate(m.StartDate) ~ @TimeZoneService.FormatDate(m.EndDate)</span>
                                                        <CskBadge Appearance="BadgeAppearance.Filled" Color="@GetStatusBadgeColor(m.Status)">@m.Status</CskBadge>
                                                    </div>
                                                </div>
                                            }
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="csk-empty-stages-text">
                                        No milestones in this phase.
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }
            </div>
        </CskCard>
    </CskStack>
</div>

@code {
    [CascadingParameter]
    public WizardContext<CreateProjectWizardState>? CascadedContext { get; set; }

    [Parameter]
    public WizardContext<CreateProjectWizardState>? Context { get; set; }

    private WizardContext<CreateProjectWizardState>? EffectiveContext => Context ?? CascadedContext;
    private CreateProjectWizardState? _initialSnapshot;

    protected override void OnParametersSet()
    {
        Context ??= CascadedContext;
        if (EffectiveContext != null && _initialSnapshot == null)
        {
            _initialSnapshot = EffectiveContext.GetInitialStateSnapshot();
        }
    }

    private static BadgeColor GetStatusBadgeColor(string? status) => status?.ToLowerInvariant() switch
    {
        "completed" => BadgeColor.Success,
        "inprogress" or "active" => BadgeColor.Warning,
        "new" => BadgeColor.Brand,
        _ => BadgeColor.Neutral
    };

    public Task<bool> ValidateStepAsync(WizardContext<CreateProjectWizardState> context)
    {
        return Task.FromResult(true);
    }
}
