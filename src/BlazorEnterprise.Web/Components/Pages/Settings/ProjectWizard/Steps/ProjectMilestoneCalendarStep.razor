@namespace BlazorEnterprise.Web.Components.Pages.Settings.ProjectWizard.Steps
@using BlazorEnterprise.Shared.UI.Wizards
@using BlazorEnterprise.Core.Dtos
@using BlazorEnterprise.Shared.UI.Components
@implements IWizardStepComponent<CreateProjectWizardState>

<CskStack Orientation="CskOrientation.Vertical" VerticalGap="14" Class="w-full">
    <div class="font-size-sm text-hint">
        Schedule stage gates and strategic milestone deliverable checkpoints.
    </div>

    @if (!_isReadOnly)
    {
        <CskCard Class="p-3 card-accent-border">
            <CskStack Orientation="CskOrientation.Vertical" VerticalGap="12">
                <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="12" VerticalAlignment="CskVerticalAlignment.End" Wrap="true">
                    <div class="flex-2 min-w-160">
                        <CskTextInput Label="Milestone Title" @bind-Value="_newTitle" Placeholder="e.g. Architecture Signoff" Class="full-width" />
                    </div>
                    <div class="flex-1 min-w-140">
                        <CskDatePicker Label="Due Date" @bind-Value="_newDueDate" Class="full-width" />
                    </div>
                    <div class="flex-2 min-w-160">
                        <CskTextInput Label="Deliverable Artifact" @bind-Value="_newDeliverable" Placeholder="e.g. HLD Document" Class="full-width" />
                    </div>
                    <div class="flex-1 min-w-140">
                        <CskSelect TOption="string"
                                   TValue="string"
                                   Label="Status"
                                   Items="@_statusOptions"
                                   OptionText="@(s => s)"
                                   OptionValue="@(s => s)"
                                   @bind-Value="_newStatus"
                                   Class="full-width" />
                    </div>
                </CskStack>

                <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="8">
                    <CskButton Variant="CskButtonVariant.Filled"
                               IconStart="@(_editingId.HasValue ? CskIcons.Checkmark : CskIcons.Add)"
                               Disabled="@(string.IsNullOrWhiteSpace(_newTitle))"
                               OnClick="@SaveMilestone">
                        @(_editingId.HasValue ? "Update Milestone" : "Add Milestone")
                    </CskButton>

                    @if (_editingId.HasValue)
                    {
                        <CskButton Variant="CskButtonVariant.Text" OnClick="@CancelEdit">
                            Cancel
                        </CskButton>
                    }
                </CskStack>
            </CskStack>
        </CskCard>
    }

    @if (Context?.State.Milestones.Count > 0)
    {
        <table class="csk-datagrid-table mt-2">
            <thead>
                <tr class="csk-datagrid-header-row">
                    <th class="csk-datagrid-th">Milestone</th>
                    <th class="csk-datagrid-th">Due Date</th>
                    <th class="csk-datagrid-th">Deliverable</th>
                    <th class="csk-datagrid-th">Status</th>
                    <th class="csk-datagrid-th">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var m in Context.State.Milestones)
                {
                    <tr class="csk-datagrid-row">
                        <td class="csk-datagrid-td">@m.Title</td>
                        <td class="csk-datagrid-td">@(m.DueDate?.ToString("yyyy-MM-dd") ?? "-")</td>
                        <td class="csk-datagrid-td">@m.Deliverable</td>
                        <td class="csk-datagrid-td">
                            <CskBadge Appearance="BadgeAppearance.Filled" Color="@GetStatusBadgeColor(m.Status)">
                                @m.Status
                            </CskBadge>
                        </td>
                        <td class="csk-datagrid-td">
                            @if (!_isReadOnly)
                            {
                                <CskStack Orientation="CskOrientation.Horizontal" HorizontalGap="6">
                                    <CskButton Variant="CskButtonVariant.Text" Size="CskButtonSize.Small" IconStart="@CskIcons.Edit" OnClick="@(() => StartEdit(m))">
                                        Edit
                                    </CskButton>
                                    <CskButton Variant="CskButtonVariant.Text" Size="CskButtonSize.Small" IconStart="@CskIcons.Delete" OnClick="@(() => RemoveMilestone(m))" />
                                </CskStack>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }
    else
    {
        <div class="text-hint font-size-sm p-4 text-center">
            No milestones added yet. Add a milestone above or skip this step.
        </div>
    }

    @if (Context != null && Context.HasError("Milestones"))
    {
        <span class="text-danger font-size-xs">@Context.StepErrors["Milestones"]</span>
    }
</CskStack>

@code {
    [CascadingParameter]
    public WizardContext<CreateProjectWizardState>? Context { get; set; }

    private readonly List<string> _statusOptions = new() { "Scheduled", "InProgress", "Completed", "AtRisk" };

    private Guid? _editingId;
    private string _newTitle = string.Empty;
    private DateTime? _newDueDate = DateTime.UtcNow.Date.AddMonths(1);
    private string _newDeliverable = string.Empty;
    private string _newStatus = "Scheduled";

    private bool _isReadOnly => Context?.IsReadOnly ?? false;

    private void StartEdit(ProjectMilestoneDto m)
    {
        _editingId = m.Id;
        _newTitle = m.Title;
        _newDueDate = m.DueDate;
        _newDeliverable = m.Deliverable;
        _newStatus = string.IsNullOrWhiteSpace(m.Status) ? "Scheduled" : m.Status;
    }

    private void CancelEdit()
    {
        _editingId = null;
        _newTitle = string.Empty;
        _newDueDate = DateTime.UtcNow.Date.AddMonths(1);
        _newDeliverable = string.Empty;
        _newStatus = "Scheduled";
    }

    private void SaveMilestone()
    {
        if (Context != null && !string.IsNullOrWhiteSpace(_newTitle))
        {
            if (_editingId.HasValue)
            {
                var existing = Context.State.Milestones.FirstOrDefault(m => m.Id == _editingId.Value);
                if (existing != null)
                {
                    existing.Title = _newTitle.Trim();
                    existing.DueDate = _newDueDate;
                    existing.Deliverable = _newDeliverable;
                    existing.Status = _newStatus;
                }
            }
            else
            {
                Context.State.Milestones.Add(new ProjectMilestoneDto
                {
                    Id = Guid.NewGuid(),
                    Title = _newTitle.Trim(),
                    DueDate = _newDueDate,
                    Deliverable = _newDeliverable,
                    Status = _newStatus
                });
            }

            CancelEdit();
            Context.ClearErrors("Milestones");
        }
    }

    private void RemoveMilestone(ProjectMilestoneDto m)
    {
        Context?.State.Milestones.Remove(m);
        if (_editingId == m.Id)
        {
            CancelEdit();
        }
    }

    private BadgeColor GetStatusBadgeColor(string status) => status switch
    {
        "Completed" => BadgeColor.Success,
        "InProgress" => BadgeColor.Informative,
        "AtRisk" => BadgeColor.Danger,
        "Scheduled" => BadgeColor.Informative,
        _ => BadgeColor.Informative
    };

    public Task<bool> ValidateStepAsync(WizardContext<CreateProjectWizardState> context)
    {
        context.ClearErrors("Milestones");
        return Task.FromResult(true);
    }
}
