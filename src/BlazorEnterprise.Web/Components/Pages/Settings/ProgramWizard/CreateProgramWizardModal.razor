@namespace BlazorEnterprise.Web.Components.Pages.Settings.ProgramWizard
@using BlazorEnterprise.Shared.UI.Wizards
@using BlazorEnterprise.Shared.UI.Components
@using BlazorEnterprise.Core.Dtos

<CskWizardModal TState="CreateProgramWizardState"
                IsOpen="@IsOpen"
                IsOpenChanged="@IsOpenChanged"
                IsReadOnly="@IsReadOnly"
                OnEditRequested="@OnEditRequested"
                Title="@(Title ?? (IsReadOnly ? "View Enterprise Program" : (IsEditMode ? "Edit Enterprise Program" : "Create Enterprise Program")))"
                Subtitle="@(IsReadOnly ? "View multi-year program scope, timeline, milestones, and governance" : "Step-by-step program initialization, governance, timeline & milestones")"
                InitialState="@_wizardState"
                FlowDefinition="@_flowDefinition"
                FinishButtonText="@(IsReadOnly ? "Close" : (IsEditMode ? "Save Changes" : "Create Program"))"
                OnSaveAsync="@HandleSaveAsync"
                OnFinish="@HandleFinishAsync"
                OnCancel="@HandleCancel">
</CskWizardModal>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<bool> IsOpenChanged { get; set; }
    [Parameter] public bool IsReadOnly { get; set; }
    [Parameter] public bool IsEditMode { get; set; }
    [Parameter] public string? Title { get; set; }
    [Parameter] public CreateProgramWizardState? InitialState { get; set; }
    [Parameter] public EventCallback<CreateProgramWizardState> OnProgramCreated { get; set; }
    [Parameter] public Func<CreateProgramWizardState, Task<string?>>? OnSaveAsync { get; set; }
    [Parameter] public EventCallback OnEditRequested { get; set; }

    private WizardFlowDefinition<CreateProgramWizardState> _flowDefinition = default!;
    private CreateProgramWizardState _wizardState = new();
    private bool _wasOpen;

    protected override void OnInitialized()
    {
        _flowDefinition = CreateProgramWizardFlow.CreateFlow();
        _wizardState = InitialState ?? new CreateProgramWizardState();
    }

    protected override void OnParametersSet()
    {
        if (IsOpen && (!_wasOpen || InitialState != null))
        {
            _wizardState = InitialState ?? new CreateProgramWizardState();
        }
        _wasOpen = IsOpen;
    }

    private async Task<string?> HandleSaveAsync(CreateProgramWizardState state)
    {
        if (IsReadOnly) return null;

        if (OnSaveAsync != null)
        {
            return await OnSaveAsync(state);
        }

        if (OnProgramCreated.HasDelegate)
        {
            await OnProgramCreated.InvokeAsync(state);
        }
        return null;
    }

    private async Task HandleFinishAsync(CreateProgramWizardState state)
    {
        await CloseAsync();
    }

    private async Task HandleCancel()
    {
        await CloseAsync();
    }

    private async Task CloseAsync()
    {
        IsOpen = false;
        if (IsOpenChanged.HasDelegate)
        {
            await IsOpenChanged.InvokeAsync(false);
        }
    }
}
