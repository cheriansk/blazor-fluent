@namespace BlazorEnterprise.Web.Components.Pages.Settings
@using BlazorEnterprise.Shared.DataListTypes
@using BlazorEnterprise.Shared.UI.Components

<div class="settings-rate-card-tab">
    <div class="tab-header">
        <div>
            <h3>Project Resource Rate Card</h3>
            <p class="tab-desc">Manage standard billing and costing hourly rates per project role and resource.</p>
        </div>

        <div class="plan-selector-box">
            <label>Plan Version:</label>
            <select class="csk-select" value="@_selectedRevisionId" @onchange="OnRevisionSelected">
                @foreach (var rev in _revisions)
                {
                    <option value="@rev.Id">v@rev.VerNum - @rev.Status (@rev.RevisionName)</option>
                }
            </select>
        </div>
    </div>

    @if (_isReadOnly)
    {
        <div class="csk-alert-info">
            <CskIcon Icon="@CskIcons.Info" />
            <span>The selected allocation plan version is read-only. Rate changes must be made against an open Draft plan.</span>
        </div>
    }
    else
    {
        <!-- Bulk Rate Assignment Box -->
        <div class="bulk-rate-card">
            <span class="bulk-title">Bulk Rate Assignment</span>
            <div class="bulk-form">
                <div class="form-group">
                    <label>Role:</label>
                    <select class="csk-select" @bind="_bulkRole">
                        @foreach (var role in Enum.GetValues<ProjectResourceRoleEnum>())
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label>Hourly Rate ($):</label>
                    <input type="number" step="0.50" min="0" class="csk-input" @bind="_bulkRate" />
                </div>
                <button type="button" class="csk-btn csk-btn-primary" @onclick="ApplyBulkRate">
                    Apply to All in Role
                </button>
            </div>
        </div>
    }

    <!-- Rates Table -->
    <div class="rate-card-table-wrapper">
        <div class="search-bar">
            <input type="text" class="csk-input" placeholder="Search resources..." @bind="_searchTerm" @bind:event="oninput" />
        </div>

        <table class="csk-table">
            <thead>
                <tr>
                    <th>Resource</th>
                    <th>Email</th>
                    <th>Project Role</th>
                    <th>Hourly Rate</th>
                    <th>Currency</th>
                </tr>
            </thead>
            <tbody>
                @if (!FilteredResources.Any())
                {
                    <tr>
                        <td colspan="5" class="empty-cell">No project resources found. Add resources from the Resource Management page.</td>
                    </tr>
                }
                else
                {
                    @foreach (var res in FilteredResources)
                    {
                        <tr>
                            <td><strong>@res.UserName</strong></td>
                            <td class="text-muted">@res.UserEmail</td>
                            <td><span class="role-badge">@res.Role</span></td>
                            <td>
                                @if (_isReadOnly)
                                {
                                    <span>@((res.HourlyRate ?? 0).ToString("C2"))</span>
                                }
                                else
                                {
                                    <div class="rate-input-wrap">
                                        <span>$</span>
                                        <input type="number" step="0.50" min="0" class="csk-input-sm"
                                               value="@(res.HourlyRate ?? 0)"
                                               @onchange="(e) => UpdateHourlyRate(res.Id, e.Value?.ToString())" />
                                    </div>
                                }
                            </td>
                            <td>@res.CurrencyCode</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
