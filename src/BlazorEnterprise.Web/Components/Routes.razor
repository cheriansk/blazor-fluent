@using System.Reflection
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Routing
@using BlazorEnterprise.Components.Common
@using BlazorEnterprise.Core.Contracts
@inject NavigationManager NavigationManager
@inject ILogger<Routes> Logger
@inject ICurrentUser CurrentUser
@inject ITenantContext TenantContext
@implements IDisposable

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFoundPage)">
    <Found Context="routeData">
        <ObservabilityErrorBoundaryComp PageName="@routeData.PageType.Name" PageType="@routeData.PageType">
            @if (!IsAnonymousAllowedPage(routeData.PageType) && !CurrentUser.IsAuthenticatedTenantUser)
            {
                <RedirectToLogin />
            }
            else
            {
                <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
                    <NotAuthorized Context="authContext">
                        @if (!CurrentUser.IsAuthenticatedTenantUser || authContext.User.Identity?.IsAuthenticated != true)
                        {
                            <RedirectToLogin />
                        }
                        else
                        {
                            <ProjectAccessDeniedCardComp RequiredRole="BlazorEnterprise.Shared.DataListTypes.ProjectRoleEnum.ReadOnly"
                                                         CustomMessage="You do not have permission to access this section." />
                        }
                    </NotAuthorized>
                </AuthorizeRouteView>
            }
        </ObservabilityErrorBoundaryComp>
    </Found>
</Router>

@code {
    private static bool IsAnonymousAllowedPage(Type pageType) =>
        Attribute.IsDefined(pageType, typeof(AllowAnonymousAttribute), inherit: true);

    protected override void OnInitialized()
    {
        NavigationManager.LocationChanged += HandleLocationChanged;
        Logger.LogDebug("Razor Navigation Router Initialized: CurrentUri='{Uri}', AuthenticatedTenantUser={IsAuthenticatedTenantUser}, Tenant='{TenantId}', User='{UserId}'",
            NavigationManager.Uri,
            CurrentUser.IsAuthenticatedTenantUser,
            TenantContext.HasActiveTenant ? TenantContext.TenantId.ToString() : "(no-active-tenant)",
            CurrentUser.IsAuthenticated ? CurrentUser.UserId : "(unauthenticated)");
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        Logger.LogDebug("Razor Navigation: Target='{TargetUri}', Intercepted={IsIntercepted}, AuthenticatedTenantUser={IsAuthenticatedTenantUser}, Tenant='{TenantId}', User='{UserId}'",
            e.Location,
            e.IsNavigationIntercepted,
            CurrentUser.IsAuthenticatedTenantUser,
            TenantContext.HasActiveTenant ? TenantContext.TenantId.ToString() : "(no-active-tenant)",
            CurrentUser.IsAuthenticated ? CurrentUser.UserId : "(unauthenticated)");
    }

    public void Dispose()
    {
        NavigationManager.LocationChanged -= HandleLocationChanged;
    }
}
