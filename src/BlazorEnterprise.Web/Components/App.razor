@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor

@{
    var nonce = HttpContextAccessor.HttpContext?.Items["CspNonce"]?.ToString() ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />
    <ResourcePreloader />
    <link rel="stylesheet" href="@Assets["app.css"]" nonce="@nonce" />
    <link rel="stylesheet" href="@Assets["_content/BlazorEnterprise.Shared.UI/css/material-theme.css"]" nonce="@nonce" />
    <link rel="stylesheet" href="@Assets["BlazorEnterprise.styles.css"]" nonce="@nonce" />
    <ImportMap nonce="@nonce" />
    <link rel="icon" type="image/x-icon" href="favicon.ico" />
    <HeadOutlet @rendermode="InteractiveServer" />
</head>

<body>
    <Routes @rendermode="InteractiveServer" />
    <ReconnectModal />
    <script src="@Assets["_framework/blazor.web.js"]" nonce="@nonce"></script>
    <script src="js/responsive-interop.js" nonce="@nonce"></script>
    <script src="js/session-tracker.js" nonce="@nonce"></script>
</body>

</html>

