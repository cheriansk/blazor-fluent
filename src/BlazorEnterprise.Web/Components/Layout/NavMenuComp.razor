@rendermode InteractiveServer
@namespace BlazorEnterprise.Web.Components.Layout
@using BlazorEnterprise.Core.Contracts
@using BlazorEnterprise.Shared.UI.Components
@inject ITenantContext TenantContext
@inject ICurrentUser CurrentUser
@inject INavigationStateService NavState
@inject IProjectContext ProjectContext
@implements IDisposable

<div class="navmenu-container @(NavState.IsCollapsed ? "nav-collapsed" : "nav-expanded")" aria-label="Main Navigation">
    <nav class="csk-nav-menu" id="main-menu">
        @if (CurrentUser.IsAuthenticated && TenantContext.HasActiveTenant)
        {
            <div class="nav-section">
                <span class="nav-section-title" aria-hidden="@(NavState.IsCollapsed ? "true" : "false")">Workspace</span>

                <NavLink class="csk-nav-item" href="" Match="NavLinkMatch.All" title="Home">
                    <span class="csk-nav-indicator">
                        <CskIcon Icon="@CskIcons.Home" Class="csk-nav-icon" />
                    </span>
                    @if (!NavState.IsCollapsed)
                    {
                        <span class="csk-nav-text">Home</span>
                    }
                </NavLink>

                <NavLink class="csk-nav-item" href="programs/holistic" title="Program Holistic View">
                    <span class="csk-nav-indicator">
                        <CskIcon Icon="@CskIcons.FolderDocument" Class="csk-nav-icon" />
                    </span>
                    @if (!NavState.IsCollapsed)
                    {
                        <span class="csk-nav-text">Program Holistic View</span>
                    }
                </NavLink>

                <NavLink class="csk-nav-item" href="projects/holistic" title="Project Holistic View">
                    <span class="csk-nav-indicator">
                        <CskIcon Icon="@CskIcons.TaskListSquare" Class="csk-nav-icon" />
                    </span>
                    @if (!NavState.IsCollapsed)
                    {
                        <span class="csk-nav-text">Project Holistic View</span>
                    }
                </NavLink>

                @if (!TenantContext.IsRootTenant)
                {
                    <NavLink class="csk-nav-item" href="knowledge" title="Knowledge Base">
                        <span class="csk-nav-indicator">
                            <CskIcon Icon="@CskIcons.BookOpen" Class="csk-nav-icon" />
                        </span>
                        @if (!NavState.IsCollapsed)
                        {
                            <span class="csk-nav-text">Knowledge Base</span>
                        }
                    </NavLink>

                    <NavLink class="csk-nav-item" href="tasks" title="Tasks">
                        <span class="csk-nav-indicator">
                            <CskIcon Icon="@CskIcons.TaskList" Class="csk-nav-icon" />
                        </span>
                        @if (!NavState.IsCollapsed)
                        {
                            <span class="csk-nav-text">Tasks</span>
                        }
                    </NavLink>

                    <NavLink class="csk-nav-item" href="workflows" title="Workflows">
                        <span class="csk-nav-indicator">
                            <CskIcon Icon="@CskIcons.Flowchart" Class="csk-nav-icon" />
                        </span>
                        @if (!NavState.IsCollapsed)
                        {
                            <span class="csk-nav-text">Workflows</span>
                        }
                    </NavLink>

                    <NavLink class="csk-nav-item" href="imports" title="File Imports">
                        <span class="csk-nav-indicator">
                            <CskIcon Icon="@CskIcons.ArrowSync" Class="csk-nav-icon" />
                        </span>
                        @if (!NavState.IsCollapsed)
                        {
                            <span class="csk-nav-text">File Imports</span>
                        }
                    </NavLink>
                }
            </div>

            <div class="nav-section-spacer"></div>

            <div class="nav-section nav-section-bottom">
                <span class="nav-section-title" aria-hidden="@(NavState.IsCollapsed ? "true" : "false")">Configuration</span>

                <NavLink class="csk-nav-item" href="settings" title="Settings">
                    <span class="csk-nav-indicator">
                        <CskIcon Icon="@CskIcons.Settings" Class="csk-nav-icon" />
                    </span>
                    @if (!NavState.IsCollapsed)
                    {
                        <span class="csk-nav-text">Settings</span>
                    }
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        NavState.OnChange += HandleStateChanged;
        ProjectContext.OnChange += HandleStateChanged;
    }

    private void HandleStateChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        NavState.OnChange -= HandleStateChanged;
        ProjectContext.OnChange -= HandleStateChanged;
    }
}
