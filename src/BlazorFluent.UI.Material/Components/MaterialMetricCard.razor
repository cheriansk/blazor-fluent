@namespace BlazorFluent.UI.Material.Components
@using Microsoft.FluentUI.AspNetCore.Components
@using Icons = Microsoft.FluentUI.AspNetCore.Components.Icons

<div class="mat-metric-card @Class" style="@Style">
    <div class="mat-metric-top">
        <div class="mat-metric-info">
            <span class="mat-metric-title">@Title</span>
            <div class="mat-metric-value">@Value</div>
        </div>
        <div class="mat-avatar-badge @AvatarColorClass">
            <FluentIcon Value="@Icon" Color="@IconColor" Width="22px" />
        </div>
    </div>
    
    <div class="mat-metric-bottom">
        @if (!string.IsNullOrWhiteSpace(TrendText))
        {
            <span class="mat-chip @(TrendPositive ? "mat-chip-success" : "mat-chip-error")">
                @if (TrendPositive)
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowTrending())" Width="14px" />
                }
                else
                {
                    <FluentIcon Value="@(new Icons.Regular.Size16.ArrowTrendingDown())" Width="14px" />
                }
                @TrendText
            </span>
        }
        @if (!string.IsNullOrWhiteSpace(Subtext))
        {
            <span class="mat-subtext">@Subtext</span>
        }
    </div>
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter, EditorRequired] public string Value { get; set; } = string.Empty;
    [Parameter] public Icon Icon { get; set; } = new Icons.Regular.Size24.DataTrending();
    [Parameter] public Color IconColor { get; set; } = Color.Primary;
    [Parameter] public string AvatarColorClass { get; set; } = "mat-avatar-primary";
    [Parameter] public string TrendText { get; set; } = string.Empty;
    [Parameter] public bool TrendPositive { get; set; } = true;
    [Parameter] public string Subtext { get; set; } = string.Empty;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string Style { get; set; } = string.Empty;
}
