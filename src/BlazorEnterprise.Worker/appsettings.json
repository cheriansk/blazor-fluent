{
  "ConnectionStrings": {
    "DefaultConnection": "",
    "Redis": ""
  },
  "Admin": {
    "RootTenantId": "",
    "RootTenantSlug": "",
    "RootTenantName": "",
    "RootAdmins": ""
  },
  "Identity": {
    "SystemDaemonLocalPart": "",
    "SystemDaemonEmailDomain": "",
    "SystemActorName": ""
  },
  "Caching": {
    "DefaultExpirationMinutes": 60,
    "LocalCacheExpirationMinutes": 15
  },
  "Jobs": {
    "EnableHostedListener": true,
    "EnableScheduler": true,
    "CronServiceAccountEmail": "",
    "Schedules": {
      "AuditPurgeJob": "0 2 * * *",
      "DailyTaskSummaryJob": "0 18 * * *",
      "TaskCadenceAlertJob": "0 8 * * *"
    }
  },
  "Audit": {
    "RetentionDays": 365
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "BlazorEnterprise": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "Security": {
    "IntegritySecret": "",
    "MasterEncryptionKey": "",
    "SystemBootstrapEmail": ""
  },
  "Engine": {
    "Mode": "Remote",
    "ApiBaseUrl": "",
    "LicenseKey": ""
  }
}
