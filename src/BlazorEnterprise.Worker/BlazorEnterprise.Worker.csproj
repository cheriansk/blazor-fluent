<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>BlazorEnterprise.Worker</RootNamespace>
    <AssemblyName>BlazorEnterprise.Worker</AssemblyName>
    <WarningsAsErrors>CS0108</WarningsAsErrors>
    <UserSecretsId>dotnet-BlazorEnterprise.Worker-88339281-2291-419b-bc39-8ddd2ea18833</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Serilog.AspNetCore" />
    <PackageReference Include="Serilog.Enrichers.Span" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BlazorEnterprise.Core\BlazorEnterprise.Core.csproj" />
    <ProjectReference Include="..\BlazorEnterprise.Shared\BlazorEnterprise.Shared.csproj" />
    <ProjectReference Include="..\BlazorEnterprise.Persistence\BlazorEnterprise.Persistence.csproj" />
    <ProjectReference Include="..\BlazorEnterprise.Infrastructure\BlazorEnterprise.Infrastructure.csproj" />
    <ProjectReference Include="..\BlazorEnterprise.Jobs\BlazorEnterprise.Jobs.csproj" />
    <ProjectReference Include="..\BlazorEnterprise.ServiceDefaults\BlazorEnterprise.ServiceDefaults.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Using Remove="BlazorEnterprise.Shared.DataListTypes.TaskStatus" />
  </ItemGroup>

</Project>
