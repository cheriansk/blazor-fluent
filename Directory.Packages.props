<Project>  <PropertyGroup>    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>  </PropertyGroup>  <ItemGroup>    <!-- Azure & Cloud Configuration -->    <PackageVersion Include="Azure.Extensions.AspNetCore.Configuration.Secrets" Version="1.5.2" />    <PackageVersion Include="Azure.Identity" Version="1.21.0" />    <PackageVersion Include="Azure.Monitor.OpenTelemetry.AspNetCore" Version="1.6.0" />    <!-- Aspire Hosting -->    <PackageVersion Include="Aspire.Hosting.PostgreSQL" Version="13.6.1" />    <!-- OpenTelemetry Core & Instrumentation -->    <PackageVersion Include="OpenTelemetry.Api" Version="1.11.2" />    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.20.0" />    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.20.0" />    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.20.0" />    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.20.0" />    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.20.0" />    <!-- Microsoft.AspNetCore & Identity -->    <PackageVersion Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.13" />    <PackageVersion Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.13" />    <PackageVersion Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.13" />    <PackageVersion Include="Microsoft.AspNetCore.Components.Web" Version="10.0.13" />    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.EntityFrameworkCore" Version="10.0.13" />    <PackageVersion Include="Microsoft.Identity.Web" Version="4.16.1" />    <!-- Entity Framework Core & PostgreSQL -->    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.13" />    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />    <PackageVersion Include="Microsoft.EntityFrameworkCore.Relational" Version="10.0.13" />    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.13" />    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />    <PackageVersion Include="EntityFrameworkCore.Exceptions.PostgreSQL" Version="10.0.1" />    <!-- Microsoft.Extensions Core Libraries -->    <PackageVersion Include="Microsoft.Extensions.Caching.Hybrid" Version="10.11.0" />    <PackageVersion Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.Configuration" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.Configuration.Json" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.Configuration.UserSecrets" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.Abstractions" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.13" />    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />    <!-- Fluent UI Blazor V5 -->    <!-- Validation & Sanitization -->    <PackageVersion Include="FluentValidation" Version="12.2.0" />    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />    <PackageVersion Include="Blazored.FluentValidation" Version="2.2.0" />    <PackageVersion Include="HtmlSanitizer" Version="9.2.1039" />    <!-- Logging & Serilog -->    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />    <PackageVersion Include="Serilog.Enrichers.Environment" Version="3.0.1" />    <PackageVersion Include="Serilog.Enrichers.Process" Version="3.0.0" />    <PackageVersion Include="Serilog.Enrichers.Span" Version="3.1.0" />    <PackageVersion Include="Serilog.Enrichers.Thread" Version="4.0.0" />    <PackageVersion Include="Serilog.Settings.Configuration" Version="10.0.1" />    <PackageVersion Include="Serilog.Sinks.Console" Version="6.1.1" />    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />    <!-- Scheduling & Document Formats -->    <PackageVersion Include="Cronos" Version="0.13.0" />    <PackageVersion Include="DocumentFormat.OpenXml" Version="3.5.1" />    <!-- Cryptography & Patched Security Packages -->    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.13" />    <!-- Roslyn Compiler & Analyzer Tooling -->    <PackageVersion Include="Microsoft.CodeAnalysis.Analyzers" Version="5.9.0" />    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />    <PackageVersion Include="System.Text.Json" Version="10.0.13" />    <!-- Unit Testing & Benchmarking -->    <PackageVersion Include="BenchmarkDotNet" Version="0.15.8" />    <PackageVersion Include="FluentAssertions" Version="8.11.0" />    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />    <PackageVersion Include="Moq" Version="4.21.0" />    <PackageVersion Include="xunit" Version="2.9.3" />    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />  </ItemGroup></Project>