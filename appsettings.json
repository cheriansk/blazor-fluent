{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=blazorfluent_db;Username=postgres;Password=__SET_VIA_ENV_OR_KEYVAULT__",
    "Redis": ""
  },
  "Caching": {
    "DefaultExpirationMinutes": 60,
    "LocalCacheExpirationMinutes": 15
  },
  "Jobs": {
    "EnableScheduler": true,
    "CronServiceAccountEmail": "cron-daemon@blazorfluent.local",
    "Schedules": {
      "CatalogSyncJob": "*/15 * * * *",
      "AuditPurgeJob": "0 2 * * *",
      "DailyTaskSummaryJob": "0 18 * * *",
      "TaskCadenceAlertJob": "0 8 * * *"
    }
  },
  "Audit": {
    "RetentionDays": 365
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "BlazorFluent": "Information",
        "BlazorFluent.Components": "Debug"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "Notifications": {
    "Teams": {
      "Enabled": false,
      "DefaultWebhookUrl": "",
      "ProjectWebhooks": {}
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "localhost",
      "SmtpPort": 587,
      "UseSsl": false,
      "SenderEmail": "notifications@blazorfluent.local",
      "SenderName": "BlazorFluent Notifications",
      "DefaultMailbox": "admin@blazorfluent.local",
      "ProjectMailboxes": {}
    }
  },
  "ApplicationInsights": {
    "ConnectionString": ""
  },
  "KeyVault": {
    "Uri": ""
  },
  "Security": {
    "IntegritySecret": "__SET_VIA_KEYVAULT_OR_USER_SECRETS__",
    "MasterEncryptionKey": "__SET_VIA_KEYVAULT_OR_USER_SECRETS__",
    "RootAdmins": "admin@blazorfluent.local;admin2@blazorfluent.local;admin3@blazorfluent.local",
    "SystemBootstrapEmail": "provisioner@blazorfluent.local"
  },
  "AllowedHosts": "*"
}
