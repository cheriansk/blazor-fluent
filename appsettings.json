{
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=blazorfluent_db;Username=postgres;Password=postgres",
    "Redis": ""
  },
  "Caching": {
    "DefaultExpirationMinutes": 60,
    "LocalCacheExpirationMinutes": 15
  },
  "Jobs": {
    "EnableScheduler": true,
    "Schedules": {
      "CatalogSyncJob": "*/15 * * * *"
    }
  },
  "DateTimeSettings": {
    "UseUtc": true
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.File"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning",
        "BlazorFluent": "Information"
      }
    },
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithProcessId",
      "WithThreadId"
    ]
  },
  "Notifications": {
    "Teams": {
      "Enabled": false,
      "DefaultWebhookUrl": "",
      "ProjectWebhooks": {}
    },
    "Email": {
      "Enabled": false,
      "SmtpHost": "localhost",
      "SmtpPort": 587,
      "UseSsl": false,
      "SenderEmail": "notifications@blazorfluent.local",
      "SenderName": "BlazorFluent Notifications",
      "DefaultMailbox": "admin@blazorfluent.local",
      "ProjectMailboxes": {}
    }
  },
  "Security": {
    "IntegritySecret": "BlazorFluent-Secret-Key-Change-In-Production-2026"
  },
  "AllowedHosts": "*"
}
